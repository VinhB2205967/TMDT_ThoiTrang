.sider
    .sider-header
        a.sider-brand(href=`${admin}/dashboard`)
            i.bi.bi-shop-window
            span Fashion Admin
    .inner-menu
        ul
            li
                a(href=`${admin}/dashboard`)
                    i.bi.bi-speedometer2
                    span Tổng quan
            li
                a(href=`${admin}/users`)
                    i.bi.bi-people
                    span Người dùng
            li
                a(href=`${admin}/products`)
                    i.bi.bi-box-seam
                    span Sản phẩm
            li
                a(href=`${admin}/ordersettings`)
                    i.bi.bi-gear
                    span Cài đặt đơn hàng
            li
                a(href=`${admin}/reports`)
                    i.bi.bi-bar-chart-line
                    span Báo cáo

    .sider-footer
        - const au = typeof adminUser !== 'undefined' ? adminUser : null
        - const adminName = (au && au.hoten) ? au.hoten : 'Admin'
        - const adminEmail = (au && au.email) ? au.email : ''
        - const adminAvatar = (au && au.avatar) ? au.avatar : '/images/download.jpg'

        .sider-profile
            img.sider-profile__avatar(src=adminAvatar alt="avatar")
            .sider-profile__meta
                .sider-profile__name #{adminName}
                if adminEmail
                    .sider-profile__email #{adminEmail}
            span.sider-profile__badge ADMIN

        form(method="POST" action=`${admin}/logout`)
            button.sider-logout-btn(type="submit")
                i.bi.bi-box-arrow-right
                span Đăng xuất