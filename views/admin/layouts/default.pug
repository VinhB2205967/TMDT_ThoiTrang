doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{titlePage}
    link(href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet")
    link(href="/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet")
    link(rel="stylesheet", href="/admin/css/admin.css")
    meta(name="csrf-token" content=csrfToken)
    block styles
  body
    .body
        include ../partials/sider.pug 
        .main
            include ../../partials/flash.pug
            block main
    
  
    script(src="/vendor/bootstrap/js/bootstrap.bundle.min.js")
    script(src="/js/shared/csrf.js")
    script(src="/js/shared/utils.js")
    script(src="/js/shared/flash.js")
    script(src="/admin/js/admin.js")
    script(src="/admin/js/filterAutoSubmit.js")
    script(src="/js/script.js")
    if adminUser && adminUser._id
      script.
        window.AdminChatNotifyRuntime = {
          userId: !{JSON.stringify(String(adminUser._id || ''))},
          adminPath: !{JSON.stringify(admin || '/admin')}
        };
      script.
        window.AdminOrderNotifyRuntime = {
          adminPath: !{JSON.stringify(admin || '/admin')}
        };
      script(src="/socket.io/socket.io.js")
      script(src="/admin/js/chat-notify.js")
      script(src="/admin/js/order-notify.js")
    
    //- Block cho scripts bổ sung từ các trang con
    block scripts
    
    
