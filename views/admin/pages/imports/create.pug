extends ../../layouts/default.pug

block main
  .container-fluid.p-3
    .d-flex.justify-content-between.align-items-center.mb-3
      h3.mb-0 Tạo phiếu nhập kho
      a.btn.btn-outline-secondary(href=`${admin}/imports`)
        i.bi.bi-arrow-left
        |  Danh sách

    - const createAction = `${admin}/imports/create?_csrf=${encodeURIComponent(csrfToken || '')}`
    form#import-create-form(method='POST', action=createAction enctype='multipart/form-data')
      input(type='hidden' name='_csrf' value=csrfToken)
      .card.mb-3
        .card-header Thông tin chung phiếu nhập
        .card-body
          .row.g-3
            .col-md-4
              label.form-label Mã phiếu nhập
              input.form-control(name='maphieu', value=maPhieu, readonly)
            .col-md-4
              label.form-label Ngày nhập kho
              input.form-control(type='datetime-local', name='ngaynhap', required)
            .col-md-4
              label.form-label Nhà cung cấp
              input.form-control(name='nhacungcap', placeholder='Tên nhà cung cấp')
            .col-12
              label.form-label Ghi chú nhập kho
              textarea.form-control(name='ghichu', rows='2', placeholder='Ghi chú...')

      .card
        .card-header
          ul.nav.nav-tabs.card-header-tabs(role='tablist')
            li.nav-item(role='presentation')
              button.nav-link.active(type='button' data-bs-toggle='tab' data-bs-target='#tab-fashion' role='tab') Thời trang (Quần áo)
            li.nav-item(role='presentation')
              button.nav-link(type='button' data-bs-toggle='tab' data-bs-target='#tab-accessory' role='tab') Phụ kiện
        .card-body
          .tab-content
            .tab-pane.fade.show.active#tab-fashion(role='tabpanel')
              .d-flex.justify-content-end.mb-2
                button#btn-add-fashion-block.btn.btn-sm.btn-primary(type='button')
                  i.bi.bi-plus-lg
                  |  Thêm sản phẩm (ma trận size/màu)

              //- Blocks rendered by JS
              #fashion-blocks

              .alert.alert-secondary.mt-2.mb-0
                | Chọn sản phẩm → nhập số lượng theo size/màu → bấm Lưu.

            .tab-pane.fade#tab-accessory(role='tabpanel')
              .d-flex.justify-content-end.mb-2
                button#btn-add-accessory-block.btn.btn-sm.btn-primary(type='button')
                  i.bi.bi-plus-lg
                  |  Thêm phụ kiện (theo biến thể)

              //- Blocks rendered by JS
              #accessory-blocks

              .alert.alert-secondary.mt-2.mb-0
                | Chọn phụ kiện → nhập số lượng theo biến thể → bấm Lưu.

          .d-flex.justify-content-between.align-items-center.mt-3
            .fw-semibold
              | Tổng tiền nhập: 
              span#import-total-money 0
              |  đ
            button.btn.btn-success(type='submit')
              i.bi.bi-check2-circle
              |  Lưu phiếu nhập & cộng tồn kho

      //- JS will generate items[] here before submit
      #generated-items

      //- Templates for client-side cloning (avoid HTML in JS)
      - const __NO_SIZE = ['tui', 'phukien']
      template#tpl-fashion-matrix
        .table-responsive
          table.table.table-bordered.table-sm.align-middle.mb-0
            thead.table-light
              tr
                th(style='min-width:220px') Màu / biến thể
                each s in (sizeList || [])
                  th.text-center(style='min-width:60px') #{s}
                th(style='min-width:140px') Giá nhập
                th(style='min-width:160px') Giá bán đề xuất
            tbody
        .form-text Nhập số lượng theo size. Ô = 0 sẽ bỏ qua.

      template#tpl-fashion-variant-row
        tr.js-variant-row(data-variant='')
          td
            .d-flex.align-items-center.gap-2
              img.js-variant-image(src='' alt='' style='width:44px;height:44px;object-fit:cover;border-radius:6px;display:none')
              .flex-grow-1
                .fw-semibold.js-variant-label --
                .small.text-muted.js-variant-price
                input.form-control.form-control-sm.mt-1.js-variant-color(placeholder='Màu')
          each s in (sizeList || [])
            td.text-center
              input.form-control.form-control-sm.text-center.js-qty(type='number' min='0' step='1' value='0' data-size=s)
              small.text-muted.d-block.js-stock(data-size=s) Tồn: 0
          td
            input.form-control.form-control-sm.js-import(type='number' min='0' step='1000' placeholder='Giá nhập')
          td
            input.form-control.form-control-sm.js-suggested(type='number' min='0' step='1000' placeholder='Giá bán')

      template#tpl-fashion-block
        .card.mb-2(data-block-index='')
          .card-body
            .d-flex.justify-content-between.align-items-start.gap-2.flex-wrap
              .flex-grow-1(style='min-width:260px')
                label.form-label.mb-1 Sản phẩm
                input.form-control.form-control-sm.mb-1.js-fashion-product-search(type='search' placeholder='Tìm sản phẩm...')
                select.form-select.js-fashion-product
                  option(value='') -- Chọn sản phẩm --
                  each p in (products || [])
                    - const __t = String(p.loaisanpham || '').toLowerCase()
                    if __NO_SIZE.indexOf(__t) === -1
                      option(value=p._id) #{p.tensanpham}
              div(style='min-width:160px')
                label.form-label.mb-1 Danh mục
                select.form-select.js-fashion-category
                  option(value='ao') Áo
                  option(value='quan') Quần
                  option(value='vay') Váy
                  option(value='phukien') Phụ kiện
                  option(value='giay') Giày
                  option(value='tui') Túi
                  option(value='aokhoac') Áo khoác
              div(style='min-width:160px')
                label.form-label.mb-1 Chất liệu
                input.form-control.js-fashion-material(placeholder='Cotton/Jean...')
              div(style='min-width:220px')
                label.form-label.mb-1 Ảnh
                .d-flex.align-items-center.gap-2
                  img.js-block-image-preview(src='' alt='' style='width:44px;height:44px;object-fit:cover;border-radius:6px;display:none')
                  .form-text.mb-0 Tự lấy từ sản phẩm/biến thể.
              div
                button.btn.btn-outline-danger.btn-sm.js-remove-block(type='button')
                  i.bi.bi-trash
                  |  Xóa block
            .mt-2.js-matrix
            .d-flex.justify-content-end.mt-2
              .fw-semibold
                | Tổng block: 
                span.js-block-total 0
                | đ

      template#tpl-accessory-row
        tr
          td(style='min-width:240px')
            input.form-control.form-control-sm.mb-1.js-product-search(type='search' placeholder='Tìm phụ kiện...')
            select.form-select.form-select-sm.js-product(data-field='sanphamid')
              option(value='') -- Chọn sản phẩm --
              each p in (products || [])
                - const __t = String(p.loaisanpham || '').toLowerCase()
                if __NO_SIZE.indexOf(__t) !== -1
                  option(value=p._id) #{p.tensanpham}
            input(type='hidden' class='js-product-name' data-field='tensanpham')
          td(style='min-width:180px')
            select.form-select.form-select-sm.js-variant(data-field='bientheid')
              option(value='main') Mặc định
          td(style='min-width:110px')
            input.form-control.form-control-sm(type='number' min='1' step='1' value='1' required data-field='soluong')
          td(style='min-width:140px')
            input.form-control.form-control-sm(type='number' min='0' step='1000' placeholder='Giá nhập' data-field='gianhap')
          td(style='min-width:140px')
            input.form-control.form-control-sm(type='number' min='0' step='1000' placeholder='Giá bán' data-field='giabandexuat')
          td(style='min-width:260px')
            details.js-details
              summary Chi tiết (mở để nhập thêm)
              .mt-2
                .mb-2
                  label.form-label.small.mb-1 Màu sắc
                  input.form-control.form-control-sm.js-color(placeholder='Màu sắc' data-field='mausac')
                .mb-2
                  label.form-label.small.mb-1 Chất liệu
                  input.form-control.form-control-sm.js-material(placeholder='Chất liệu' data-field='chatlieu')
                .mb-2
                  label.form-label.small.mb-1 Loại phụ kiện
                  input.form-control.form-control-sm.js-category(placeholder='Túi/Ví/Mũ/Đồng hồ/Trang sức...' data-field='danhmuc')
                .d-flex.align-items-center.gap-2
                  img.js-image-preview(src='' alt='' style='width:44px;height:44px;object-fit:cover;border-radius:6px;display:none')
                  .form-text.mb-0 Ảnh tự lấy từ sản phẩm/biến thể.
                input(type='hidden' class='js-image' data-field='hinhanh')
                input(type='hidden' class='js-size' data-field='kichco' value='')
          td(style='min-width:60px' class='text-center')
            button.btn.btn-sm.btn-outline-danger.js-remove(type='button' title='Xóa')
              i.bi.bi-x

      //- Accessory matrix templates (new)
      template#tpl-accessory-matrix
        .table-responsive
          table.table.table-bordered.table-sm.align-middle.mb-0
            thead.table-light
              tr
                th(style='min-width:260px') Biến thể
                th.text-center(style='min-width:110px') Số lượng
                th(style='min-width:140px') Giá nhập
                th(style='min-width:160px') Giá bán đề xuất
            tbody
        .form-text Nhập số lượng. Ô = 0 sẽ bỏ qua.

      template#tpl-accessory-variant-row
        tr.js-accessory-variant-row(data-variant='')
          td
            .d-flex.align-items-center.gap-2
              img.js-variant-image(src='' alt='' style='width:44px;height:44px;object-fit:cover;border-radius:6px;display:none')
              .flex-grow-1
                .fw-semibold.js-variant-label --
                .small.text-muted.js-variant-price
                input.form-control.form-control-sm.mt-1.js-variant-color(placeholder='Màu')
          td.text-center
            input.form-control.form-control-sm.text-center.js-qty-one(type='number' min='0' step='1' value='0')
            small.text-muted.d-block.js-stock-one Tồn: 0
          td
            input.form-control.form-control-sm.js-import(type='number' min='0' step='1000' placeholder='Giá nhập')
          td
            input.form-control.form-control-sm.js-suggested(type='number' min='0' step='1000' placeholder='Giá bán')

      template#tpl-accessory-block
        .card.mb-2(data-accessory-block-index='')
          .card-body
            .d-flex.justify-content-between.align-items-start.gap-2.flex-wrap
              .flex-grow-1(style='min-width:260px')
                label.form-label.mb-1 Phụ kiện
                input.form-control.form-control-sm.mb-1.js-accessory-product-search(type='search' placeholder='Tìm phụ kiện...')
                select.form-select.js-accessory-product
                  option(value='') -- Chọn phụ kiện --
                  each p in (products || [])
                    - const __t = String(p.loaisanpham || '').toLowerCase()
                    if __NO_SIZE.indexOf(__t) !== -1
                      option(value=p._id) #{p.tensanpham}
              div(style='min-width:160px')
                label.form-label.mb-1 Loại
                select.form-select.js-accessory-category
                  option(value='tui') Túi
                  option(value='phukien') Phụ kiện
              div(style='min-width:160px')
                label.form-label.mb-1 Chất liệu
                input.form-control.js-accessory-material(placeholder='Cotton/Da/Vải...')
              div(style='min-width:220px')
                label.form-label.mb-1 Ảnh
                .d-flex.align-items-center.gap-2
                  img.js-block-image-preview(src='' alt='' style='width:44px;height:44px;object-fit:cover;border-radius:6px;display:none')
                  .form-text.mb-0 Tự lấy từ sản phẩm/biến thể.
              div
                button.btn.btn-outline-danger.btn-sm.js-remove-accessory-block(type='button')
                  i.bi.bi-trash
                  |  Xóa block
            .mt-2.js-accessory-matrix
            .d-flex.justify-content-end.mt-2
              .fw-semibold
                | Tổng block: 
                span.js-block-total 0
                | đ

block scripts
  //- Provide products JSON for client script
  script(type='application/json' id='products-json')
    != JSON.stringify(products || [])
  script(type='application/json' id='sizes-json')
    != JSON.stringify(sizeList || [])
  script(src='/admin/js/shared/imports-shared.js')
  script(src='/admin/js/imports.js')
