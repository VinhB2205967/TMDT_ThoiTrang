extends ../../layouts/default.pug

block main
  .container-fluid.p-3
    .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-3.page-header-section.orders-header.admin-page-header
      h3.mb-0 Phiếu nhập kho
      .d-flex.align-items-center.gap-2.orders-actions.ms-auto
        a.btn.btn-header.btn-admin-accent(href=`${admin}/imports/create`)
          i.bi.bi-plus-lg
          span Tạo phiếu nhập

    form.card.mb-3(method='GET' action=`${admin}/imports`)
      .card-body
        .row.g-2.align-items-end
          .col-md-6
            label.form-label Nhà cung cấp
            input.form-control(type='text' name='supplier' value=(filters && filters.supplier) || '' placeholder='Lọc theo tên nhà cung cấp...')
          .col-md-2
            label.form-label Hiển thị
            select.form-select(name='limit')
              - const __limit = Number((filters && filters.limit) || 10)
              option(value='10' selected=(__limit === 10)) 10 / trang
              option(value='20' selected=(__limit === 20)) 20 / trang
              option(value='50' selected=(__limit === 50)) 50 / trang
          .col-md-4.d-flex.gap-2
            button.btn.btn-primary(type='submit') Lọc
            a.btn.btn-outline-secondary(href=`${admin}/imports`) Reset

    if !receipts || receipts.length === 0
      .alert.alert-info.mb-0 Chưa có phiếu nhập nào.
    else
      .table-responsive
        table.table.table-hover.table-bordered.align-middle
          thead.table-light
            tr
              th Mã phiếu
              th Ngày nhập
              th Nhà cung cấp
              th Số dòng
              th Tổng tiền
              th Tạo lúc
              th
            tbody
              - function __toNum(v) { const n = Number(v); return Number.isFinite(n) ? n : 0; }
              - function __calcTong(items) { return (items || []).reduce(function (sum, it) { const qty = __toNum(it && (it.soluong || it.so_luong || it.quantity || 0)); const price = __toNum(it && (it.gianhap != null ? it.gianhap : (it.gia_nhap != null ? it.gia_nhap : (it.import_price || 0)))); return sum + (qty * price); }, 0); }
              each r in receipts
                tr
                  td
                    a(href=`${admin}/imports/${r._id}`) #{r.maphieu || r.ma_phieu || r.code}
                  td #{((r.ngaynhap || r.ngay_nhap || r.import_date) ? new Date(r.ngaynhap || r.ngay_nhap || r.import_date).toLocaleString('vi-VN') : '')}
                  td #{r.nhacungcap || r.nha_cung_cap || r.supplier || ''}
                  - const _ct = r.chitiet || r.chi_tiet || r.items
                  td #{(_ct && _ct.length) ? _ct.length : 0}
                  - const _tong = (r.tongtiennhap != null) ? r.tongtiennhap : __calcTong(_ct)
                  td #{(_tong || 0).toLocaleString('vi-VN')}đ
                  td #{((r.ngaytao || r.ngay_tao || r.created_at) ? new Date(r.ngaytao || r.ngay_tao || r.created_at).toLocaleString('vi-VN') : '')}
                  td.text-nowrap
                    if r.daxuatkho
                      span.badge.bg-success.me-1 Đã nhập kho
                    else
                      span.badge.bg-secondary.me-1 Chưa nhập kho
                    if !r.daxuatkho && r.loaiphieu !== 'return'
                      form.d-inline.me-1(method='POST' action=`${admin}/imports/${r._id}/export` onsubmit='return confirm("Xác nhận nhập kho phiếu này? Sau khi xác nhận sẽ không thể chỉnh sửa.")')
                        input(type='hidden' name='_csrf' value=_csrf)
                        button.btn.btn-sm.btn-success(type='submit')
                          i.bi.bi-check2-circle
                          |  Xác nhận nhập kho
                    a.btn.btn-sm.btn-outline-primary.me-1(href=`${admin}/imports/${r._id}`)
                      i.bi.bi-eye
                      |  Xem
                    if !r.daxuatkho && r.loaiphieu !== 'return'
                      a.btn.btn-sm.btn-outline-secondary.me-1(href=`${admin}/imports/${r._id}/edit`)
                        i.bi.bi-pencil
                        |  Sửa
                    if !r.daxuatkho
                      form.d-inline(method='POST' action=`${admin}/imports/${r._id}/delete` onsubmit='return confirm("Xóa phiếu nhập này? Chỉ có thể xóa khi chưa xác nhận nhập kho.")')
                        input(type='hidden' name='_csrf' value=_csrf)
                        button.btn.btn-sm.btn-outline-danger(type='submit')
                          i.bi.bi-trash
                          |  Xóa

      if pagination && pagination.totalPages > 1
        nav.mt-3(aria-label='Phân trang phiếu nhập')
          ul.pagination
            - const __page = Number(pagination.currentPage || 1)
            - const __total = Number(pagination.totalPages || 1)
            - const __supplierQ = encodeURIComponent((filters && filters.supplier) || '')
            - const __limitQ = encodeURIComponent(String((filters && filters.limit) || 10))
            - const __baseQuery = `supplier=${__supplierQ}&limit=${__limitQ}`
            li.page-item(class=__page <= 1 ? 'disabled' : '')
              a.page-link(href=__page <= 1 ? '#' : `${admin}/imports?page=${__page - 1}&${__baseQuery}`) Trước
            each p in Array(__total).fill(0).map((_, i) => i + 1)
              li.page-item(class=p === __page ? 'active' : '')
                a.page-link(href=`${admin}/imports?page=${p}&${__baseQuery}`)= p
            li.page-item(class=__page >= __total ? 'disabled' : '')
              a.page-link(href=__page >= __total ? '#' : `${admin}/imports?page=${__page + 1}&${__baseQuery}`) Sau
