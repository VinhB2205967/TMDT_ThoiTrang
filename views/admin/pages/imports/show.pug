extends ../../layouts/default.pug

block main
  .container-fluid.p-3
    - const __headerExportId = receipt && receipt.phieuxuat_id && receipt.phieuxuat_id._id ? receipt.phieuxuat_id._id : (receipt ? receipt.phieuxuat_id : '')
    - const __headerExportCode = String((receipt && receipt.maphieuxuat) || (receipt && receipt.phieuxuat_id && receipt.phieuxuat_id.maphieu) || '').trim()
    - const __canCreateExportFromImport = Boolean(receipt && receipt.daxuatkho && String(receipt.loaiphieu || '') !== 'return')
    .d-flex.justify-content-between.align-items-center.mb-3.page-header-section.orders-header.admin-page-header
      h3.mb-0 Chi tiết phiếu nhập
      .d-flex.gap-2.orders-actions
        if !receipt.daxuatkho
          form(method='POST' action=`${admin}/imports/${receipt._id}/delete` onsubmit='return confirm("Xóa phiếu nhập này? Chỉ có thể xóa khi chưa xác nhận nhập kho.")')
            input(type='hidden' name='_csrf' value=_csrf)
            button.btn.btn-outline-danger.btn-header.btn-header-danger(type='submit')
              i.bi.bi-trash
              |  Xóa phiếu
        a.btn.btn-outline-secondary.btn-header.btn-header-outline(href=`${admin}/imports`)
          i.bi.bi-arrow-left
          |  Danh sách
        if !receipt.daxuatkho
          form(method='POST' action=`${admin}/imports/${receipt._id}/export` onsubmit='return confirm("Xác nhận nhập kho phiếu này? Sau khi xác nhận sẽ không thể chỉnh sửa.")')
            input(type='hidden' name='_csrf' value=_csrf)
            button.btn.btn-success.btn-header.btn-header-success(type='submit')
              i.bi.bi-check2-circle
              |  Xác nhận nhập kho
        if !receipt.daxuatkho && receipt.loaiphieu !== 'return'
          a.btn.btn-primary.btn-header.btn-header-primary.btn-header-edit(href=`${admin}/imports/${receipt._id}/edit`)
            i.bi.bi-pencil
            |  Chỉnh sửa
        if receipt.daxuatkho
          button.btn.btn-success.btn-header.btn-header-success(type='button' disabled)
            i.bi.bi-check-circle
            |  Đã nhập kho
        if __canCreateExportFromImport
          if __headerExportId || __headerExportCode
            a.btn.btn-outline-primary.btn-header(href=`${admin}/exports/${__headerExportId || __headerExportCode}`)
              i.bi.bi-box-arrow-up-right
              |  Xem phiếu xuất
          else
            button.btn.btn-outline-primary.btn-header(type='button' data-bs-toggle='collapse' data-bs-target='#create-export-from-import')
              i.bi.bi-box-seam
              |  Tạo phiếu xuất từ phiếu nhập

    if __canCreateExportFromImport && !(__headerExportId || __headerExportCode)
      .card.mb-3.collapse#create-export-from-import
        .card-header Tạo phiếu xuất từ phiếu nhập này
        .card-body
          form(method='POST' action=`${admin}/imports/${receipt._id}/create-export`)
            input(type='hidden' name='_csrf' value=_csrf)
            .row.g-3
              .col-md-6
                label.form-label Nơi nhận
                input.form-control(name='noinhan' required placeholder='Kho chi nhánh / địa chỉ giao')
              .col-md-6
                label.form-label Lý do xuất
                input.form-control(name='lydo' placeholder='Xuất toàn bộ từ phiếu nhập')
            .mt-3
              button.btn.btn-primary(type='submit')
                i.bi.bi-check2-circle
                |  Tạo phiếu xuất ngay

    .card.mb-3
      .card-header Thông tin phiếu nhập
      .card-body
        - const _ngayNhap = receipt.ngaynhap || receipt.ngay_nhap || receipt.import_date
        - const _orderId = receipt && receipt.donhang_id && receipt.donhang_id._id ? receipt.donhang_id._id : (receipt ? receipt.donhang_id : '')
        - const _orderCode = String((receipt && receipt.madonhang) || (receipt && receipt.donhang_id && receipt.donhang_id.madonhang) || '').trim()
        - const _exportId = receipt && receipt.phieuxuat_id && receipt.phieuxuat_id._id ? receipt.phieuxuat_id._id : (receipt ? receipt.phieuxuat_id : '')
        - const _exportCode = String((receipt && receipt.maphieuxuat) || (receipt && receipt.phieuxuat_id && receipt.phieuxuat_id.maphieu) || '').trim()
        - const _loaiphieuRaw = String(receipt.loaiphieu || '').trim().toLowerCase()
        - const _loaiphieuLabel = String(receipt.tenloaiphieu || '').trim() || (_loaiphieuRaw === 'return' ? 'Nhập kho hoàn trả' : 'Nhập kho')
        - const _nguonNhap = String(receipt.nguonnhap || '').trim()
        .row.g-3
          .col-md-4
            .fw-semibold Mã phiếu
            div #{receipt.maphieu || receipt.ma_phieu || receipt.code}
          .col-md-4
            .fw-semibold Loại phiếu
            div #{_loaiphieuLabel}
          .col-md-4
            .fw-semibold Nguồn nhập
            div #{_nguonNhap || '-'}
          .col-md-4
            .fw-semibold Ngày nhập
            div #{_ngayNhap ? new Date(_ngayNhap).toLocaleString('vi-VN') : ''}
          .col-md-4
            .fw-semibold Nhà cung cấp
            div #{receipt.nhacungcap || receipt.nha_cung_cap || receipt.supplier || ''}
          .col-md-4
            .fw-semibold Phiếu xuất liên kết
            if _exportCode || _exportId
              a(href=`${admin}/exports/${_exportId || _exportCode}`) #{_exportCode || _exportId}
            else
              div.text-muted -
          .col-md-4
            .fw-semibold Đơn hàng liên kết
            if _orderId || _orderCode
              if _orderId
                a(href=`${admin}/orders/${_orderId}`) #{_orderCode || _orderId}
              else
                div #{_orderCode}
            else
              div.text-muted -
          .col-12
            .fw-semibold Ghi chú
            div #{receipt.ghichu || receipt.ghi_chu || receipt.note || ''}

          .col-md-4
            .fw-semibold Trạng thái nhập kho
            if receipt.daxuatkho
              div.text-success Đã nhập kho
            else
              div.text-muted Chưa nhập kho
          .col-md-4
            .fw-semibold Ngày ghi nhận kho
            div #{receipt.ngayxuatkho ? new Date(receipt.ngayxuatkho).toLocaleString('vi-VN') : ''}

          .col-12
            .fw-semibold Tổng tiền nhập
            - const __ct = receipt.chitiet || receipt.chi_tiet || receipt.items || []
            - function __toNum(v) { const n = Number(v); return Number.isFinite(n) ? n : 0; }
            - function __calcTong(items) { return (items || []).reduce(function (sum, it) { const qty = __toNum(it && (it.soluong || it.so_luong || it.quantity || 0)); const price = __toNum(it && (it.gianhap != null ? it.gianhap : (it.gia_nhap != null ? it.gia_nhap : (it.import_price || 0)))); return sum + (qty * price); }, 0); }
            - const __tong = (receipt.tongtiennhap != null) ? receipt.tongtiennhap : __calcTong(__ct)
            div #{(__tong || 0).toLocaleString('vi-VN')}đ

    .card
      .card-header Danh sách sản phẩm nhập
      .card-body
        - const _chiTiet = receipt.chitiet || receipt.chi_tiet || receipt.items
        if !_chiTiet || _chiTiet.length === 0
          .alert.alert-info.mb-0 Không có dòng nhập.
        else
          .table-responsive
            table.table.table-bordered.table-sm.align-middle
              thead.table-light
                tr
                  th Sản phẩm
                  th Biến thể
                  th Size
                  th Màu
                  th Số lượng
                  th Giá nhập
                  th Danh mục
                  th Ảnh
              tbody
                each it in _chiTiet
                  - const v = it.bientheid ? String(it.bientheid) : (it.bien_the_id ? String(it.bien_the_id) : (it.variant_id ? String(it.variant_id) : 'main'))
                  - const mau = String(it.mausac || it.mau_sac || it.color || '').trim()
                  - const vLabel = v === 'main' ? 'Mặc định' : (mau || 'Biến thể')
                  tr
                    td #{it.tensanpham || it.ten_san_pham || it.product_name || it.sanphamid || it.san_pham_id || it.product_id}
                    td #{vLabel}
                    td #{it.kichco || it.kich_co || it.size || ''}
                    td #{it.mausac || it.mau_sac || it.color || ''}
                    td #{it.soluong || it.so_luong || it.quantity || 0}
                    td #{((it.gianhap != null ? it.gianhap : (it.gia_nhap != null ? it.gia_nhap : it.import_price)) || 0).toLocaleString('vi-VN')}
                    - const _danhMucRaw = String(it.danhmuc || it.danh_muc || it.category || '').trim().toLowerCase()
                    - const _danhMucLabel = _danhMucRaw === 'ao' ? 'Áo' : _danhMucRaw === 'quan' ? 'Quần' : _danhMucRaw === 'vay' ? 'Váy' : _danhMucRaw === 'phukien' ? 'Phụ kiện' : _danhMucRaw === 'giay' ? 'Giày' : _danhMucRaw === 'tui' ? 'Túi' : _danhMucRaw === 'aokhoac' ? 'Áo khoác' : (it.danhmuc || it.danh_muc || it.category || '')
                    td #{_danhMucLabel}
                    td
                      - const _img = it.hinhanh || it.image
                      if _img
                        img(src=_img style='width:44px;height:44px;object-fit:cover;border-radius:6px')
                      else
                        span.text-muted -

    .card.mt-3
      .card-header Nhân viên thực hiện
      .card-body
        - const _nv = nhanVienKy || receipt.nhanvienky || {}
        - const _nvName = _nv.tennhanvien || '---'
        - const _nvId = _nv.idnhanvien || '---'
        - const _signedAt = _nv.thoigianky || receipt.ngaytao
        - const _avatar = _nv.anhdaidien || '/images/avatar/avatar.png'
        .row.g-3.align-items-center
          .col-md-6
            .fw-semibold Nhân viên nhập kho
            div.fs-5 #{_nvName}
            .text-muted ID nhân viên: #{_nvId}
            if _signedAt
              .text-muted.mt-1 Ngày ký: #{new Date(_signedAt).toLocaleString('vi-VN')}
          .col-md-3
            .fw-semibold Ảnh nhân viên
            if _avatar
              img(src=_avatar alt='Ảnh nhân viên' style='width:96px;height:96px;object-fit:cover;border:1px solid #e5e7eb;border-radius:10px;background:#fff;')
            else
              div.text-muted Chưa có ảnh nhân viên
          .col-md-3
            .fw-semibold Ảnh chữ ký
            if _nv.anhchuky
              img(src=_nv.anhchuky alt='Chữ ký nhân viên' style='max-width:220px;max-height:120px;object-fit:contain;border:1px solid #e5e7eb;border-radius:8px;padding:6px;background:#fff;')
            else
              div.text-muted Chưa có ảnh chữ ký
