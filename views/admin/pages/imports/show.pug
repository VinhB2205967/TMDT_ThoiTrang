extends ../../layouts/default.pug

block main
  .container-fluid.p-3
    .d-flex.justify-content-between.align-items-center.mb-3
      h3.mb-0 Chi tiết phiếu nhập
      .d-flex.gap-2
        form(method='POST' action=`${admin}/imports/${receipt._id}/delete` onsubmit='return confirm("Xóa phiếu nhập này? Hành động này sẽ hoàn tác tồn kho nếu chưa phát sinh xuất FIFO.")')
          input(type='hidden' name='_csrf' value=_csrf)
          button.btn.btn-outline-danger(type='submit')
            i.bi.bi-trash
            |  Xóa phiếu
        a.btn.btn-outline-secondary(href=`${admin}/imports`)
          i.bi.bi-arrow-left
          |  Danh sách
        a.btn.btn-primary(href=`${admin}/imports/${receipt._id}/edit`)
          i.bi.bi-pencil
          |  Chỉnh sửa

    .card.mb-3
      .card-header Thông tin phiếu nhập
      .card-body
        .row.g-3
          .col-md-4
            .fw-semibold Mã phiếu
            div #{receipt.maphieu || receipt.ma_phieu || receipt.code}
          .col-md-4
            .fw-semibold Ngày nhập
            - const _ngayNhap = receipt.ngaynhap || receipt.ngay_nhap || receipt.import_date
            div #{_ngayNhap ? new Date(_ngayNhap).toLocaleString('vi-VN') : ''}
          .col-md-4
            .fw-semibold Nhà cung cấp
            div #{receipt.nhacungcap || receipt.nha_cung_cap || receipt.supplier || ''}
          .col-12
            .fw-semibold Ghi chú
            div #{receipt.ghichu || receipt.ghi_chu || receipt.note || ''}

          .col-12
            .fw-semibold Tổng tiền nhập
            - const __ct = receipt.chitiet || receipt.chi_tiet || receipt.items || []
            - function __toNum(v) { const n = Number(v); return Number.isFinite(n) ? n : 0; }
            - function __calcTong(items) { return (items || []).reduce(function (sum, it) { const qty = __toNum(it && (it.soluong || it.so_luong || it.quantity || 0)); const price = __toNum(it && (it.gianhap != null ? it.gianhap : (it.gia_nhap != null ? it.gia_nhap : (it.import_price || 0)))); return sum + (qty * price); }, 0); }
            - const __tong = (receipt.tongtiennhap != null) ? receipt.tongtiennhap : __calcTong(__ct)
            div #{(__tong || 0).toLocaleString('vi-VN')}đ

    .card
      .card-header Danh sách sản phẩm nhập
      .card-body
        - const _chiTiet = receipt.chitiet || receipt.chi_tiet || receipt.items
        if !_chiTiet || _chiTiet.length === 0
          .alert.alert-info.mb-0 Không có dòng nhập.
        else
          .table-responsive
            table.table.table-bordered.table-sm.align-middle
              thead.table-light
                tr
                  th Sản phẩm
                  th Biến thể
                  th Size
                  th Màu
                  th Số lượng
                  th Giá nhập
                  th Giá bán
                  th Danh mục
                  th Ảnh
              tbody
                each it in _chiTiet
                  - const v = it.bientheid ? String(it.bientheid) : (it.bien_the_id ? String(it.bien_the_id) : (it.variant_id ? String(it.variant_id) : 'main'))
                  - const mau = String(it.mausac || it.mau_sac || it.color || '').trim()
                  - const vLabel = v === 'main' ? 'Mặc định' : (mau || 'Biến thể')
                  tr
                    td #{it.tensanpham || it.ten_san_pham || it.product_name || it.sanphamid || it.san_pham_id || it.product_id}
                    td #{vLabel}
                    td #{it.kichco || it.kich_co || it.size || ''}
                    td #{it.mausac || it.mau_sac || it.color || ''}
                    td #{it.soluong || it.so_luong || it.quantity || 0}
                    td #{((it.gianhap != null ? it.gianhap : (it.gia_nhap != null ? it.gia_nhap : it.import_price)) || 0).toLocaleString('vi-VN')}
                    td #{((it.giabandexuat != null ? it.giabandexuat : (it.gia_ban_de_xuat != null ? it.gia_ban_de_xuat : it.suggested_price)) || 0).toLocaleString('vi-VN')}
                    td #{it.danhmuc || it.danh_muc || it.category || ''}
                    td
                      - const _img = it.hinhanh || it.image
                      if _img
                        img(src=_img style='width:44px;height:44px;object-fit:cover;border-radius:6px')
                      else
                        span.text-muted -

    .card.mt-3
      .card-header Nhân viên thực hiện
      .card-body
        - const _nv = nhanVienKy || receipt.nhanvienky || {}
        - const _nvName = _nv.tennhanvien || '---'
        - const _nvId = _nv.idnhanvien || '---'
        - const _signedAt = _nv.thoigianky || receipt.ngaytao
        .row.g-3.align-items-center
          .col-md-8
            .fw-semibold Nhân viên nhập kho
            div.fs-5 #{_nvName}
            .text-muted ID nhân viên: #{_nvId}
            if _signedAt
              .text-muted.mt-1 Ngày ký: #{new Date(_signedAt).toLocaleString('vi-VN')}
          .col-md-4
            .fw-semibold Ảnh chữ ký
            if _nv.anhchuky
              img(src=_nv.anhchuky alt='Chữ ký nhân viên' style='max-width:220px;max-height:120px;object-fit:contain;border:1px solid #e5e7eb;border-radius:8px;padding:6px;background:#fff;')
            else
              div.text-muted Chưa có ảnh chữ ký
