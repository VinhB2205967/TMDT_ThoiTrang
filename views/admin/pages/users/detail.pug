extends ../../layouts/default.pug

block main
  - const accountProvider = String((u && u.account && u.account.provider) || '').toLowerCase()
  - const isGoogleAccount = accountProvider === 'google'
  - const isAdminAccount = String((u && u.vaitro) || 'user') === 'admin'
  - const avatarSrc = (u && u.avatar) ? u.avatar : '/images/avatar/avatar.png'
  - const signatureSrc = (u && u.chukyso) ? u.chukyso : ''

  .page-header-section.orders-header.user-detail-header
    .d-flex.align-items-center.justify-content-between.flex-wrap.gap-2.users-detail-header-row
      h1.page-title Chi tiết tài khoản
      .d-flex.align-items-center.gap-2.orders-actions.users-detail-header-actions
        if u && u._id && String(u.vaitro || 'user') !== 'admin'
          a.btn.btn-header.btn-header-primary.btn-user-detail-chat(href=`/admin/chats?userId=${u._id}`)
            i.bi.bi-chat-dots.me-1
            | Chat khách hàng
        a.btn.btn-header.btn-header-outline.btn-user-detail-back(href="/admin/users")
          i.bi.bi-arrow-left.me-1
          | Quay lại

  .container-fluid.p-4
    .card.border-0.shadow-sm.mb-4
      .card-body
        .row.g-3
          .col-12.col-lg-6
            .mb-2
              span.fw-semibold Email:
              |  #{u.email}
            .mb-2
              span.fw-semibold ID:
              |  #{u.idHienThi || '-'}
            .mb-2
              span.fw-semibold Vai trò:
              |  #{u.vaitro}
            .mb-2
              span.fw-semibold Trạng thái:
              |  #{u.trangthai}
            .mb-2
              span.fw-semibold Đã xóa:
              |  #{u.daxoa ? 'Có' : 'Không'}
            .mb-2
              span.fw-semibold Đăng nhập:
              |  #{accountProvider === 'google' ? 'Google' : 'Local'}
            .mb-2
              span.fw-semibold Online:
              |  #{u.isOnline ? 'Online' : 'Offline'}
            .mb-2
              span.fw-semibold Last seen:
              if u.lastSeenAt
                |  #{new Date(u.lastSeenAt).toLocaleString('vi-VN')}
              else
                |  -

          .col-12.col-lg-6
            .d-flex.flex-wrap.justify-content-lg-end.gap-3
              .text-center
                .small.text-muted.mb-2 Ảnh đại diện
                img#avatarPreviewHeader(src=avatarSrc alt="avatar" style="width:96px;height:96px;object-fit:cover;border-radius:12px")
              if isAdminAccount
                .text-center
                  .small.text-muted.mb-2 Chữ ký
                  if signatureSrc
                    img#signaturePreviewHeader(src=signatureSrc alt="signature" style="width:180px;height:96px;object-fit:contain;border-radius:12px;border:1px solid #e5e7eb;padding:8px;background:#fff")
                    .form-text.mb-0 Dùng trên phiếu nhập, xuất, hoàn trả.
                  else
                    .d-flex.align-items-center.justify-content-center.text-muted#signaturePreviewHeaderPlaceholder(style="width:180px;height:96px;border-radius:12px;border:1px dashed #cbd5e1;padding:8px;background:#fff")
                      | Chưa có chữ ký
                    img#signaturePreviewHeader(src="" alt="signature" style="width:180px;height:96px;object-fit:contain;border-radius:12px;border:1px solid #e5e7eb;padding:8px;background:#fff;display:none")
                    .form-text.mb-0 Dùng trên phiếu nhập, xuất, hoàn trả.

    .row.g-4
      .col-12.col-lg-7
        .card.border-0.shadow-sm
          .card-body
            h2.h6.fw-bold.mb-3 Cập nhật thông tin
            - const updateAction = `/admin/users/${u._id}/update?_csrf=${encodeURIComponent(csrfToken || '')}`
            form(method="POST" action=updateAction enctype="multipart/form-data")
              input(type="hidden" name="_csrf" value=csrfToken)
              .row.g-3
                .col-12
                  label.form-label Họ tên
                  input.form-control(type="text" name="hoten" value=(u.hoten || ''))
                .col-12.col-md-6
                  label.form-label Số điện thoại
                  input#soDienThoaiInput.form-control(
                    type="text"
                    name="sodienthoai"
                    value=(u.sodienthoai || '')
                    inputmode="numeric"
                    maxlength="10"
                    minlength="10"
                    pattern="0[0-9]{9}"
                    title="Số điện thoại gồm 10 số và bắt đầu bằng 0"
                    placeholder="0xxxxxxxxx"
                  )
                .col-12.col-md-6
                  label.form-label Giới tính
                  select.form-select(name="gioitinh")
                    option(value="" selected=((u.gioitinh || '') === '')) Chọn...
                    option(value="Nam" selected=((u.gioitinh || '') === 'Nam')) Nam
                    option(value="Nữ" selected=((u.gioitinh || '') === 'Nữ')) Nữ
                    option(value="Khác" selected=((u.gioitinh || '') === 'Khác')) Khác
                .col-12
                  label.form-label Địa chỉ
                  input.form-control(type="text" name="diachi" value=(u.diachi || ''))
                .col-12.col-md-6
                  label.form-label Ngày sinh
                  - const d = u.ngaysinh ? new Date(u.ngaysinh) : null;
                  - const yyyy = d && !Number.isNaN(d.getTime()) ? d.getFullYear() : '';
                  - const mm = d && !Number.isNaN(d.getTime()) ? String(d.getMonth() + 1).padStart(2, '0') : '';
                  - const dd = d && !Number.isNaN(d.getTime()) ? String(d.getDate()).padStart(2, '0') : '';
                  - const pickedDate = yyyy ? `${yyyy}-${mm}-${dd}` : '';
                  - const todayObj = new Date();
                  - const todayY = todayObj.getFullYear();
                  - const todayM = String(todayObj.getMonth() + 1).padStart(2, '0');
                  - const todayD = String(todayObj.getDate()).padStart(2, '0');
                  - const todayIso = `${todayY}-${todayM}-${todayD}`;
                  - const safeDateVal = pickedDate ? (pickedDate > todayIso ? todayIso : pickedDate) : todayIso;
                  input.form-control(type="date" name="ngaysinh" value=safeDateVal max=todayIso lang="vi")
                  .form-text Định dạng ngày/tháng/năm, không vượt quá hôm nay.
                .col-12.col-md-6
                  label.form-label Vai trò
                  select.form-select(name="vaitro")
                    option(value="user" selected=(u.vaitro === 'user')) User
                    option(value="admin" selected=(u.vaitro === 'admin')) Admin
                .col-12.col-md-6
                  label.form-label Trạng thái
                  select.form-select(name="trangthai")
                    option(value="active" selected=(u.trangthai === 'active')) Hoạt động
                    option(value="noactive" selected=(u.trangthai === 'noactive')) Tạm khóa
                .col-12
                  label.form-label Ảnh đại diện
                  .d-flex.flex-wrap.align-items-center.gap-3
                    img#avatarPreviewForm(src=avatarSrc alt="avatar-preview" style="width:72px;height:72px;object-fit:cover;border-radius:10px;border:1px solid #e5e7eb")
                    input#avatarFileInput.form-control(type="file" name="avatarFile" accept="image/*" style="max-width:360px")
                if isAdminAccount
                  .col-12
                    label.form-label Ảnh chữ ký
                    .d-flex.flex-wrap.align-items-center.gap-3
                      if signatureSrc
                        img#signaturePreviewForm(src=signatureSrc alt="signature-preview" style="width:180px;height:90px;object-fit:contain;border-radius:10px;border:1px solid #e5e7eb;padding:6px;background:#fff")
                      else
                        .d-flex.align-items-center.justify-content-center.text-muted#signaturePreviewFormPlaceholder(style="width:180px;height:90px;border-radius:10px;border:1px dashed #cbd5e1;padding:6px;background:#fff")
                          | Chưa có chữ ký
                        img#signaturePreviewForm(src="" alt="signature-preview" style="width:180px;height:90px;object-fit:contain;border-radius:10px;border:1px solid #e5e7eb;padding:6px;background:#fff;display:none")
                      .d-flex.flex-column.gap-1
                        input#signatureFileInput.form-control(type="file" name="signatureFile" accept="image/*" style="max-width:360px")
                        .form-text Ảnh này sẽ được dùng khi in hoặc xem phiếu nhập, xuất, hoàn trả của admin.
              .mt-3
                button.btn.btn-primary(type="submit") Lưu thay đổi
                button.btn.btn-outline-secondary.ms-2(type="submit") Cập nhật ảnh

      .col-12.col-lg-5
        .card.border-0.shadow-sm.mb-4
          .card-body
            h2.h6.fw-bold.mb-3 Đặt lại mật khẩu
            if isGoogleAccount
              .alert.alert-info.py-2.mb-0
                i.bi.bi-google.me-2
                | Tài khoản đăng nhập bằng Google, không hỗ trợ đặt lại mật khẩu tại đây.
            else
              form(method="POST" action=`/admin/users/${u._id}/password`)
                input(type="hidden" name="_csrf" value=csrfToken)
                .mb-3
                  label.form-label Mật khẩu mới
                  input.form-control(type="password" name="newPassword" minlength="6" required)
                .mb-3
                  label.form-label Xác nhận mật khẩu mới
                  input.form-control(type="password" name="confirmPassword" minlength="6" required)
                button.btn.btn-success(type="submit") Đặt lại

        .card.border-0.shadow-sm
          .card-body
            h2.h6.fw-bold.text-danger.mb-3 Hành động
            .d-flex.flex-wrap.gap-2
              if u.daxoa
                form(method="POST" action=`/admin/users/${u._id}/restore`)
                  input(type="hidden" name="_csrf" value=csrfToken)
                  button.btn.btn-outline-success(type="submit") Khôi phục
                form(method="POST" action=`/admin/users/${u._id}/hard-delete` onsubmit="return confirm('Xóa vĩnh viễn tài khoản này? Hành động không thể hoàn tác!')")
                  input(type="hidden" name="_csrf" value=csrfToken)
                  button.btn.btn-danger(type="submit") Xóa vĩnh viễn
              form(method="POST" action=`/admin/users/${u._id}/delete` onsubmit="return confirm('Xóa tài khoản này?')")
                input(type="hidden" name="_csrf" value=csrfToken)
                button.btn.btn-outline-danger(type="submit") Xóa (mềm)

  script.
    (function () {
      var bindImagePreview = function (inputId, previewIds, placeholderIds) {
        var fileInput = document.getElementById(inputId);
        if (!fileInput) return;

        var previews = (previewIds || []).map(function (id) {
          return document.getElementById(id);
        }).filter(Boolean);
        var placeholders = (placeholderIds || []).map(function (id) {
          return document.getElementById(id);
        }).filter(Boolean);
        var objectUrl = null;

        fileInput.addEventListener('change', function (event) {
          var file = event.target && event.target.files && event.target.files[0];
          if (!file) return;

          if (objectUrl) URL.revokeObjectURL(objectUrl);
          objectUrl = URL.createObjectURL(file);

          previews.forEach(function (preview) {
            preview.src = objectUrl;
            preview.style.display = '';
          });
          placeholders.forEach(function (placeholder) {
            placeholder.style.display = 'none';
          });
        });
      };

      bindImagePreview('avatarFileInput', ['avatarPreviewHeader', 'avatarPreviewForm']);
      bindImagePreview(
        'signatureFileInput',
        ['signaturePreviewHeader', 'signaturePreviewForm'],
        ['signaturePreviewHeaderPlaceholder', 'signaturePreviewFormPlaceholder']
      );

      var phoneInput = document.getElementById('soDienThoaiInput');
      if (phoneInput) {
        var validatePhone = function () {
          var val = String(phoneInput.value || '').trim();
          if (!val) {
            phoneInput.setCustomValidity('');
            return;
          }
          if (/^0\d{9}$/.test(val)) {
            phoneInput.setCustomValidity('');
          } else {
            phoneInput.setCustomValidity('Số điện thoại phải gồm 10 số và bắt đầu bằng 0');
          }
        };

        phoneInput.addEventListener('input', function () {
          var digitsOnly = String(phoneInput.value || '').replace(/\D/g, '').slice(0, 10);
          phoneInput.value = digitsOnly;
          validatePhone();
        });

        phoneInput.addEventListener('blur', validatePhone);
        validatePhone();
      }
    })();
