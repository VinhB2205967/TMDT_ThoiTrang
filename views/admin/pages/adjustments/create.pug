extends ../../layouts/default.pug

block main
  .container-fluid.p-3
    .d-flex.justify-content-between.align-items-center.mb-3.page-header-section.orders-header.admin-page-header
      h3.mb-0 Tạo phiếu điều chỉnh kho
      a.btn.btn-outline-secondary(href=`${admin}/adjustments`)
        i.bi.bi-arrow-left
        |  Danh sách

    form#adjustment-create-form(method='POST' action=`${admin}/adjustments/create`)
      input(type='hidden' name='_csrf' value=csrfToken)

      .card.mb-3
        .card-header Thông tin phiếu
        .card-body
          .row.g-3
            .col-md-3
              label.form-label Mã phiếu
              input.form-control(type='text' name='maphieu' value=maPhieu readonly)
            .col-md-5
              label.form-label Phiếu nhập tham chiếu
              select#source-import-receipt.form-select(name='phieunhapid' required)
                option(value='') -- Chọn phiếu nhập --
                each r in (importReceipts || [])
                  - const ngayNhapText = r.ngaynhap ? new Date(r.ngaynhap).toLocaleDateString('vi-VN') : ''
                  option(value=r._id) #{r.maphieu || 'N/A'}#{r.nhacungcap ? ' - ' + r.nhacungcap : ''}#{ngayNhapText ? ' (' + ngayNhapText + ')' : ''}
              .form-text Chỉ được điều chỉnh sản phẩm thuộc phiếu nhập đã chọn.
            .col-md-4
              label.form-label Lý do điều chỉnh
              input.form-control(type='text' name='lydo' placeholder='Nhập lý do điều chỉnh kho...' required)

      .card
        .card-header.d-flex.justify-content-between.align-items-center
          span Chi tiết điều chỉnh
          button#btn-add-row.btn.btn-sm.btn-primary(type='button')
            i.bi.bi-plus-lg
            |  Thêm dòng
        .card-body
          .table-responsive
            table.table.table-bordered.table-sm.align-middle
              thead.table-light
                tr
                  th(style='min-width:260px') Sản phẩm (trong phiếu nhập)
                  th(style='min-width:170px') Biến thể
                  th(style='min-width:90px') Size
                  th(style='min-width:130px') Số lượng (+/-)
                  th(style='min-width:120px') Tồn hiện tại
                  th(style='min-width:140px') Tồn sau điều chỉnh
                  th(style='min-width:120px') Màu
                  th(style='width:60px')
              tbody#adjustment-items-body
          .alert.alert-secondary.mb-0
            | Quy tắc: số dương là tăng tồn, số âm là giảm tồn. Mỗi sản phẩm/biến thể/size chỉ được chọn 1 lần. Không cho phép tồn sau điều chỉnh âm.

      .d-flex.justify-content-end.mt-3
        button.btn.btn-success(type='submit')
          i.bi.bi-check2-circle
          |  Tạo phiếu điều chỉnh

block scripts
  script(type='application/json' id='products-json')
    != JSON.stringify(products || [])
  script(type='application/json' id='sizes-json')
    != JSON.stringify(sizeList || [])
  script(type='application/json' id='import-receipts-json')
    != JSON.stringify(importReceipts || [])
  script(type='application/json' id='receipt-items-json')
    != JSON.stringify(receiptItemsById || {})
  script(src='/admin/js/adjustments.js')
