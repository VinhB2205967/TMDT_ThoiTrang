extends ../../layouts/default.pug

block styles
  style.
    .home-sections-page .page-title {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0;
    }
    .home-sections-page .page-title i {
      color: #facc15;
    }
    .home-sections-page .home-sections-card {
      border: 0;
      border-radius: 18px;
      box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
      overflow: hidden;
    }
    .home-sections-page .header-config-box {
      border: 1px solid rgba(99, 102, 241, 0.16);
      border-radius: 14px;
      background: linear-gradient(180deg, #ffffff 0%, #f8faff 100%);
      padding: 16px;
    }
    .home-sections-page .header-config-title {
      margin-bottom: 12px;
      font-size: 16px;
      font-weight: 700;
      color: #1e293b;
    }
    .home-sections-page .header-preview-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      justify-content: flex-start;
    }
    .home-sections-page .header-preview-img {
      width: 64px;
      height: 64px;
      object-fit: cover;
      border-radius: 14px;
      border: 1px solid #dbe3ff;
      background: #fff;
      box-shadow: 0 6px 18px rgba(99, 102, 241, 0.14);
    }
    .home-sections-page .section-table {
      margin-bottom: 0;
      border-radius: 12px;
      overflow: hidden;
    }
    .home-sections-page .section-table thead th {
      background: #eef1ff;
      color: #0f172a;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      font-size: 13px;
      border-bottom: 0;
    }
    .home-sections-page .section-table tbody td {
      vertical-align: middle;
    }
    .home-sections-page .actions-row {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 12px;
      margin-bottom: 12px;
    }
    .home-sections-page .actions-note {
      color: #64748b;
      font-size: 13px;
      margin: 0;
    }
    .home-sections-page .save-row {
      display: flex;
      justify-content: flex-end;
      margin-top: 14px;
    }
    @media (max-width: 991.98px) {
      .home-sections-page .header-preview-wrap {
        justify-content: space-between;
      }
      .home-sections-page .actions-row {
        flex-direction: column;
        align-items: flex-start;
      }
    }

block main
  - const editableSections = (sections || []).filter((item) => item && item.key !== 'banner_slider')

  .page-header-section.orders-header
    h1.page-title
      i.bi.bi-grid-1x2-fill
      | Quản lý trang chủ

  .container-fluid.py-4.home-sections-page
    .card.home-sections-card
      .card-body.p-4
        - const headerAction = `/admin/home-sections/client-header?_csrf=${encodeURIComponent(csrfToken || '')}`
        form.header-config-box.mb-4(method='POST' action=headerAction enctype='multipart/form-data')
          input(type='hidden' name='_csrf' value=csrfToken)
          .header-config-title Cấu hình Header
          .row.g-3.align-items-end
            .col-12.col-lg-5
              label.form-label(for='clientHeaderName') Tên Shop
              input#clientHeaderName.form-control(type='text' name='client_header_name' maxlength='80' value=(headerSettings && headerSettings.name ? headerSettings.name : 'Fashion Store') placeholder='Nhập tên cửa hàng...')
            .col-12.col-lg-4
              label.form-label(for='clientHeaderLogo') Logo
              input#clientHeaderLogo.form-control(type='file' name='client_header_logo' accept='image/*' data-current=(headerSettings && headerSettings.logo ? headerSettings.logo : ''))
            .col-12.col-lg-3
              .header-preview-wrap
                img#clientHeaderLogoPreview.header-preview-img(src=(headerSettings && headerSettings.logo ? headerSettings.logo : '/images/logo.png') alt='Logo header client')
                button.btn.btn-outline-primary(type='submit') Cập nhật Header

        .actions-row
          p.actions-note Banner Slider là block mặc định nên không chỉnh ở đây.

        .table-responsive
          table.table.table-striped.align-middle.section-table
            thead
              tr
                th Block
                th Thứ tự
                th Hiển thị
                th Giới hạn
            tbody
              if editableSections.length
                each item in editableSections
                  tr(data-key=item.key)
                    td #{item.tieuDe || item.key}
                    td
                      input.form-control.form-control-sm(type='number' name='thuTu' value=item.thuTu min='0')
                    td
                      input.form-check-input(type='checkbox' name='hienthi' checked=item.hienthi)
                    td
                      if item.key === 'new_products' || item.key === 'best_sellers' || item.key === 'blog'
                        input.form-control.form-control-sm(type='number' name='limit' value=(item.config && item.config.limit ? item.config.limit : '') min='1')
                      else
                        span.text-muted --
              else
                tr
                  td(colspan='4').text-muted Chưa có cấu hình.

        .save-row
          button.btn.btn-primary(type='button' data-action='save-all') Lưu thay đổi

block scripts
  script(src='/admin/js/home-sections.js')
