extends ../../layouts/default.pug

block main
  .page-header-section.orders-header
    h1.page-title.mb-0 Quản lý Banner

  .container-fluid.py-4
    .card.mb-4
      .card-body
        form#bannerCreate
          .row.g-3
            .col-12.col-md-4
              label.form-label Tiêu đề
              input.form-control(type="text" name="tieude" required)
            .col-12.col-md-4
              label.form-label Mô tả
              input.form-control(type="text" name="mota")
            .col-12.col-md-4
              label.form-label Hình ảnh
              input.form-control(type="file" name="image" accept="image/*" required)
            .col-12.col-md-3
              label.form-label Nút CTA
              input.form-control(type="text" name="nut_text")
            .col-12.col-md-5
              label.form-label Link CTA
              select.form-select(name="nut_link")
                option(value="") Chọn nơi chuyển đến
                each destination in (ctaDestinationOptions || [])
                  option(value=destination.url)= destination.label
              .form-text Chọn nhanh trang đích.
            .col-12.col-md-3
              label.form-label Thứ tự
              input.form-control(type="number" name="thuTu" value="0" min="0")
            .col-12
              .form-check
                input.form-check-input(type="checkbox" name="hienthi" checked)
                label.form-check-label Hiển thị
          .mt-3
            button.btn.btn-primary(type="submit") Tạo banner

    .card
      .card-body
        table.table.table-striped.align-middle
          thead
            tr
              th Tiêu đề
              th Hình ảnh
              th Thứ tự
              th Hiển thị
              th Hành động
          tbody
            if banners && banners.length
              each banner in banners
                tr(data-id=banner._id)
                  td
                    input.form-control.form-control-sm(type="text" name="tieude" value=banner.tieude)
                    input.form-control.form-control-sm.mt-2(type="text" name="mota" value=banner.mota)
                    input.form-control.form-control-sm.mt-2(type="text" name="nut_text" value=banner.nut_text placeholder="CTA text")
                    - const hasPresetDestination = (ctaDestinationOptions || []).some((destination) => destination && destination.url === banner.nut_link)
                    select.form-select.form-select-sm.mt-2(name="nut_link")
                      option(value="") Chọn nơi chuyển đến
                      each destination in (ctaDestinationOptions || [])
                        option(value=destination.url selected=banner.nut_link === destination.url)= destination.label
                      if banner.nut_link && !hasPresetDestination
                        option(value=banner.nut_link selected=true)= `Link cũ: ${banner.nut_link}`
                  td
                    if banner.hinhanh
                      img.img-thumbnail.mb-2(style="max-width:120px" src=banner.hinhanh alt=banner.tieude)
                    input.form-control.form-control-sm(type="file" name="image" accept="image/*")
                  td
                    input.form-control.form-control-sm(type="number" name="thuTu" value=banner.thuTu min="0")
                  td
                    input.form-check-input(type="checkbox" name="hienthi" checked=banner.hienthi)
                  td
                    .d-flex.gap-2
                      button.btn.btn-sm.btn-outline-primary(type="button" data-action="save") Lưu
                      button.btn.btn-sm.btn-outline-secondary(type="button" data-action="toggle") Bật/Tắt
                      button.btn.btn-sm.btn-outline-danger(type="button" data-action="delete") Xóa
            else
              tr
                td(colspan="5").text-muted Chưa có banner.

block scripts
  script(src="/admin/js/home-banners.js")
