extends ../../layouts/default.pug

block main
  .container-fluid.p-3.admin-workspace.brands-admin-page
    .admin-page-header
      .d-flex.justify-content-between.align-items-center.gap-3(style="width: 100%;")
        div
          h3.mb-2 🏷️ Quản lý Thương hiệu
          p.text-muted.mb-0 Tổng cộng: 
            strong= brands ? brands.length : 0
            |  thương hiệu
        a.btn.btn-header.btn-admin-accent(href="#" onclick="showBrandForm()")
          i.bi.bi-plus-lg
          |  Thêm thương hiệu mới

    .admin-filter-bar.mb-4(style="display: none;" id="brandFormContainer")
      form#brandCreate(class="w-100")
        .row.g-2
          .col-12.col-md-3
            label.form-label Tên thương hiệu
            input.form-control(type="text" name="ten" placeholder="Nhập tên thương hiệu" required)
          .col-12.col-md-3
            label.form-label Logo
            input.form-control(type="file" name="logo" accept="image/*" required)
          .col-12.col-md-2
            label.form-label Thứ tự
            input.form-control(type="number" name="thuTu" value="0" min="0")
          .col-12.col-md-2
            label.form-label
            .d-flex.gap-2.h-100.align-items-end
              .form-check.m-0
                input#noiBatCheck.form-check-input(type="checkbox" name="noiBat")
                label.form-check-label(for="noiBatCheck") Nổi bật
              .form-check.m-0
                input#hienthiCheck.form-check-input(type="checkbox" name="hienthi" checked)
                label.form-check-label(for="hienthiCheck") Hiển thị
          .col-12.col-md-2
            .d-flex.gap-2.h-100.align-items-end
              button.btn.btn-sm.btn-outline-primary.flex-grow-1(type="submit") Tạo
              button.btn.btn-sm.btn-outline-secondary.flex-grow-1(type="button" onclick="closeBrandForm()") Hủy

    if !brands || brands.length === 0
      .admin-empty-state
        .admin-empty-state-icon 🏷️
        .admin-empty-state-title Chưa có thương hiệu nào
        .admin-empty-state-description Hãy thêm thương hiệu đầu tiên để khách hàng dễ tìm kiếm sản phẩm
        button.btn.btn-header.btn-admin-accent(onclick="showBrandForm()")
          i.bi.bi-plus-lg
          |  Thêm thương hiệu
    else
      .admin-entity-list.brands-list
        each item in brands
          .admin-gallery-card(data-id=item._id)
            .admin-gallery-card-image(style=item.logo ? `background-image: url('${item.logo}'); background-size: contain; background-position: center; background-color: rgba(99, 102, 241, 0.08);` : 'background-color: rgba(99, 102, 241, 0.08);')
              if !item.logo
                .d-flex.align-items-center.justify-content-center.h-100
                  i.bi.bi-image(style="font-size: 48px; color: rgba(107, 114, 128, 0.4);")

            .admin-gallery-card-content
              .admin-gallery-card-title= item.ten

              .admin-gallery-card-meta
                .admin-gallery-card-stat
                  .admin-gallery-card-stat-value= item.thuTu || 0
                  .admin-gallery-card-stat-label Thứ tự
                .admin-gallery-card-stat
                  .admin-gallery-card-stat-value= item.noiBat ? '✓' : '—'
                  .admin-gallery-card-stat-label Nổi bật

              .admin-gallery-card-status(class=item.hienthi ? '' : 'inactive')
                .admin-gallery-card-status-dot
                .admin-gallery-card-status-text
                  if item.hienthi
                    | Hiển thị
                  else
                    | Ẩn

              .admin-gallery-card-actions(data-id=item._id)
                button.btn.btn-sm.btn-outline-primary(type="button" onclick="editBrand(this)")
                  i.bi.bi-pencil
                  |  Sửa
                button.btn.btn-sm.btn-outline-danger(type="button" data-action="delete" onclick="deleteBrand(this)")
                  i.bi.bi-trash
                  |  Xóa

  script.
    function showBrandForm() {
      document.getElementById('brandFormContainer').style.display = 'flex';
    }
    function closeBrandForm() {
      document.getElementById('brandFormContainer').style.display = 'none';
      document.getElementById('brandCreate').reset();
    }
    function editBrand(btn) {
      console.log('Edit brand');
    }
    function deleteBrand(btn) {
      if (confirm('Bạn chắc chắn muốn xóa thương hiệu này?')) {
        console.log('Delete brand');
      }
    }

block scripts
  script(src="/admin/js/home-brands.js?v=20260410-2")
