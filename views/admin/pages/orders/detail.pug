extends ../../layouts/default.pug

block main
  .container-fluid.p-4
    style.
      .order-items-table th,
      .order-items-table td {
        vertical-align: top;
      }
      .order-items-table td {
        padding-top: 12px;
        padding-bottom: 12px;
      }
      .fifo-stack {
        min-width: 100px;
      }
      .fifo-line {
        padding: 2px 0;
        line-height: 1.3;
      }
      .fifo-total {
        margin-top: 4px;
        padding-top: 6px;
        border-top: 1px dashed #d7ddea;
        font-weight: 700;
      }
      .order-item-name {
        font-size: 1.05rem;
        line-height: 1.35;
      }
      .item-return-badge {
        font-size: 0.72rem;
        vertical-align: middle;
      }
      .order-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }
      .header-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 46px;
        padding: 0 18px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-weight: 700;
        letter-spacing: 0.01em;
        box-shadow: 0 12px 26px rgba(23, 43, 77, 0.14);
        transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
      }
      .header-action-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 30px rgba(23, 43, 77, 0.18);
        filter: saturate(1.05);
      }
      .header-action-btn i {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.2);
      }
      .header-action-btn--receive {
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
      }
      .header-action-btn--refund {
        color: #fff;
        background: linear-gradient(135deg, #111827, #0f172a);
      }
      .header-action-btn--import {
        color: #1d4ed8;
        background: #eff6ff;
        border-color: #bfdbfe;
        box-shadow: 0 12px 26px rgba(29, 78, 216, 0.14);
      }
      .header-action-btn--import i {
        background: rgba(37, 99, 235, 0.12);
      }
      .header-status-badge {
        display: inline-flex;
        align-items: center;
        min-height: 42px;
        padding: 0 16px;
        border-radius: 999px;
        font-size: 0.92rem;
        font-weight: 700;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
      }
      .header-back-btn {
        min-height: 42px;
        padding: 0 16px;
        border-radius: 999px;
        font-weight: 600;
      }
      @media (max-width: 768px) {
        .header-action-btn,
        .header-back-btn,
        .header-status-badge {
          width: 100%;
          justify-content: center;
        }
      }

    if !order
      .d-flex.justify-content-between.align-items-center.mb-3.page-header-section.orders-header.admin-page-header
        h1.page-title.mb-0 Không tìm thấy đơn hàng
        a.btn.btn-outline-secondary(href=`${admin}/orders`) Quay lại danh sách
    else
      - const paymentMethod = String(order.phuongthucthanhtoan || '').toLowerCase()
      - const paymentMethodLabel = paymentMethod === 'momo' ? 'MoMo' : (paymentMethod === 'vnpay' ? 'Thanh toán online' : (paymentMethod === 'cod' ? 'COD' : (order.phuongthucthanhtoan || '-')))
      - const isOnlinePayment = ['momo', 'vnpay'].includes(paymentMethod)
      - const isPaidWaitingConfirm = order.trangthai === 'choxacnhan' && isOnlinePayment && order.dathanhtoan
      - const label = isPaidWaitingConfirm ? 'Đã thanh toán' : ((statusLabels && statusLabels[order.trangthai]) || order.trangthai || '-')
      - const badge = (badgeClass && typeof badgeClass === 'function') ? badgeClass(order.trangthai) : 'bg-secondary'
      - const flowList = (locals.flow && locals.flow.length) ? locals.flow : ['choxacnhan','daxacnhan','dangchuanbi','danggiao','dagiao','requested_return','approved_return','returned','refunded']
      - const currentIndex = flowList.indexOf(order.trangthai)
      - const returnedDoneStatuses = new Set(['returned', 'returned_full', 'returned_partial', 'refunded'])
      - const canMarkReturnedItems = returnedDoneStatuses.has(String(order.trangthai || '')) || Boolean(hasReturnImport)
      - const returnedQtyMap = (returnedQtyByItemId && typeof returnedQtyByItemId === 'object') ? returnedQtyByItemId : {}
      - const refundFinance = refundFinancialSummary || {}
      - const rfOriginal = refundFinance.original || {}
      - const rfRefund = refundFinance.refund || {}
      - const rfRemain = refundFinance.remaining || {}
      - const rfRefundItems = Array.isArray(rfRefund.items) ? rfRefund.items : []
      - const rfRefundByVariant = {}
      each rr in rfRefundItems
        - const rrKey = `${String(rr.name || '').trim()}|${String(rr.color || '').trim()}|${String(rr.size || '').trim()}`
        - rfRefundByVariant[rrKey] = Number(rr.amount || 0)
      - const canRefundNow = ['returned', 'returned_full', 'returned_partial'].includes(String(order.trangthai || '')) && (Number(returnActualTotalQty || 0) > 0 || Number(returnActualTotalAmount || 0) > 0)
      - const requestedQtyMap = (refundFinance.requestedQtyByItemId && typeof refundFinance.requestedQtyByItemId === 'object') ? refundFinance.requestedQtyByItemId : {}
      - const chatUserId = order && order.nguoidung_id ? String(order.nguoidung_id) : ''

      .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3.page-header-section.orders-header.admin-page-header
        div
          h1.page-title.mb-1 Chi tiết đơn hàng
          .text-muted.small #{order.madonhang || order._id}
        .order-header-actions
          if ['approved_return', 'return_shipping'].includes(String(order.trangthai || ''))
            a.btn.header-action-btn.header-action-btn--receive(href='#return-workflow')
              i.bi.bi-box-arrow-in-down.me-1
              | Nhận hàng hoàn
          else if ['returned', 'returned_full', 'returned_partial'].includes(String(order.trangthai || ''))
            a.btn.header-action-btn.header-action-btn--refund(href='#return-workflow')
              i.bi.bi-cash-coin.me-1
              | Hoàn tiền
          else if String(order.trangthai || '') === 'refunded' && !hasConfirmedReturnImport
            a.btn.header-action-btn.header-action-btn--import(href='#return-workflow')
              i.bi.bi-box-seam.me-1
              | Tạo phiếu nhập
          span.badge.header-status-badge(class=badge) #{label}
          a.btn.btn-sm.btn-outline-secondary.header-back-btn(href=`${admin}/orders`) Quay lại

      .row.g-3
        .col-lg-7
          .card.border-0.shadow-sm
            .card-body
              .d-flex.justify-content-between.align-items-center.gap-2.mb-2
                .fw-semibold.mb-0 Thông tin khách hàng
                if chatUserId
                  a.btn.btn-sm.btn-outline-primary(href=`${admin}/chats?userId=${chatUserId}`)
                    i.bi.bi-chat-dots.me-1
                    | Chat khách hàng
              .row.g-2
                .col-md-6
                  .text-muted.small Người nhận
                  .fw-semibold #{order.tennguoinhan || '-'}
                .col-md-6
                  .text-muted.small Số điện thoại
                  .fw-semibold #{order.sodienthoai || '-'}
                .col-md-6
                  .text-muted.small Email
                  .fw-semibold #{order.email || '-'}
                .col-12
                  .text-muted.small Địa chỉ giao hàng
                  .fw-semibold #{order.diachigiao || '-'}
              if order.ghichu
                .mt-2
                  .text-muted.small Ghi chú
                  .fw-semibold #{order.ghichu}

              hr
              .fw-semibold.mb-2 Thanh toán
              .d-flex.justify-content-between
                span.text-muted Phương thức
                span.fw-semibold #{paymentMethodLabel}
              if order.ngaytao
                .d-flex.justify-content-between
                  span.text-muted Ngày tạo
                  span.fw-semibold #{new Date(order.ngaytao).toLocaleString('vi-VN')}
              if order.ngaycapnhat
                .d-flex.justify-content-between
                  span.text-muted Cập nhật
                  span.fw-semibold #{new Date(order.ngaycapnhat).toLocaleString('vi-VN')}

          .card.border-0.shadow-sm.mt-3
            .card-body
              .fw-semibold.mb-2 Sản phẩm
              if items && items.length
                - const grandQty = (items || []).reduce((sum, row) => sum + Number(row.tongSoLuong || row.soluong || 0), 0)
                - const grandAmount = (items || []).reduce((sum, row) => {
                -   const line = Number(row.tongThanhTien || row.thanhtien || ((row.giaban || row.giagoc || 0) * (row.soluong || 1)) || 0)
                -   return sum + line
                - }, 0)
                .table-responsive
                  table.table.table-sm.order-items-table
                    thead
                      tr
                        th Ảnh
                        th Tên sản phẩm
                        th SL
                        th Giá gốc
                        th Giá giảm
                        th Thành tiền
                    tbody
                      each it in items
                        - const _line = (it.tongThanhTien || it.thanhtien || ((it.giaban || it.giagoc || 0) * (it.soluong || 1)) || 0)
                        - const skuValue = it.masku || it.ma_sku || ''
                        - const sizeColorParts = [it.kichco, it.mausac].filter(Boolean)
                        - const fifoRows = Array.isArray(it.fifoRows) ? it.fifoRows : []
                        - const itemId = String(it._id || '').trim()
                        - const rowQty = Number(it.tongSoLuong || it.soluong || 0)
                        - const rawRequestedQty = Number(requestedQtyMap[itemId] || 0)
                        - const requestedQty = Math.min(Math.max(0, rawRequestedQty), Math.max(0, rowQty))
                        - const rawReturnedQty = Number(returnedQtyMap[itemId] || 0)
                        - const returnedQty = Math.min(Math.max(0, rawReturnedQty), Math.max(0, rowQty))
                        tr
                          td
                            img.rounded.border(src=(it.hinhanh || '/images/shopping.png') alt=(it.tensanpham || 'Sản phẩm') width='56' height='56' style='object-fit:cover;')
                          td
                            .fw-semibold.order-item-name
                              | #{it.tensanpham || ''}
                              if requestedQty > 0
                                span.badge.text-bg-warning.ms-2.item-return-badge Yêu cầu hoàn #{requestedQty}/#{rowQty || 0}
                              if canMarkReturnedItems && returnedQty > 0
                                span.badge.text-bg-danger.ms-2.item-return-badge Đã hoàn #{returnedQty}/#{rowQty || 0}
                            if skuValue
                              .small.text-muted SKU: #{skuValue}
                            if sizeColorParts.length
                              .small.text-muted Size/Màu: #{sizeColorParts.join(' / ')}
                          td
                            if fifoRows.length
                              .fifo-stack
                              each r in fifoRows
                                .fifo-line #{Number(r.soLuong || 0).toLocaleString('vi-VN')} cái
                              .fifo-total Tổng: #{Number(it.tongSoLuong || 0).toLocaleString('vi-VN')} cái
                            else
                              | #{it.soluong || 1}
                          td
                            if fifoRows.length
                              .fifo-stack
                              each r in fifoRows
                                .fifo-line #{Number(r.giagoc || 0).toLocaleString('vi-VN')}₫
                            else
                              | #{(it.giagoc || 0).toLocaleString('vi-VN')}₫
                          td
                            if fifoRows.length
                              .fifo-stack
                              each r in fifoRows
                                .fifo-line #{Number(r.giaban || 0).toLocaleString('vi-VN')}₫
                            else
                              | #{(it.giaban || 0).toLocaleString('vi-VN')}₫
                          td
                            if fifoRows.length
                              .fifo-stack
                              each r in fifoRows
                                .fifo-line #{Number(r.thanhtien || 0).toLocaleString('vi-VN')}₫
                              .fifo-total #{_line.toLocaleString('vi-VN')}₫
                            else
                              | #{_line.toLocaleString('vi-VN')}₫
                    tfoot
                      tr
                        th(colspan='2') Tổng cộng
                        th #{Number(grandQty || 0).toLocaleString('vi-VN')} cái
                        th
                        th
                        th #{Number(grandAmount || 0).toLocaleString('vi-VN')}₫
              else
                .text-muted Không có sản phẩm.

          .card.border-0.shadow-sm.mt-3
            .card-body
              .fw-semibold.mb-2 Chi tiết tài chính hoàn hàng
              .border.rounded.p-2.mb-2.bg-light
                .small.fw-semibold.mb-1 1. Tổng đơn ban đầu
                .d-flex.justify-content-between.small
                  span.text-muted Tổng tiền hàng
                  span #{Number(rfOriginal.goodsSubtotal || 0).toLocaleString('vi-VN')}đ
                .d-flex.justify-content-between.small
                  span.text-muted Voucher giảm giá
                  span.text-danger -#{Number(rfOriginal.voucherDiscount || 0).toLocaleString('vi-VN')}đ
                .d-flex.justify-content-between.small
                  span.text-muted Phí vận chuyển
                  span #{Number(rfOriginal.shippingFee || 0).toLocaleString('vi-VN')}đ
                .d-flex.justify-content-between.small.fw-semibold.border-top.pt-1.mt-1
                  span Tổng thanh toán ban đầu
                  span #{Number(rfOriginal.payable || 0).toLocaleString('vi-VN')}đ

              .border.rounded.p-2.mb-2.bg-white
                .small.fw-semibold.mb-1 2. Thông tin hoàn hàng
                .d-flex.justify-content-between.small
                  span.text-muted Trạng thái
                  span #{rfRefund.statusLabel || '-'}
                .d-flex.justify-content-between.small
                  span.text-muted Kiểu đối soát
                  span #{rfRefund.mode === 'actual' ? 'Theo hàng hoàn thực tế' : (rfRefund.mode === 'requested' ? 'Theo yêu cầu khách' : 'Chưa có hoàn hàng')}
                .d-flex.justify-content-between.small
                  span.text-muted Số lượng đã hoàn
                  span #{Number(rfRefund.totalReturnedQty || 0).toLocaleString('vi-VN')} sản phẩm
                if rfRefund.items && rfRefund.items.length
                  .small.text-muted.mt-1.mb-1 Danh sách sản phẩm đã hoàn:
                  each rr in rfRefund.items
                    - const rrVariant = [rr.color, rr.size].filter(Boolean).join(' / ')
                    .small.d-flex.justify-content-between.gap-2
                      span #{rr.name}#{rrVariant ? ` (${rrVariant})` : ''} (#{rr.returnedQty}/#{rr.boughtQty})
                      span.text-danger -#{Number(rr.amount || 0).toLocaleString('vi-VN')}đ
                else
                  .small.text-muted.mt-1.mb-1 Chưa có sản phẩm hoàn.
                .d-flex.justify-content-between.small.fw-semibold.border-top.pt-1.mt-1
                  span Đã hoàn tiền
                  span.text-danger -#{Number(rfRefund.amount || 0).toLocaleString('vi-VN')}đ

              .border.rounded.p-2.bg-light
                .small.fw-semibold.mb-1 3. Giá trị đơn hàng còn lại
                .d-flex.justify-content-between.small
                  span.text-muted Sản phẩm giữ lại
                  span #{Number(rfRemain.keptQtyTotal || 0).toLocaleString('vi-VN')}
                .d-flex.justify-content-between.small
                  span.text-muted Giá trị sản phẩm giữ lại
                  span #{Number(rfRemain.goodsValue || 0).toLocaleString('vi-VN')}đ
                .d-flex.justify-content-between.small
                  span.text-muted Voucher phân bổ còn lại
                  span.text-danger -#{Number(rfRemain.voucherAllocated || 0).toLocaleString('vi-VN')}đ
                .d-flex.justify-content-between.small
                  span.text-muted Giá trị còn lại sau hoàn
                  span #{Number(rfRemain.goodsAfterVoucher || 0).toLocaleString('vi-VN')}đ
                if rfRemain.items && rfRemain.items.length
                  .small.text-muted.mt-1.mb-1 Sản phẩm giữ lại:
                  each keep in rfRemain.items
                    - const keepVariant = [keep.color, keep.size].filter(Boolean).join(' / ')
                    .small.d-flex.justify-content-between.gap-2
                      span #{keep.name}#{keepVariant ? ` (${keepVariant})` : ''} (#{keep.keptQty}/#{keep.boughtQty})
                      span #{Number(keep.amount || 0).toLocaleString('vi-VN')}đ
                else
                  .small.text-muted.mt-1.mb-1 Không còn sản phẩm giữ lại.
                .d-flex.justify-content-between.small.fw-semibold.border-top.pt-1.mt-1
                  span Còn lại (khách thực trả cuối cùng)
                  span #{Number(rfRemain.payable || 0).toLocaleString('vi-VN')}đ

        .col-lg-5
          .card.border-0.shadow-sm.mb-3
            .card-body
              .fw-semibold.mb-2 Trạng thái & thao tác
              - const actionNext = (allowedNext || []).filter((st) => !(order.trangthai === 'choxacnhan' && st === 'daxacnhan'))
              if order.trangthai === 'choxacnhan'
                form.mb-2(method='POST', action=`${admin}/orders/${order._id}/status`)
                  input(type='hidden' name='status' value='daxacnhan')
                  button.btn.btn-success(type='submit' onclick="return confirm('Xác nhận đơn hàng này?')")
                    i.bi.bi-check2-circle.me-1
                    | Xác nhận đơn
              if actionNext && actionNext.length
                .d-flex.flex-wrap.gap-2
                  each st in actionNext
                    form(method='POST', action=`${admin}/orders/${order._id}/status`)
                      input(type='hidden' name='status' value=st)
                      button.btn.btn-outline-primary(type='submit' onclick="return confirm('Xác nhận cập nhật trạng thái?')") #{(statusLabels && statusLabels[st]) || st}
              else
                .text-muted.small Không có thao tác trạng thái tiếp theo.

              if ['choxacnhan', 'daxacnhan'].includes(order.trangthai) && !order.dathanhtoan
                hr
                form(method='POST', action=`${admin}/orders/${order._id}/cancel` onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn này?')")
                  label.form-label.small Lý do hủy
                  textarea.form-control.mb-2(name='reason' rows='2' placeholder='Nhập lý do hủy' required)
                  button.btn.btn-outline-danger(type='submit') Hủy đơn

              - const requestedItems = Array.isArray(returnRequestItems) ? returnRequestItems : []
              - const returnedItemsActual = Array.isArray(returnActualItems) ? returnActualItems : []
              - const returnedQtyActualTotal = Number(returnActualTotalQty || 0)
              - const returnedAmountActualTotal = Number((rfRefund && rfRefund.amount) || returnActualTotalAmount || 0)
              - const hasReturnWorkflow = ['requested_return', 'approved_return', 'rejected_return', 'return_shipping', 'returned', 'returned_full', 'returned_partial', 'refunded'].includes(String(order.trangthai || '')) || Boolean(order.yeucauhoanhang && (order.yeucauhoanhang.requestedAt || order.yeucauhoanhang.reviewedAt || order.yeucauhoanhang.returnedAt || order.yeucauhoanhang.refundedAt)) || requestedItems.length > 0 || returnedItemsActual.length > 0 || returnedQtyActualTotal > 0 || returnedAmountActualTotal > 0 || hasReturnImport
              if hasReturnWorkflow
                - const returnRequest = order.yeucauhoanhang || {}
                hr
                .return-card.p-3.rounded-4.mb-2#return-workflow
                  .fw-semibold.mb-2 Yêu cầu hoàn hàng
                  .small.text-muted.mb-1 Lý do: #{returnRequest.reasonLabel || returnRequest.reason || '-'}
                  if returnRequest.detail
                    .small.mb-1 Mô tả: #{returnRequest.detail}
                  if returnRequest.refundMethod
                    - const _refundMethod = String(returnRequest.refundMethod || '').toLowerCase()
                    - const _refundWallet = String(returnRequest.refundWallet || order.phuongthucthanhtoan || '').toLowerCase()
                    - const _refundLabel = _refundMethod === 'wallet' ? `Ví đã thanh toán (${_refundWallet.toUpperCase() || 'ONLINE'})` : (_refundMethod === 'bank' ? 'Chuyển khoản ngân hàng' : _refundMethod.toUpperCase())
                    .small.mb-1 Hoàn tiền: #{_refundLabel}
                    if _refundMethod === 'bank'
                      if returnRequest.refundBankName
                        .small.text-muted Tên ngân hàng: #{returnRequest.refundBankName}
                      if returnRequest.refundBankAccountName
                        .small.text-muted Tên người nhận: #{returnRequest.refundBankAccountName}
                      if returnRequest.refundBankAccountNumber
                        .small.text-muted Số tài khoản: #{returnRequest.refundBankAccountNumber}
                .border.rounded.p-2.mb-2.bg-white
                  .small.fw-semibold.mb-1 Chi tiết khách muốn hoàn
                  if returnRequestItemsMissing
                    .small.text-warning.mb-1
                      | Yêu cầu này chưa có dữ liệu chi tiết sản phẩm hoàn (bản ghi cũ hoặc lưu thiếu dữ liệu).
                  if requestedItems.length
                    .small.text-muted
                      each row in requestedItems
                        - const lineDesc = [row.mausac, row.kichco].filter(Boolean).join(' / ')
                        .d-flex.align-items-center.gap-2.py-1
                          img.rounded.border(src=(row.hinhanh || '/images/shopping.png') alt=(row.tensanpham || 'Sản phẩm') width='34' height='34' style='object-fit:cover;')
                          div - #{row.tensanpham || 'Sản phẩm'}#{lineDesc ? ` (${lineDesc})` : ''}: #{row.qty || 0}/#{row.boughtQty || 0}
                  else
                    .small.text-muted Chưa có dữ liệu chi tiết sản phẩm hoàn từ yêu cầu này.

                .border.rounded.p-2.mb-2.bg-white
                  .small.fw-semibold.mb-1 Chi tiết đã hoàn thực tế
                  if returnActualDetailsMissing
                    .small.text-warning.mb-2
                      | Đã có hoàn trả nhưng chưa đủ dữ liệu chi tiết theo từng sản phẩm từ phiếu xuất.
                  if returnedItemsActual.length
                    .table-responsive
                      table.table.table-sm.align-middle.mb-2
                        thead
                          tr
                            th Sản phẩm
                            th.text-nowrap Số lượng hoàn
                            th.text-nowrap Đơn giá hoàn
                            th.text-nowrap Thành tiền hoàn
                        tbody
                          each row in returnedItemsActual
                            - const returnRowDesc = [row.mausac, row.kichco].filter(Boolean).join(' / ')
                            - const priceRows = Array.isArray(row.priceBreakdown) ? row.priceBreakdown : []
                            - const refundVariantKey = `${String(row.tensanpham || '').trim()}|${String(row.mausac || '').trim()}|${String(row.kichco || '').trim()}`
                            - const displayRefundAmount = Number((rfRefundByVariant && rfRefundByVariant[refundVariantKey]) || row.refundAmount || 0)
                            - const displayUnitRefundPrice = Number(row.returnedQty || 0) > 0 ? Math.round(displayRefundAmount / Number(row.returnedQty || 1)) : 0
                            tr
                              td
                                .d-flex.align-items-center.gap-2
                                  img.rounded.border(src=(row.hinhanh || '/images/shopping.png') alt=(row.tensanpham || 'Sản phẩm') width='34' height='34' style='object-fit:cover;')
                                  div
                                    .fw-semibold #{row.tensanpham || 'Sản phẩm'}
                                    if returnRowDesc
                                      .small.text-muted #{returnRowDesc}
                              td.text-nowrap #{Number(row.returnedQty || 0).toLocaleString('vi-VN')} cái
                              td.text-nowrap
                                if displayUnitRefundPrice > 0
                                  | #{Number(displayUnitRefundPrice || 0).toLocaleString('vi-VN')}₫
                                else if priceRows.length > 1
                                  each p in priceRows
                                    div #{Number(p.qty || 0).toLocaleString('vi-VN')} x #{Number(p.unitPrice || 0).toLocaleString('vi-VN')}₫
                                else if priceRows.length === 1
                                  | #{Number(priceRows[0].unitPrice || 0).toLocaleString('vi-VN')}₫
                                else
                                  | -
                              td.text-nowrap
                                if priceRows.length > 1
                                  each p in priceRows
                                    div #{Number(p.amount || 0).toLocaleString('vi-VN')}₫
                                  .fw-semibold.mt-1 #{Number(displayRefundAmount || 0).toLocaleString('vi-VN')}₫
                                else
                                  | #{Number(displayRefundAmount || 0).toLocaleString('vi-VN')}₫
                    .small.fw-semibold
                      | Tổng hoàn thực tế: #{returnedQtyActualTotal.toLocaleString('vi-VN')} cái - #{returnedAmountActualTotal.toLocaleString('vi-VN')}₫
                  else if returnedQtyActualTotal > 0 || returnedAmountActualTotal > 0
                    .small.text-muted
                      | Tổng hoàn thực tế: #{returnedQtyActualTotal.toLocaleString('vi-VN')} cái - #{returnedAmountActualTotal.toLocaleString('vi-VN')}₫
                  else
                    .small.text-muted Chưa có sản phẩm hoàn thực tế.

                - const returnProofMedias = (returnRequest.proofMedias && returnRequest.proofMedias.length ? returnRequest.proofMedias : [returnRequest.proofMedia || returnRequest.proofImage]).filter(Boolean)
                if returnProofMedias.length
                  .return-media-grid.mb-2
                    each media, idx in returnProofMedias
                      - const isVideo = /\.(mp4|webm|ogg|mov)(\?.*)?$/i.test(media)
                      a.return-media-item(href=media target='_blank' rel='noopener noreferrer' title=`Mở minh chứng ${idx + 1}`)
                        if isVideo
                          video(src=media muted controls preload='metadata')
                        else
                          img(src=media alt=`Minh chứng ${idx + 1}` loading='lazy')
                        span.badge.rounded-pill.text-bg-dark Minh chứng #{idx + 1}

                if order.trangthai === 'requested_return'
                  form.mb-2(method='POST', action=`${admin}/orders/${order._id}/return/approve`)
                    textarea.form-control.form-control-sm.mb-2(name='note' rows='2' placeholder='Ghi chú cho khách (không bắt buộc)')
                    button.btn.btn-sm.btn-success(type='submit' onclick="return confirm('Duyệt yêu cầu hoàn hàng?')") Duyệt hoàn hàng

                  form(method='POST', action=`${admin}/orders/${order._id}/return/reject`)
                    textarea.form-control.form-control-sm.mb-2(name='note' rows='2' placeholder='Lý do từ chối' required)
                    button.btn.btn-sm.btn-outline-danger(type='submit' onclick="return confirm('Từ chối yêu cầu hoàn hàng?')") Từ chối

                if ['approved_return', 'return_shipping'].includes(order.trangthai)
                  form.mb-2(method='POST', action=`${admin}/orders/${order._id}/return/received`)
                    .small.text-muted.mb-2 Nhập số lượng thực nhận cho từng dòng. Sau bước này hệ thống sẽ cập nhật phiếu xuất, chưa nhập lại kho.
                    - const requestedItemsForReceive = Array.isArray(returnRequestItems) ? returnRequestItems : []
                    - const receiveItems = (requestedItemsForReceive.length ? (items || []).filter((it) => requestedItemsForReceive.some((row) => String(row.orderItemId) === String(it._id))) : (items || []))
                    if returnRequestItemsMissing
                      .alert.alert-warning.py-2.mb-2.small Thiếu dữ liệu chi tiết sản phẩm hoàn từ yêu cầu cũ. Bạn vẫn có thể nhập tay số lượng thực nhận theo từng sản phẩm của đơn.
                    if receiveItems && receiveItems.length
                      .border.rounded.p-2.mb-2(style='max-height: 280px; overflow:auto;')
                        each it, idx in receiveItems
                          - const reqRow = requestedItemsForReceive.find((row) => String(row.orderItemId) === String(it._id))
                          - const maxQty = reqRow ? Number(reqRow.qty || 0) : Number(it.soluong || 0)
                          - const defaultQty = Math.min(maxQty, Math.max(0, maxQty))
                          .d-flex.justify-content-between.align-items-center.gap-2.py-1
                            .flex-grow-1
                              .fw-semibold #{it.tensanpham || 'Sản phẩm'}
                              .small.text-muted #{[it.kichco, it.mausac].filter(Boolean).join(' / ') || 'Mặc định'} | Đã mua: #{it.soluong || 0} | Tối đa nhận: #{maxQty}
                            input(type='hidden' name=`returnItems[${idx}][orderItemId]` value=String(it._id || ''))
                            input.form-control.form-control-sm(type='number' name=`returnItems[${idx}][qty]` value=defaultQty min='0' max=String(maxQty) step='1' style='width:96px')
                    else
                      .small.text-muted.mb-2 Không có sản phẩm nào để xác nhận nhận hàng hoàn.
                    if receiveItems && receiveItems.length
                      button.btn.btn-sm.btn-primary(type='submit' onclick="return confirm('Xác nhận đã nhận hàng hoàn cho đơn này? Hệ thống sẽ cập nhật phiếu xuất ngay sau bước này.')")
                        | Xác nhận đã nhận hàng hoàn
                    else
                      button.btn.btn-sm.btn-secondary(type='button' disabled) Không có sản phẩm để xác nhận

                if ['returned', 'returned_full', 'returned_partial'].includes(order.trangthai) && canRefundNow
                  .small.text-muted.mb-2 Đã nhận hàng hoàn thực tế. Hoàn tiền xong mới tạo phiếu nhập hoàn trả.
                  form(method='POST', action=`${admin}/orders/${order._id}/return/refund`)
                    button.btn.btn-sm.btn-dark(type='submit' onclick="return confirm('Xác nhận hoàn tiền đơn hàng này? Sau khi hoàn tiền, bạn mới có thể tạo phiếu nhập hoàn trả.')") Hoàn tiền

                if ['returned', 'returned_full', 'returned_partial'].includes(order.trangthai) && !canRefundNow
                  button.btn.btn-sm.btn-secondary(type='button' disabled title='Cần xác nhận đã nhận hàng hoàn thực tế trước khi hoàn tiền') Hoàn tiền

                if order.trangthai === 'refunded'
                  .small.text-muted.mb-2 Đơn đã hoàn tiền. Bây giờ bạn có thể tạo phiếu nhập hoàn trả để kho xác nhận nhập lại hàng.
                  if hasConfirmedReturnImport
                    button.btn.btn-sm.btn-success(type='button' disabled) Đã xác nhận nhập kho hàng hoàn
                  else if returnImportReceipt
                    a.btn.btn-sm.btn-outline-primary(href=`${admin}/imports/${returnImportReceipt._id}`) Xem phiếu nhập hoàn trả
                  else
                    form.mt-2(method='POST', action=`${admin}/orders/${order._id}/return/received`)
                      button.btn.btn-sm.btn-outline-primary(type='submit' onclick="return confirm('Tạo phiếu nhập hoàn trả cho đơn đã hoàn tiền này?')")
                        | Tạo phiếu nhập hoàn trả

              hr
              .fw-semibold.mb-2 Timeline trạng thái
              ul.list-group.list-group-flush
                each st, idx in flowList
                  - const isDone = currentIndex >= 0 && idx <= currentIndex
                  li.list-group-item.d-flex.justify-content-between.align-items-center
                    span #{(statusLabels && statusLabels[st]) || st}
                    if isDone
                      span.badge.bg-success Hoàn tất
                    else
                      span.badge.bg-light.text-dark Chưa tới
                if order.trangthai === 'dahuy'
                  li.list-group-item.d-flex.justify-content-between.align-items-center
                    span #{(statusLabels && statusLabels.dahuy) || 'Đã hủy'}
                    span.badge.bg-danger Đã hủy
                  if order.lydohuy
                    li.list-group-item.text-muted.small Lý do: #{order.lydohuy}


