extends ../../layouts/default.pug

block main
  .container-fluid.p-4.order-detail-page
    if !order
      h1.mb-3 Không tìm thấy đơn hàng
      a.btn.btn-outline-secondary(href=`${admin}/orders`) Quay lại danh sách
    else
      - const label = (statusLabels && statusLabels[order.trangthai]) || order.trangthai || '—'
      - const badge = (badgeClass && typeof badgeClass === 'function') ? badgeClass(order.trangthai) : 'bg-secondary'
      - const flowList = (locals.flow && locals.flow.length) ? locals.flow : ['choxacnhan','daxacnhan','dangchuanbi','danggiao','dagiao']
      - const currentIndex = flowList.indexOf(order.trangthai)

      .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3
        div
          h1.mb-1 Chi tiết đơn hàng
          .text-muted.small #{order.madonhang || order._id}
        .d-flex.align-items-center.gap-2
          span.badge(class=badge) #{label}
          a.btn.btn-sm.btn-outline-secondary(href=`${admin}/orders`) Quay lại

      .row.g-3
        .col-lg-7
          .card.border-0.shadow-sm
            .card-body
              .fw-semibold.mb-2 Thông tin khách hàng
              .row.g-2
                .col-md-6
                  .text-muted.small Người nhận
                  .fw-semibold #{order.tennguoinhan || '—'}
                .col-md-6
                  .text-muted.small Số điện thoại
                  .fw-semibold #{order.sodienthoai || '—'}
                .col-md-6
                  .text-muted.small Email
                  .fw-semibold #{order.email || '—'}
                .col-12
                  .text-muted.small Địa chỉ giao hàng
                  .fw-semibold #{order.diachigiao || '—'}
              if order.ghichu
                .mt-2
                  .text-muted.small Ghi chú
                  .fw-semibold #{order.ghichu}

              hr
              .fw-semibold.mb-2 Thanh toán
              .d-flex.justify-content-between
                span.text-muted Phương thức
                span.fw-semibold #{order.phuongthucthanhtoan || '—'}
              if order.ngaytao
                .d-flex.justify-content-between
                  span.text-muted Ngày tạo
                  span.fw-semibold #{new Date(order.ngaytao).toLocaleString('vi-VN')}
              if order.ngaycapnhat
                .d-flex.justify-content-between
                  span.text-muted Cập nhật
                  span.fw-semibold #{new Date(order.ngaycapnhat).toLocaleString('vi-VN')}

          .card.border-0.shadow-sm.mt-3
            .card-body
              .fw-semibold.mb-2 Sản phẩm
              if items && items.length
                .table-responsive
                  table.table.align-middle.order-items-table
                    thead
                      tr
                        th Ảnh
                        th Tên sản phẩm
                        th SL
                        th Giá gốc
                        th Giá giảm
                        th Thành tiền
                    tbody
                      each it in items
                        - const _line = (it.thanhtien || ((it.giaban || it.giagoc || 0) * (it.soluong || 1)) || 0)
                        - const skuValue = it.masku || it.ma_sku || ''
                        - const sizeColorParts = [it.kichco, it.mausac].filter(Boolean)
                        - const fifoRows = Array.isArray(it.fifoAllocations) ? it.fifoAllocations.filter((a) => Number(a && a.soLuong) > 0) : []
                        - const fifoDisplayRows = fifoRows.map((a) => {
                        -   const qty = Math.max(0, Number(a.soLuong || 0));
                        -   const giaGoc = Math.max(0, Number(a.giaBanDeXuat || a.giaban || a.giasaugiam || it.giagoc || 0));
                        -   const giaGiam = Math.max(0, Number(a.giasaugiam || a.giaban || a.giaBanDeXuat || it.giaban || it.giagoc || 0));
                        -   const thanhTien = Math.round(qty * giaGiam);
                        -   return { qty, giaGoc, giaGiam, thanhTien };
                        - })
                        - const fifoTotalQty = fifoDisplayRows.reduce((sum, r) => sum + Number(r.qty || 0), 0)
                        tr
                          td
                            img.rounded.border.order-item-thumb(src=(it.hinhanh || '/images/shopping.png') alt=(it.tensanpham || 'Sản phẩm') width='56' height='56' style='object-fit:cover;')
                          td
                            .fw-semibold.order-item-name #{it.tensanpham || ''}
                            if skuValue
                              .small.text-muted.order-item-meta SKU: #{skuValue}
                            if sizeColorParts.length
                              .small.text-muted.order-item-meta Size/Màu: #{sizeColorParts.join(' / ')}
                          td
                            if fifoDisplayRows.length
                              ul.small.mb-1.order-split-list
                                each r in fifoDisplayRows
                                  li #{Number(r.qty || 0).toLocaleString('vi-VN', { maximumFractionDigits: 0 })} cái
                              .small.fw-semibold.order-split-total Tổng: #{fifoTotalQty.toLocaleString('vi-VN', { maximumFractionDigits: 0 })} cái
                            else
                              | #{it.soluong || 1}
                          td
                            if fifoDisplayRows.length
                              ul.small.mb-0.order-split-list
                                each r in fifoDisplayRows
                                  li #{Number(r.giaGoc || 0).toLocaleString('vi-VN', { maximumFractionDigits: 0 })}₫
                            else
                              | #{Number(it.giagoc || 0).toLocaleString('vi-VN', { maximumFractionDigits: 0 })}₫
                          td
                            if fifoDisplayRows.length
                              ul.small.mb-0.order-split-list
                                each r in fifoDisplayRows
                                  li #{Number(r.giaGiam || 0).toLocaleString('vi-VN', { maximumFractionDigits: 0 })}₫
                            else
                              | #{Number(it.giaban || 0).toLocaleString('vi-VN', { maximumFractionDigits: 0 })}₫
                          td
                            if fifoDisplayRows.length
                              ul.small.mb-1.order-split-list
                                each r in fifoDisplayRows
                                  li #{Number(r.thanhTien || 0).toLocaleString('vi-VN', { maximumFractionDigits: 0 })}₫
                            else
                              | #{Number(_line || 0).toLocaleString('vi-VN', { maximumFractionDigits: 0 })}₫
                    - const grandTotalDisplay = Number(order.tongtien || order.tamtinh || 0)
                    tfoot
                      tr
                        td(colspan='5').text-end.fw-semibold Tổng tất cả
                        td.fw-bold #{grandTotalDisplay.toLocaleString('vi-VN', { maximumFractionDigits: 0 })}₫
              else
                .text-muted Không có sản phẩm.

        .col-lg-5
          .card.border-0.shadow-sm.mb-3
            .card-body
              .fw-semibold.mb-2 Trạng thái & thao tác
              if order.trangthai === 'choxacnhan'
                form.mb-2(method='POST', action=`${admin}/orders/${order._id}/status`)
                  input(type='hidden' name='status' value='daxacnhan')
                  button.btn.btn-success(type='submit' onclick="return confirm('Xác nhận đơn hàng này?')")
                    i.bi.bi-check2-circle.me-1
                    | Xác nhận đơn
              if allowedNext && allowedNext.length
                form(method='POST', action=`${admin}/orders/${order._id}/status`)
                  select.form-select.mb-2(name='status' required)
                    option(value='' selected) -- Chọn trạng thái --
                    each st in allowedNext
                      option(value=st) #{(statusLabels && statusLabels[st]) || st}
                  button.btn.btn-primary(type='submit' onclick="return confirm('Xác nhận cập nhật trạng thái?')") Cập nhật trạng thái
              else
                .text-muted.small Không có thao tác trạng thái tiếp theo.

              if ['choxacnhan', 'daxacnhan'].includes(order.trangthai) && !order.dathanhtoan
                hr
                form(method='POST', action=`${admin}/orders/${order._id}/cancel` onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn này?')")
                  label.form-label.small Lý do hủy
                  textarea.form-control.mb-2(name='reason' rows='2' placeholder='Nhập lý do hủy' required)
                  button.btn.btn-outline-danger(type='submit') Hủy đơn

              if order.yeucauhoanhang && order.yeucauhoanhang.requestedAt
                hr
                .return-card.p-3.rounded-4.mb-2
                  .fw-semibold.mb-2 Yêu cầu hoàn hàng
                  .small.text-muted.mb-1 Lý do: #{order.yeucauhoanhang.reasonLabel || order.yeucauhoanhang.reason || '—'}
                  if order.yeucauhoanhang.detail
                    .small.mb-1 Mô tả: #{order.yeucauhoanhang.detail}
                  if order.yeucauhoanhang.refundMethod
                    .small.mb-2 Hoàn tiền: #{order.yeucauhoanhang.refundMethod}
                - const returnProofMedias = (order.yeucauhoanhang.proofMedias && order.yeucauhoanhang.proofMedias.length ? order.yeucauhoanhang.proofMedias : [order.yeucauhoanhang.proofMedia || order.yeucauhoanhang.proofImage]).filter(Boolean)
                if returnProofMedias.length
                  .return-media-grid.mb-2
                    each media, idx in returnProofMedias
                      - const isVideo = /\.(mp4|webm|ogg|mov)(\?.*)?$/i.test(media)
                      a.return-media-item(href=media target='_blank' rel='noopener noreferrer' title=`Mở minh chứng ${idx + 1}`)
                        if isVideo
                          video(src=media muted controls preload='metadata')
                        else
                          img(src=media alt=`Minh chứng ${idx + 1}` loading='lazy')
                        span.badge.rounded-pill.text-bg-dark Minh chứng #{idx + 1}

                if order.trangthai === 'requested_return'
                  form.mb-2(method='POST', action=`${admin}/orders/${order._id}/return/approve`)
                    textarea.form-control.form-control-sm.mb-2(name='note' rows='2' placeholder='Ghi chú cho khách (không bắt buộc)')
                    button.btn.btn-sm.btn-success(type='submit' onclick="return confirm('Duyệt yêu cầu hoàn hàng?')") Duyệt hoàn hàng

                  form(method='POST', action=`${admin}/orders/${order._id}/return/reject`)
                    textarea.form-control.form-control-sm.mb-2(name='note' rows='2' placeholder='Lý do từ chối' required)
                    button.btn.btn-sm.btn-outline-danger(type='submit' onclick="return confirm('Từ chối yêu cầu hoàn hàng?')") Từ chối

                if ['approved_return', 'return_shipping'].includes(order.trangthai)
                  form.mb-2(method='POST', action=`${admin}/orders/${order._id}/return/received`)
                    button.btn.btn-sm.btn-primary(type='submit' onclick="return confirm('Xác nhận đã nhận hàng hoàn?')") Đã nhận hàng hoàn

                if order.trangthai === 'returned'
                  form(method='POST', action=`${admin}/orders/${order._id}/return/refund`)
                    button.btn.btn-sm.btn-dark(type='submit' onclick="return confirm('Xác nhận hoàn tiền đơn hàng này?')") Hoàn tiền

              hr
              .fw-semibold.mb-2 Timeline trạng thái
              ul.list-group.list-group-flush
                each st, idx in flowList
                  - const isDone = currentIndex >= 0 && idx <= currentIndex
                  li.list-group-item.d-flex.justify-content-between.align-items-center
                    span #{(statusLabels && statusLabels[st]) || st}
                    if isDone
                      span.badge.bg-success Hoàn tất
                    else
                      span.badge.bg-light.text-dark Chưa tới
                if order.trangthai === 'dahuy'
                  li.list-group-item.d-flex.justify-content-between.align-items-center
                    span #{(statusLabels && statusLabels.dahuy) || 'Đã hủy'}
                    span.badge.bg-danger Đã hủy
                  if order.lydohuy
                    li.list-group-item.text-muted.small Lý do: #{order.lydohuy}

          .card.border-0.shadow-sm
            .card-body
              .fw-semibold.mb-2 Tính tiền
              .d-flex.justify-content-between
                span.text-muted Tổng tiền hàng
                span.fw-semibold #{(order.tamtinh || 0).toLocaleString('vi-VN')}₫
              .d-flex.justify-content-between
                span.text-muted Phí ship
                span.fw-semibold #{(order.phivanchuyen || 0).toLocaleString('vi-VN')}₫
              .d-flex.justify-content-between
                span.text-muted Giảm giá
                span.fw-semibold #{(order.giamgia || 0).toLocaleString('vi-VN')}₫
              hr
              .d-flex.justify-content-between.fw-semibold
                span Tổng thanh toán
                span #{(order.tongtien || order.tamtinh || 0).toLocaleString('vi-VN')}₫

