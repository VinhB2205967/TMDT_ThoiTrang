extends ../../layouts/default.pug

block styles
  style.
    .category-tree .category-tree-item {
      padding: 12px 14px;
    }
    .category-tree .category-tree-row {
      gap: 10px;
    }
    .category-tree .category-tree-label {
      min-width: 0;
      flex: 1;
    }
    .category-tree .category-tree-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: flex-end;
      align-items: center;
    }
    .category-tree .category-action-form {
      margin: 0;
    }
    .category-tree .category-tree-actions .btn {
      min-width: 68px;
      border-radius: 999px;
      padding-left: 12px;
      padding-right: 12px;
      font-weight: 500;
      line-height: 1.2;
    }
    .category-tree .category-edit-box {
      background: var(--bs-light);
      border: 1px dashed var(--bs-border-color);
      border-radius: 10px;
      padding: 10px;
    }
    @media (max-width: 992px) {
      .category-tree .category-tree-actions {
        justify-content: flex-start;
      }
    }

mixin nodeRow(item, depth)
  - const indent = (depth || 0) * 20;
  - const isRootNode = !item.parent_id;
  - const typeMap = { category: 'Loại sản phẩm', brand: 'Thương hiệu', occasion: 'Dịp dùng', age_group: 'Nhóm tuổi' };
  - const typeText = typeMap[item.type] || item.type;
  li.list-group-item.category-tree-item
    .d-flex.flex-column.flex-lg-row.align-items-lg-center.justify-content-between.category-tree-row
      .d-flex.align-items-center.gap-2.category-tree-label(style=`padding-left:${indent}px`)
        if item.children && item.children.length
          button.btn.btn-sm.btn-outline-secondary(type='button' data-bs-toggle='collapse' data-bs-target=`#children-${item._id}` aria-expanded='false' aria-controls=`children-${item._id}`)
            i.bi.bi-chevron-down
        else
          span.text-muted
            i.bi.bi-dot
        .fw-semibold #{item.name}
        span.badge.bg-light.text-dark #{typeText}
        if !item.isActive
          span.badge.bg-secondary Ẩn
      .category-tree-actions
        if !isRootNode
          form.category-action-form(method='POST' action=`${admin}/categories/${item._id}/toggle`)
            input(type='hidden' name='_csrf' value=csrfToken)
            button.btn.btn-sm(type='submit' class=item.isActive ? 'btn-outline-warning' : 'btn-outline-success') #{item.isActive ? 'Ẩn' : 'Hiện'}
          button.btn.btn-sm.btn-outline-primary(type='button' data-bs-toggle='collapse' data-bs-target=`#edit-${item._id}`) Sửa
        if !(item.children && item.children.length)
          form.category-action-form(method='POST' action=`${admin}/categories/${item._id}/delete` onsubmit='return confirm("Xóa danh mục này?")')
            input(type='hidden' name='_csrf' value=csrfToken)
            button.btn.btn-sm.btn-outline-danger(type='submit') Xóa
    if !isRootNode
      .collapse.mt-2.category-edit-box(id=`edit-${item._id}`)
        form.row.g-2(method='POST' action=`${admin}/categories/${item._id}/edit`)
          input(type='hidden' name='_csrf' value=csrfToken)
          .col-md-3
            input.form-control.form-control-sm(type='text' name='name' required value=item.name)
          .col-md-2
            select.form-select.form-select-sm(name='type')
              option(value='category' selected=item.type === 'category') Loại sản phẩm
              option(value='occasion' selected=item.type === 'occasion') Dịp sử dụng
              option(value='age_group' selected=item.type === 'age_group') Nhóm tuổi
              option(value='brand' selected=item.type === 'brand') Thương hiệu
          .col-md-2
            input.form-control.form-control-sm(type='number' name='order' value=item.order min='0')
          .col-md-1
            .form-check.form-switch.pt-2
              input.form-check-input(type='checkbox' name='isActive' value='true' checked=item.isActive)
          .col-12
            button.btn.btn-sm.btn-primary(type='submit') Lưu
    if item.children && item.children.length
      ul.list-group.list-group-flush.collapse(id=`children-${item._id}`)
        each child in item.children
          +nodeRow(child, (depth || 0) + 1)

block main
  .page-header-section.orders-header
    h1.page-title.mb-0 Quản lý danh mục

  .container-fluid.py-4
    .row.g-3
      .col-lg-4
        .card
          .card-header Thêm danh mục
          .card-body
            form#categoryCreateForm(method='POST' action=`${admin}/categories/create` data-enhanced='true')
              input(type='hidden' name='_csrf' value=csrfToken)
              .mb-2
                label.form-label Tên
                input.form-control(type='text' name='name' required)
              .mb-2
                label.form-label Loại
                select.form-select(name='type')
                  option(value='category' selected) Loại sản phẩm
                  option(value='occasion') Dịp sử dụng
                  option(value='age_group') Nhóm tuổi
                  option(value='brand') Thương hiệu
              .mb-3
                .form-check.form-switch
                  input.form-check-input(type='checkbox' name='isActive' value='true' checked)
                  label.form-check-label Hiển thị
              button.btn.btn-primary.w-100(type='submit') Tạo danh mục
      .col-lg-8
        .card
          .card-header.d-flex.justify-content-between.align-items-center
            span Cây danh mục
            a#categoryTreeRefresh.btn.btn-sm.btn-outline-secondary(href=`${admin}/categories`) Làm mới
          .card-body#categoryTreeRoot
            if tree && tree.length
              ul.list-group.list-group-flush.category-tree
                each item in tree
                  +nodeRow(item, 0)
            else
              .text-muted Chưa có danh mục.

block scripts
  script.
    window.AdminCategoriesRuntime = {
      adminPath: !{JSON.stringify(admin || '/admin')},
      treeUrl: !{JSON.stringify(`${admin || '/admin'}/categories/tree?active=0`)}
    };
  script(src="/admin/js/categories.js")
