extends ../../layouts/default.pug

block main
  .container-fluid.p-3
    .d-flex.justify-content-between.align-items-center.mb-3.page-header-section.orders-header.admin-page-header
      h3.mb-0 Voucher
      a.btn.btn-header.btn-admin-accent.btn-create-voucher(href=`${admin}/vouchers/create`)
        i.bi.bi-plus-lg
        |  Tạo voucher

    form.mb-3(method='GET' action=`${admin}/vouchers`)
      .input-group
        input.form-control(type='text' name='keyword' placeholder='Tìm theo mã hoặc tên voucher' value=keyword)
        button.btn.btn-outline-secondary(type='submit') Tìm kiếm

    if !vouchers || vouchers.length === 0
      .alert.alert-info.mb-0 Chưa có voucher nào.
    else
      - const now = new Date()
      .table-responsive
        table.table.table-hover.table-bordered.align-middle
          thead.table-light
            tr
              th Banner
              th Mã
              th Tên
              th Loại
              th Giá trị
              th Tối thiểu
              th Tối đa
              th Đã dùng / Tổng
              th Tiến độ
              th Hiệu lực
              th Trạng thái
              th Hành động
          tbody
            each v in vouchers
              - const loaiLabel = v.loai === 'phantram' ? '%' : 'Cố định'
              - const valLabel = v.loai === 'phantram' ? `${v.giatri || 0}%` : `${(v.giatri || 0).toLocaleString('vi-VN')}₫`
              - const minLabel = (v.don_toithieu || 0).toLocaleString('vi-VN') + '₫'
              - const maxLabel = v.giam_toida ? (v.giam_toida || 0).toLocaleString('vi-VN') + '₫' : '—'
              - const total = v.soluong_toida || 0
              - const used = v.soluong_dasudung || 0
              - const percent = total > 0 ? Math.min(100, Math.round((used / total) * 100)) : 0
              - const endOfDay = v.ngay_ketthuc ? new Date(v.ngay_ketthuc) : null
              - if (endOfDay) endOfDay.setHours(23, 59, 59, 999)
              - const expired = endOfDay ? now > endOfDay : false
              - const soldOut = total > 0 && used >= total
              tr
                td
                  if v.banner
                    img(src=v.banner alt=v.ten width='72' height='46' style='object-fit:cover;border-radius:6px;')
                  else
                    span.text-muted —
                td #{v.code}
                td #{v.ten || '—'}
                td #{loaiLabel}
                td #{valLabel}
                td #{minLabel}
                td #{maxLabel}
                td #{used} / #{total}
                td
                  .progress(style='height:8px')
                    .progress-bar.bg-info(role='progressbar' style=`width:${percent}%` aria-valuenow=percent aria-valuemin='0' aria-valuemax='100')
                td #{v.ngay_ketthuc ? new Date(v.ngay_ketthuc).toLocaleDateString('vi-VN') : '—'}
                td
                  if v.trangthai !== 'active'
                    span.badge.bg-secondary Tạm khóa
                  else if soldOut
                    span.badge.bg-warning.text-dark Hết lượt
                  else if expired
                    span.badge.bg-danger Hết hạn
                  else
                    span.badge.bg-success Đang hoạt động
                td
                  .d-flex.flex-wrap.gap-2
                    a.btn.btn-sm.btn-outline-primary(href=`${admin}/vouchers/${v._id}/edit`) Sửa
                    form(method='POST' action=`${admin}/vouchers/${v._id}/toggle`)
                      input(type='hidden' name='_csrf' value=csrfToken)
                      if v.trangthai === 'active'
                        button.btn.btn-sm.btn-outline-danger(type='submit') Tạm khóa
                      else
                        button.btn.btn-sm.btn-outline-success(type='submit') Kích hoạt

      if totalPages > 1
        nav.mt-3
          ul.pagination.mb-0
            - const safeKeyword = encodeURIComponent(keyword || '')
            - const buildLink = (p) => `${admin}/vouchers?page=${p}${safeKeyword ? `&keyword=${safeKeyword}` : ''}`
            li.page-item(class=page <= 1 ? 'disabled' : '')
              a.page-link(href=buildLink(Math.max(1, page - 1))) Trước
            - for (let p = 1; p <= totalPages; p++) {
              li.page-item(class=p === page ? 'active' : '')
                a.page-link(href=buildLink(p)) #{p}
            - }
            li.page-item(class=page >= totalPages ? 'disabled' : '')
              a.page-link(href=buildLink(Math.min(totalPages, page + 1))) Sau
