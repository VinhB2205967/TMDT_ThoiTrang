extends ../../layouts/default.pug

block main
  .container-fluid.p-3
    .d-flex.justify-content-between.align-items-center.mb-3
      h3.mb-0 Chỉnh sửa bảng hướng dẫn size
      a.btn.btn-outline-secondary(href=`${admin}/size-guides`)
        i.bi.bi-arrow-left
        |  Danh sách

    .card
      .card-body
        form(method='POST' action=`${admin}/size-guides/${guide._id}/edit`)
          input(type='hidden' name='_csrf' value=_csrf)
          .row.g-3
            .col-md-6
              label.form-label Tên bảng *
              input.form-control(type='text' name='tenbang' required value=guide.tenbang)
            .col-md-3
              label.form-label Loại sản phẩm áp dụng *
              select.form-select(name='loaisanpham' required)
                each opt in (loaiOptions || [])
                  option(value=opt.value selected=(String(guide.loaisanpham) === String(opt.value))) #{opt.label}
            .col-md-3
              label.form-label Slug
              input.form-control(type='text' name='slug' value=guide.slug)

            .col-12
              label.form-label Cột hiển thị (phân tách bằng dấu phẩy) *
              input.form-control(type='text' name='cot' required value=guide.cotText)

            .col-12
              label.form-label Dữ liệu dòng (mỗi dòng 1 size, dùng dấu |) *
              textarea.form-control(name='dong' rows='8' required)= guide.dongText

            .col-12
              label.form-label Gợi ý chọn size
              input.form-control(type='text' name='goiy' value=(guide.goiy || ''))

          .mt-3
            button.btn.btn-primary(type='submit')
              i.bi.bi-check-lg
              |  Cập nhật bảng size
