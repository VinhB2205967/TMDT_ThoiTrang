extends ../../layouts/default.pug
include ../../mixins/filter_status.pug
include ../../mixins/search.pug
include ../../mixins/page.pug

block styles
    link(rel="stylesheet" href="/admin/css/products-admin.css?v=20260616-1")

block main
    - const currentFilter = filterStatus;
    - const lowStockThresholdVal = Number(lowStockThreshold || 10);
    - const productList = products || [];
    - const stockOf = (item) => Number((item && item.tonkho !== undefined && item.tonkho !== null) ? item.tonkho : ((item && item.soluongton) || 0));
    - const activeProductsCount = productList.filter((item) => { const s = String((item && item.trangthai) || '').toLowerCase(); return s.includes('dang') || s.includes('đang') || s.includes('active'); }).length;
    - const lowStockProductsCount = productList.filter((item) => stockOf(item) > 0 && stockOf(item) <= lowStockThresholdVal).length;
    - const outStockProductsCount = productList.filter((item) => stockOf(item) <= 0).length;
    - const variantProductsCount = productList.reduce((sum, item) => sum + ((item && item.bienthe && item.bienthe.length) || 0), 0);
    - const hasAdvanced = !!(currentDeleted || currentSort || currentLoai || currentGioiTinh || currentBrand || currentOccasion || currentAgeGroup || priceMin || priceMax || dateFrom || dateTo);

    .pa-page
        //- ===== HERO HEADER =====
        header.pa-hero
            .pa-hero__main
                span.pa-hero__eyebrow
                    i.bi.bi-box-seam
                    | Danh mục sản phẩm
                h1.pa-hero__title Quản lý sản phẩm
                p.pa-hero__subtitle Theo dõi tồn kho, biến thể, giá bán và trạng thái sản phẩm trong một bảng điều khiển trực quan.
            .pa-hero__actions
                a.pa-btn.pa-btn--light(href=`${admin}/products/create`)
                    i.bi.bi-plus-lg
                    | Thêm sản phẩm

        //- ===== STAT CARDS =====
        section.pa-stats
            .pa-stat.pa-stat--total
                .pa-stat__icon: i.bi.bi-boxes
                .pa-stat__body
                    span.pa-stat__label Tổng sản phẩm
                    strong.pa-stat__value= productList.length
                    small.pa-stat__hint #{variantProductsCount} biến thể
            .pa-stat.pa-stat--active
                .pa-stat__icon: i.bi.bi-check2-circle
                .pa-stat__body
                    span.pa-stat__label Đang bán
                    strong.pa-stat__value= activeProductsCount
                    small.pa-stat__hint Hiển thị với khách
            .pa-stat.pa-stat--low
                .pa-stat__icon: i.bi.bi-exclamation-triangle
                .pa-stat__body
                    span.pa-stat__label Sắp hết hàng
                    strong.pa-stat__value= lowStockProductsCount
                    small.pa-stat__hint Tồn ≤ #{lowStockThresholdVal}
            .pa-stat.pa-stat--out
                .pa-stat__icon: i.bi.bi-slash-circle
                .pa-stat__body
                    span.pa-stat__label Hết hàng
                    strong.pa-stat__value= outStockProductsCount
                    small.pa-stat__hint Cần nhập thêm

        //- ===== FILTER TOOLBAR =====
        section.pa-toolbar
            .pa-toolbar__row
                .pa-toolbar__status
                    span.pa-toolbar__caption
                        i.bi.bi-funnel
                        | Trạng thái
                    .pa-status-group(role="group")
                        +filter_status(filterStatus)
                .pa-toolbar__search
                    +search(keyword)

            .pa-toolbar__advanced-bar
                button.pa-btn.pa-btn--ghost.pa-btn--sm(type="button" data-bs-toggle="collapse" data-bs-target="#advancedFilters" aria-expanded=hasAdvanced ? 'true' : 'false' aria-controls="advancedFilters")
                    i.bi.bi-sliders
                    | Bộ lọc nâng cao
                if hasAdvanced
                    a.pa-btn.pa-btn--ghost.pa-btn--sm(href=`${admin}/products`)
                        i.bi.bi-x-circle
                        | Xóa lọc

            #advancedFilters.collapse(class=hasAdvanced ? 'show' : '')
                form.pa-advanced(action=`${admin}/products` method="GET")
                    if keyword
                        input(type="hidden" name="keyword" value=keyword)
                    - const activeStatus = filterStatus.find(item => item.class === 'active')
                    if activeStatus && activeStatus.status
                        input(type="hidden" name="trangthai" value=activeStatus.status)

                    .pa-advanced__grid
                        .pa-field
                            label.pa-field__label Xóa mềm
                            select.pa-select(name="deleted" onchange="this.form.submit()")
                                option(value="" selected=(!currentDeleted)) Chưa xóa
                                option(value="1" selected=(currentDeleted=='1')) Đã xóa (thùng rác)
                                option(value="all" selected=(currentDeleted=='all')) Tất cả
                        .pa-field
                            label.pa-field__label Sắp xếp
                            select.pa-select(name="sort" onchange="this.form.submit()")
                                option(value="ngaytao-desc" selected=(!currentSort || currentSort=='ngaytao-desc')) Tạo mới nhất
                                option(value="ngaycapnhat-desc" selected=(currentSort=='ngaycapnhat-desc')) Cập nhật mới nhất
                                option(value="ngaycapnhat-asc" selected=(currentSort=='ngaycapnhat-asc')) Cập nhật cũ nhất
                                option(value="ngaytao-asc" selected=(currentSort=='ngaytao-asc')) Tạo cũ nhất
                                option(value="gia-desc" selected=(currentSort=='gia-desc')) Giá giảm dần
                                option(value="gia-asc" selected=(currentSort=='gia-asc')) Giá tăng dần
                                option(value="tensanpham-asc" selected=(currentSort=='tensanpham-asc')) Tên A-Z
                        .pa-field
                            label.pa-field__label Loại SP
                            select.pa-select(name="loaisanpham" onchange="this.form.submit()")
                                option(value="" selected=(!currentLoai)) Tất cả
                                each c in (categoryOptions || [])
                                    option(value=c.slug selected=(String(currentLoai || '') === String(c.slug || ''))) #{c.name}
                        .pa-field
                            label.pa-field__label Giới tính
                            select.pa-select(name="gioitinh" onchange="this.form.submit()")
                                option(value="" selected=(!currentGioiTinh)) Tất cả
                                option(value="nam" selected=(currentGioiTinh=='nam')) Nam
                                option(value="nu" selected=(currentGioiTinh=='nu')) Nữ
                                option(value="unisex" selected=(currentGioiTinh=='unisex')) Unisex
                        .pa-field
                            label.pa-field__label Thương hiệu
                            select.pa-select(name="brand" onchange="this.form.submit()")
                                option(value="" selected=(!currentBrand)) Tất cả
                                each b in (brandOptions || [])
                                    option(value=b._id selected=(String(currentBrand || '') === String(b._id))) #{b.ten}
                        .pa-field
                            label.pa-field__label Dịp sử dụng
                            select.pa-select(name="occasion" onchange="this.form.submit()")
                                option(value="" selected=(!currentOccasion)) Tất cả
                                each c in (occasionOptions || [])
                                    option(value=c._id selected=(String(currentOccasion || '') === String(c._id))) #{c.name}
                        .pa-field
                            label.pa-field__label Lứa tuổi
                            select.pa-select(name="ageGroup" onchange="this.form.submit()")
                                option(value="" selected=(!currentAgeGroup)) Tất cả
                                each c in (ageGroupOptions || [])
                                    option(value=c._id selected=(String(currentAgeGroup || '') === String(c._id))) #{c.name}
                        .pa-field
                            label.pa-field__label Khoảng giá
                            .pa-range
                                input.pa-input(type="number" name="priceMin" placeholder="Min" value=priceMin min="0")
                                span.pa-range__sep -
                                input.pa-input(type="number" name="priceMax" placeholder="Max" value=priceMax min="0")
                        .pa-field
                            label.pa-field__label Ngày cập nhật
                            .pa-range
                                input.pa-input(type="date" name="dateFrom" value=dateFrom)
                                span.pa-range__sep -
                                input.pa-input(type="date" name="dateTo" value=dateTo)

                    .pa-advanced__actions
                        a.pa-btn.pa-btn--ghost.pa-btn--sm(href=`${admin}/products`)
                            i.bi.bi-x-circle
                            | Xóa lọc
                        button.pa-btn.pa-btn--primary.pa-btn--sm(type="submit")
                            i.bi.bi-funnel
                            | Áp dụng

        //- ===== PRODUCT LIST =====
        if products && products.length
            //- Desktop table
            .pa-table-wrap.d-none.d-lg-block
                table.pa-table
                    thead
                        tr
                            th.pa-th-num STT
                            th Sản phẩm
                            th.pa-th-brand Thương hiệu
                            th.pa-th-price Giá
                            th.pa-th-stock Tồn kho
                            th.pa-th-date Cập nhật
                            th.pa-th-status Trạng thái
                            th.pa-th-actions Hành động
                    tbody
                        each product, idx in products
                            - const giaGoc = product.gia ? product.gia.toLocaleString('vi-VN') + '₫' : '—';
                            - const giamGia = product.phantramgiamgia || 0;
                            - const giaKhuyenMai = giamGia > 0 ? Math.round(product.gia * (100 - giamGia) / 100).toLocaleString('vi-VN') + '₫' : null;
                            - const status = (product.trangthai || '').toLowerCase();
                            - const isActive = status === 'dangban' || status === 'active' || status === 'đang bán';
                            - const imgSrc = product.displayImage || product.hinhanh || '/images/shopping.png';
                            - const ngayCapNhat = (product.ngaycapnhat || product.ngaytao) ? new Date(product.ngaycapnhat || product.ngaytao).toLocaleDateString('vi-VN') : '—';
                            - const tonKho = (product.tonkho !== undefined && product.tonkho !== null) ? product.tonkho : (product.soluongton || 0);
                            - const __noSizeTypes = ['tui','phukien'];
                            - const __isNoSize = __noSizeTypes.includes(String(product.loaisanpham || '').toLowerCase());
                            - const __tonChinh = __isNoSize ? (product.soluong_chinh || 0) : ((product.sizes || []).reduce((sum, s) => sum + Number(s?.soluong || 0), 0));
                            - const laSapHet = tonKho > 0 && tonKho <= lowStockThresholdVal;
                            tr.pa-row
                                td.pa-th-num: span.pa-num #{idx + 1}
                                td
                                    .pa-product
                                        img.pa-product__img(src=imgSrc, alt=product.tensanpham || 'Hình sản phẩm')
                                        .pa-product__meta
                                            span.pa-product__name #{product.tensanpham || '—'}
                                            if product.bienthe && product.bienthe.length
                                                span.pa-product__variants
                                                    i.bi.bi-palette
                                                    | #{product.bienthe.length} biến thể
                                td: span.pa-chip #{product.tenThuongHieu || '—'}
                                td
                                    if giamGia > 0
                                        .pa-price
                                            span.pa-price__old #{giaGoc}
                                            span.pa-price__sale #{giaKhuyenMai}
                                            span.pa-price__badge -#{giamGia}%
                                    else
                                        span.pa-price__main #{giaGoc}
                                td
                                    if tonKho > 0
                                        .pa-stock
                                            span.pa-stock__num #{tonKho}
                                            if laSapHet
                                                span.pa-tag.pa-tag--warn Sắp hết
                                            small.pa-stock__hint Chính: #{__tonChinh}
                                    else
                                        span.pa-tag.pa-tag--muted Hết hàng
                                td: span.pa-date
                                    i.bi.bi-calendar3
                                    | #{ngayCapNhat}
                                td
                                    if isActive
                                        span.pa-tag.pa-tag--success Đang bán
                                    else
                                        span.pa-tag.pa-tag--danger Ngừng bán
                                td.pa-th-actions
                                    .pa-actions
                                        a.pa-icon-btn.pa-icon-btn--edit(href=`${admin}/products/${product._id}/edit`, title="Sửa")
                                            i.bi.bi-pencil
                                        if !product.daxoa
                                            form(method="POST" action=`${admin}/products/${product._id}/toggle-status` onsubmit=isActive ? "return confirm('Chuyển sản phẩm này sang Ngừng bán?')" : "return confirm('Bật bán lại sản phẩm này?')")
                                                if isActive
                                                    button.pa-icon-btn.pa-icon-btn--pause(type="submit" title="Ngừng bán")
                                                        i.bi.bi-pause-fill
                                                else
                                                    button.pa-icon-btn.pa-icon-btn--play(type="submit" title="Bật bán")
                                                        i.bi.bi-play-fill
                                        if product.daxoa
                                            form(method="POST" action=`${admin}/products/${product._id}/restore` onsubmit="return confirm('Khôi phục sản phẩm này?')")
                                                button.pa-icon-btn.pa-icon-btn--play(type="submit" title="Khôi phục")
                                                    i.bi.bi-arrow-counterclockwise
                                            form(method="POST" action=`${admin}/products/${product._id}/hard-delete` onsubmit=product.daDuocMua ? null : "return confirm('Xóa vĩnh viễn sản phẩm này? Hành động không thể hoàn tác!')")
                                                button.pa-icon-btn.pa-icon-btn--delete(type="submit" title=product.daDuocMua ? 'Sản phẩm đã có đơn hàng, không thể xóa' : 'Xóa vĩnh viễn' disabled=product.daDuocMua)
                                                    i.bi.bi-x-octagon
                                        else
                                            if product.daDuocMua
                                                button.pa-icon-btn.pa-icon-btn--delete(type='button' title='Sản phẩm đã có đơn hàng, không thể xóa' disabled)
                                                    i.bi.bi-trash
                                            else
                                                a.pa-icon-btn.pa-icon-btn--delete(href=`${admin}/products/${product._id}/delete`, title="Xóa" onclick="return xacNhanXoa('Bạn có chắc chắn muốn xóa?')")
                                                    i.bi.bi-trash

                            if product.bienthe && product.bienthe.length
                                each v, vIdx in product.bienthe
                                    - const vGia = (v.gia !== undefined && v.gia !== null) ? v.gia : product.gia;
                                    - const vGiam = (v.phantramgiamgia !== undefined && v.phantramgiamgia !== null) ? v.phantramgiamgia : giamGia;
                                    - const vGiaGoc = vGia ? vGia.toLocaleString('vi-VN') + '₫' : '—';
                                    - const vGiaKM = vGiam > 0 && vGia ? Math.round(vGia * (100 - vGiam) / 100).toLocaleString('vi-VN') + '₫' : null;
                                    - const vImg = v.hinhanh || imgSrc;
                                    - const vTon = __isNoSize ? (v.soluong || 0) : ((v.sizes || []).reduce((sum, s) => sum + Number(s.soluong || 0), 0));
                                    - const vTitle = `${product.tensanpham || '—'} - ${v.mausac || 'Biến thể'}`;
                                    - const vLaSapHet = vTon > 0 && vTon <= lowStockThresholdVal;
                                    tr.pa-row.pa-row--variant
                                        td.pa-th-num: span.pa-num.pa-num--sub #{idx + 1}.#{vIdx + 1}
                                        td
                                            .pa-product.pa-product--variant
                                                img.pa-product__img.pa-product__img--sm(src=vImg, alt=vTitle)
                                                .pa-product__meta
                                                    span.pa-product__name #{vTitle}
                                                    if v.mausac
                                                        span.pa-product__variants
                                                            i.bi.bi-droplet-half
                                                            | #{v.mausac}
                                        td: span.pa-chip #{product.tenThuongHieu || '—'}
                                        td
                                            if vGiam > 0
                                                .pa-price
                                                    span.pa-price__old #{vGiaGoc}
                                                    span.pa-price__sale #{vGiaKM}
                                                    span.pa-price__badge -#{vGiam}%
                                            else
                                                span.pa-price__main #{vGiaGoc}
                                        td
                                            if vTon > 0
                                                .pa-stock
                                                    span.pa-stock__num #{vTon}
                                                    if vLaSapHet
                                                        span.pa-tag.pa-tag--warn Sắp hết
                                            else
                                                span.pa-tag.pa-tag--muted Hết hàng
                                        td: span.pa-date
                                            i.bi.bi-calendar3
                                            | #{ngayCapNhat}
                                        td
                                            if isActive
                                                span.pa-tag.pa-tag--success Đang bán
                                            else
                                                span.pa-tag.pa-tag--danger Ngừng bán
                                        td.pa-th-actions
                                            .pa-actions
                                                a.pa-icon-btn.pa-icon-btn--edit(href=`${admin}/products/${product._id}/edit`, title="Sửa")
                                                    i.bi.bi-pencil
                                                if !product.daxoa
                                                    form(method="POST" action=`${admin}/products/${product._id}/toggle-status` onsubmit=isActive ? "return confirm('Chuyển sản phẩm này sang Ngừng bán?')" : "return confirm('Bật bán lại sản phẩm này?')")
                                                        if isActive
                                                            button.pa-icon-btn.pa-icon-btn--pause(type="submit" title="Ngừng bán")
                                                                i.bi.bi-pause-fill
                                                        else
                                                            button.pa-icon-btn.pa-icon-btn--play(type="submit" title="Bật bán")
                                                                i.bi.bi-play-fill

            //- Mobile cards
            .pa-cards.d-lg-none
                each product, idx in products
                    - const price = product.giamoiText || product.giaText || (product.gia ? product.gia.toLocaleString('vi-VN') + '₫' : '—');
                    - const status = (product.trangthai || '').toLowerCase();
                    - const isActive = status === 'dangban' || status === 'active' || status === 'đang bán';
                    - const imgSrc = product.displayImage || product.hinhanh || '/images/shopping.png';
                    - const __noSizeTypes = ['tui','phukien'];
                    - const __isNoSize = __noSizeTypes.includes(String(product.loaisanpham || '').toLowerCase());
                    - const tonKhoMobile = (product.tonkho !== undefined && product.tonkho !== null) ? product.tonkho : (product.soluongton || 0);
                    - const laSapHetMobile = tonKhoMobile > 0 && tonKhoMobile <= lowStockThresholdVal;
                    .pa-card
                        .pa-card__head
                            img.pa-card__img(src=imgSrc, alt=product.tensanpham || 'Hình sản phẩm')
                            .pa-card__title-wrap
                                span.pa-card__title #{product.tensanpham || '—'}
                                if product.bienthe && product.bienthe.length
                                    span.pa-product__variants
                                        i.bi.bi-palette
                                        | #{product.bienthe.length} biến thể
                                if isActive
                                    span.pa-tag.pa-tag--success Đang bán
                                else
                                    span.pa-tag.pa-tag--danger Ngừng bán
                        .pa-card__body
                            .pa-card__line
                                span Giá
                                strong.pa-price__main #{price}
                            .pa-card__line
                                span Thương hiệu
                                span.pa-chip #{product.tenThuongHieu || '—'}
                            .pa-card__line
                                span Tồn kho
                                span.pa-stock__num #{tonKhoMobile}
                            if laSapHetMobile
                                span.pa-tag.pa-tag--warn Sắp hết (≤ #{lowStockThresholdVal})
                        .pa-card__foot
                            a.pa-btn.pa-btn--ghost.pa-btn--sm(href=`${admin}/products/${product._id}/edit`)
                                i.bi.bi-pencil
                                | Sửa
                            if !product.daxoa
                                form(method="POST" action=`${admin}/products/${product._id}/toggle-status` onsubmit=isActive ? "return confirm('Chuyển sản phẩm này sang Ngừng bán?')" : "return confirm('Bật bán lại sản phẩm này?')")
                                    if isActive
                                        button.pa-btn.pa-btn--ghost.pa-btn--sm(type="submit")
                                            i.bi.bi-pause-fill
                                            | Ngừng
                                    else
                                        button.pa-btn.pa-btn--ghost.pa-btn--sm(type="submit")
                                            i.bi.bi-play-fill
                                            | Bật bán
                            if product.daxoa
                                form(method="POST" action=`${admin}/products/${product._id}/restore` onsubmit="return confirm('Khôi phục sản phẩm này?')")
                                    button.pa-btn.pa-btn--ghost.pa-btn--sm(type="submit")
                                        i.bi.bi-arrow-counterclockwise
                                        | Khôi phục
                            else
                                if product.daDuocMua
                                    button.pa-btn.pa-btn--danger.pa-btn--sm(type='button' disabled title='Sản phẩm đã có đơn hàng, không thể xóa')
                                        i.bi.bi-trash
                                        | Xóa
                                else
                                    a.pa-btn.pa-btn--danger.pa-btn--sm(href=`${admin}/products/${product._id}/delete` onclick="return xacNhanXoa('Bạn có chắc chắn muốn xóa?')")
                                        i.bi.bi-trash
                                        | Xóa

            +page()
        else
            .pa-empty
                i.bi.bi-inbox
                h4 Không tìm thấy sản phẩm
                p Không có sản phẩm nào phù hợp với tiêu chí tìm kiếm của bạn.
                .pa-empty__actions
                    a.pa-btn.pa-btn--ghost(href=`${admin}/products`)
                        i.bi.bi-arrow-counterclockwise
                        | Xóa bộ lọc
                    a.pa-btn.pa-btn--primary(href=`${admin}/products/create`)
                        i.bi.bi-plus-lg
                        | Thêm sản phẩm mới

block scripts
    script(src="/admin/js/products.js")
    script.
        (function () {
            if (window.FilterAutoSubmit && typeof window.FilterAutoSubmit.attachOnReady === 'function') {
                window.FilterAutoSubmit.attachOnReady('.pa-advanced', {
                    inputSelectors: [
                        'input[name="priceMin"]',
                        'input[name="priceMax"]',
                        'input[name="dateFrom"]',
                        'input[name="dateTo"]'
                    ],
                    inputDebounceMs: 800,
                    keywordSelector: null
                });
            }
        })();
