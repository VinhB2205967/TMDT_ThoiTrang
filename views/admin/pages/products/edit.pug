extends ../../layouts/default.pug

block main
    .page-header-section.orders-header
        .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
            h1.page-title.mb-0
                i.bi.bi-pencil-square.me-2
                | Chỉnh sửa sản phẩm
            .d-flex.align-items-center.gap-2.orders-actions
                a.btn.btn-header.btn-header-outline(href=`${admin}/products`)
                    i.bi.bi-arrow-left.me-1
                    | Quay lại

    .dashboard-container.mt-4
        - const editActionUrl = `${admin}/products/${product._id}/edit?_csrf=${encodeURIComponent(csrfToken || '')}`
        form(action=editActionUrl method="POST" enctype="multipart/form-data")
            input(type="hidden" name="_csrf" value=csrfToken)
            .row.g-4
                //- Cột trái - Thông tin cơ bản
                .col-lg-8
                    .card.mb-4
                        .card-header.bg-primary.text-white
                            i.bi.bi-info-circle.me-2
                            | Thông tin cơ bản
                        .card-body
                            .mb-3
                                label.form-label.fw-bold Tên sản phẩm *
                                input.form-control(type="text" name="tensanpham" required value=product.tensanpham placeholder="Nhập tên sản phẩm...")
                            
                            .mb-3
                                label.form-label.fw-bold Mô tả
                                textarea.form-control(name="mota" rows="4" placeholder="Mô tả chi tiết sản phẩm...")= product.mota

                            .mb-3
                                label.form-label.fw-bold Ảnh mô tả sản phẩm
                                if product.mota_hinhanh
                                    .mb-2
                                        img.rounded.border(src=product.mota_hinhanh alt='Ảnh mô tả' style='max-height:120px;object-fit:cover;')
                                input.form-control(type="file" name="mota_hinhanh" accept="image/*")
                                small.text-muted Để trống nếu không thay đổi ảnh mô tả
                            
                            .row.g-3
                                .col-md-6
                                    label.form-label.fw-bold Giá gốc (₫)
                                    input.form-control(type="number" name="gia" min="0" value=product.gia placeholder="Để trống, giữ giá hiện tại")
                                
                                .col-md-6
                                    label.form-label.fw-bold Giảm giá (%)
                                    input.form-control(type="number" name="phantramgiamgia" min="0" max="100" value=product.phantramgiamgia || 0 placeholder="0")

                            .mt-2
                                small.text-muted Có thể để trống giá gốc nếu muốn giữ giá hiện tại hoặc cập nhật giá qua phiếu nhập kho.
                            
                            .row.g-3.mt-2
                                .col-12
                                    .alert.alert-info.mb-0.py-2
                                        .d-flex.justify-content-between.align-items-center
                                            span
                                                i.bi.bi-box-seam.me-2
                                                strong Tổng số lượng tồn kho:
                                            span.fs-5.fw-bold#tongsoluong #{product.soluongton || 0}
                                        input(type="hidden" name="soluongton" id="soluongton" value=product.soluongton || 0)
                    
                    .card
                        .card-header.bg-info.text-white
                            i.bi.bi-tags.me-2
                            | Phân loại
                        .card-body
                            .row.g-3
                                .col-md-4
                                    label.form-label.fw-bold Giới tính
                                    select.form-select(name="gioitinh")
                                        option(value="unisex" selected=(product.gioitinh === 'unisex')) Unisex
                                        option(value="nam" selected=(product.gioitinh === 'nam')) Nam
                                        option(value="nu" selected=(product.gioitinh === 'nu')) Nữ
                                
                                .col-md-4
                                    label.form-label.fw-bold Loại sản phẩm
                                    select#loaisanpham.form-select(name="loaisanpham" onchange="doiHienThiSize()")
                                        option(value="") -- Chọn loại sản phẩm --
                                        each c in (categoryOptions || [])
                                            option(value=c.slug selected=(String(product.loaisanpham || '') === String(c.slug || ''))) #{c.name}
                                        - const hasLegacyType = String(product.loaisanpham || '').trim() && !(categoryOptions || []).some(c => String(c.slug || '') === String(product.loaisanpham || ''));
                                        if hasLegacyType
                                            option(value=product.loaisanpham selected=true) #{product.loaisanpham} (giá trị cũ)
                                
                                .col-md-4
                                    label.form-label.fw-bold Trạng thái
                                    select.form-select(name="trangthai")
                                        option(value="dangban" selected=(product.trangthai === 'dangban')) Đang bán
                                        option(value="ngungban" selected=(product.trangthai === 'ngungban')) Ngừng bán

                            .row.g-3.mt-1
                                .col-md-12
                                    label.form-label.fw-bold Thương hiệu
                                    select.form-select(name="brand")
                                        option(value="") -- Chọn thương hiệu --
                                        each b in (brandOptions || [])
                                            - const selectedBrand = String(b._id) === String(product.brand || product.thuonghieu_id || '')
                                            option(value=b._id selected=selectedBrand) #{b.ten}

                            .row.g-3.mt-1
                                .col-md-6
                                    label.form-label.fw-bold Dịp sử dụng
                                    - const selectedOccasionIds = Array.isArray(product.occasions) && product.occasions.length ? product.occasions.map(id => String(id)) : (product.occasion ? [String(product.occasion)] : []);
                                    .dropdown.occasion-dropdown
                                        button.btn.btn-outline-secondary.dropdown-toggle.w-100.text-start.occasion-dropdown-toggle(type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static")
                                            | Chọn dịp sử dụng
                                        ul.dropdown-menu.w-100.p-2.occasion-dropdown-menu
                                            if (occasionOptions || []).length
                                                each c in (occasionOptions || [])
                                                    - const selectedOccasion = selectedOccasionIds.includes(String(c._id))
                                                    li
                                                        label.dropdown-item.d-flex.align-items-center.gap-2.py-1.occasion-dropdown-item(for=`occasion-${c._id}`)
                                                            input.form-check-input.mt-0(type="checkbox" id=`occasion-${c._id}` name="occasions" value=c._id checked=selectedOccasion)
                                                            span #{c.name}
                                            else
                                                li
                                                    span.dropdown-item-text.text-muted Chưa có dữ liệu dịp sử dụng.
                                    small.text-muted.occasion-dropdown-hint Nhấn để mở danh sách và tick nhiều dịp.
                                .col-md-6
                                    label.form-label.fw-bold Nhóm tuổi
                                    select.form-select(name="ageGroup")
                                        option(value="") -- Chọn nhóm tuổi --
                                        each c in (ageGroupOptions || [])
                                            - const selectedAge = String(c._id) === String(product.ageGroup || '')
                                            option(value=c._id selected=selectedAge) #{c.name}

                            .row.g-3.mt-1
                                .col-md-12
                                    label.form-label.fw-bold Bảng hướng dẫn size
                                    select.form-select(name='sizeguide_id')
                                        option(value='') -- Tự động theo loại sản phẩm --
                                        each sg in (sizeGuideOptions || [])
                                            - const selectedGuide = String(sg._id) === String(product.sizeguide_id || '')
                                            option(value=sg._id data-loai=sg.loaisanpham selected=selectedGuide) #{sg.tenbang} (#{sg.loaisanpham.toUpperCase()})
                                    small.text-muted Chọn bảng size riêng cho sản phẩm nếu muốn ghi đè mặc định theo loại.
                            
                            .mt-3
                                label.form-label.fw-bold Màu sắc sản phẩm chính
                                input.form-control(type="text" name="mausac_chinh" value=product.mausac_chinh placeholder="VD: Đen, Trắng, Xanh...")
                                small.text-muted Màu sắc đại diện cho ảnh sản phẩm chính
                            
                            - const productSizes = product.sizes || [];
                            - const getSizeQty = (sizeCode) => { const found = productSizes.find(s => s.size === sizeCode); return found ? found.soluong : 0; }
                            - const noSizeTypes = ['tui', 'phukien']
                            - const isNoSizeProduct = noSizeTypes.includes(product.loaisanpham)
                            #baseSizeSection.mt-3(style=(isNoSizeProduct ? 'display:none' : ''))
                                label.form-label.fw-bold Size chung (không theo biến thể)
                                small.text-muted.d-block.mb-2 Số lượng tồn kho được quản lý qua phiếu nhập/xuất kho (FIFO), không chỉnh trực tiếp tại đây.
                                .row.g-2
                                    .col-4.col-md-2
                                        label.form-label.small XS
                                        input.form-control.form-control-sm.base-size-qty(type="number" name="size_XS" min="0" value=getSizeQty('XS') readonly disabled)
                                    .col-4.col-md-2
                                        label.form-label.small S
                                        input.form-control.form-control-sm.base-size-qty(type="number" name="size_S" min="0" value=getSizeQty('S') readonly disabled)
                                    .col-4.col-md-2
                                        label.form-label.small M
                                        input.form-control.form-control-sm.base-size-qty(type="number" name="size_M" min="0" value=getSizeQty('M') readonly disabled)
                                    .col-4.col-md-2
                                        label.form-label.small L
                                        input.form-control.form-control-sm.base-size-qty(type="number" name="size_L" min="0" value=getSizeQty('L') readonly disabled)
                                    .col-4.col-md-2
                                        label.form-label.small XL
                                        input.form-control.form-control-sm.base-size-qty(type="number" name="size_XL" min="0" value=getSizeQty('XL') readonly disabled)
                                    .col-4.col-md-2
                                        label.form-label.small XXL
                                        input.form-control.form-control-sm.base-size-qty(type="number" name="size_XXL" min="0" value=getSizeQty('XXL') readonly disabled)
                            
                            //- Số lượng chung (cho sản phẩm không có size như Túi, Phụ kiện)
                            #baseQtySection.mt-3(style=(isNoSizeProduct ? '' : 'display:none'))
                                label.form-label.fw-bold Số lượng sản phẩm
                                input.form-control.base-direct-qty(type="number" name="soluong_chinh" min="0" value=product.soluong_chinh || 0 readonly disabled)
                                small.text-muted Số lượng cho sản phẩm chính (không theo biến thể) được quản lý bằng nhập/xuất kho.
                    
                    //- Card biến thể
                    - const bientheList = product.bienthe || [];
                    .card.mt-4
                        .card-header.bg-secondary.text-white.d-flex.justify-content-between.align-items-center
                            span
                                i.bi.bi-palette.me-2
                                | Biến thể màu sắc
                                if bientheList.length
                                    span.badge.bg-light.text-dark.ms-2 #{bientheList.length}
                            button.btn.btn-sm.btn-light(type="button" onclick="themBienThe()")
                                i.bi.bi-plus.me-1
                                | Thêm
                        .card-body
                            #variants-container
                                each bt, idx in bientheList
                                    - const btSizes = bt.sizes || [];
                                    - const getBtSizeQty = (sizeCode) => { const found = btSizes.find(s => s.size === sizeCode); return found ? found.soluong : 0; }
                                    .variant-item.border.rounded.p-3.mb-3(id=`variant-${idx}`)
                                        .d-flex.justify-content-between.align-items-center.mb-2
                                            span.fw-bold.text-secondary Biến thể ##{idx + 1}
                                            button.btn.btn-sm.btn-outline-danger(type="button" onclick=`xoaBienThe(${idx})`)
                                                i.bi.bi-trash
                                        .row.g-2
                                            .col-md-4
                                                label.form-label.small Màu sắc *
                                                input.form-control.form-control-sm(type="text" name="bienthe_mausac" value=bt.mausac placeholder="VD: Đỏ, Xanh..." required)
                                            .col-md-4
                                                label.form-label.small Giá riêng (₫)
                                                input.form-control.form-control-sm(type="number" name="bienthe_gia" min="0" value=bt.gia placeholder="Để trống = giá gốc")
                                            .col-md-4
                                                label.form-label.small Giảm giá (%)
                                                input.form-control.form-control-sm(type="number" name="bienthe_giamgia" min="0" max="100" value=bt.phantramgiamgia || 0)
                                            .col-12
                                                label.form-label.small Ảnh biến thể
                                                .d-flex.align-items-center.gap-2
                                                    - const btImage = bt.hinhanh || '/images/shopping.png'
                                                    img.variant-preview.rounded(src=btImage alt="Preview" style="width: 50px; height: 50px; object-fit: cover;")
                                                    input(type="hidden" name="bienthe_hinhanh_cu" value=bt.hinhanh || '')
                                                    input.variant-has-new-image(type="hidden" name="bienthe_has_new_image" value="0")
                                                    input.form-control.form-control-sm(type="file" name="bienthe_hinhanh" accept="image/*" onchange="danhDauAnhMoi(this)")
                                                small.text-muted Để trống nếu không đổi ảnh
                                            //- Số lượng trực tiếp (cho sản phẩm không có size)
                                            .col-12.variant-qty-section(style=(isNoSizeProduct ? '' : 'display:none'))
                                                label.form-label.small Số lượng *
                                                input.form-control.form-control-sm.variant-direct-qty(type="number" name="bienthe_soluong" min="0" value=bt.soluong || 0 readonly disabled)
                                            //- Số lượng theo Size (cho sản phẩm có size)
                                            .col-12.variant-size-section(style=(isNoSizeProduct ? 'display:none' : ''))
                                                label.form-label.small Số lượng theo Size
                                                .row.g-2
                                                    .col-4.col-md-2
                                                        label.form-label.small.text-muted XS
                                                        input.form-control.form-control-sm.variant-size-qty(type="number" name=`bienthe_${idx}_size_XS` min="0" value=getBtSizeQty('XS') readonly disabled)
                                                    .col-4.col-md-2
                                                        label.form-label.small.text-muted S
                                                        input.form-control.form-control-sm.variant-size-qty(type="number" name=`bienthe_${idx}_size_S` min="0" value=getBtSizeQty('S') readonly disabled)
                                                    .col-4.col-md-2
                                                        label.form-label.small.text-muted M
                                                        input.form-control.form-control-sm.variant-size-qty(type="number" name=`bienthe_${idx}_size_M` min="0" value=getBtSizeQty('M') readonly disabled)
                                                    .col-4.col-md-2
                                                        label.form-label.small.text-muted L
                                                        input.form-control.form-control-sm.variant-size-qty(type="number" name=`bienthe_${idx}_size_L` min="0" value=getBtSizeQty('L') readonly disabled)
                                                    .col-4.col-md-2
                                                        label.form-label.small.text-muted XL
                                                        input.form-control.form-control-sm.variant-size-qty(type="number" name=`bienthe_${idx}_size_XL` min="0" value=getBtSizeQty('XL') readonly disabled)
                                                    .col-4.col-md-2
                                                        label.form-label.small.text-muted XXL
                                                        input.form-control.form-control-sm.variant-size-qty(type="number" name=`bienthe_${idx}_size_XXL` min="0" value=getBtSizeQty('XXL') readonly disabled)
                            if !bientheList.length
                                .text-muted.small.text-center#no-variant-msg
                                    i.bi.bi-info-circle.me-1
                                    | Nhấn "Thêm" để thêm biến thể màu sắc
                
                //- Cột phải - Hình ảnh
                .col-lg-4
                    .card
                        .card-header.bg-success.text-white
                            i.bi.bi-image.me-2
                            | Hình ảnh sản phẩm
                        .card-body.text-center
                            .mb-3
                                - const currentImage = product.displayImage || product.hinhanh || '/images/shopping.png';
                                img#preview-image.img-fluid.rounded.mb-3(src=currentImage alt="Preview" style="max-height: 250px; object-fit: cover;")
                            
                            input.form-control(type="file" name="hinhanh" accept="image/*" onchange="xemTruocAnh(this)")
                            small.text-muted.d-block.mt-2 Để trống nếu không thay đổi ảnh
                    
                    .card.mt-4
                        .card-header.bg-warning
                            i.bi.bi-clock-history.me-2
                            | Thông tin khác
                        .card-body
                            p.mb-2
                                strong Ngày cập nhật: 
                                if product.ngaycapnhat || product.ngaytao
                                    | #{new Date(product.ngaycapnhat || product.ngaytao).toLocaleDateString('vi-VN')}
                                else
                                    | —
                            p.mb-0
                                strong ID: 
                                code #{product._id}
                    
                    .card.mt-4
                        .card-body
                            .d-grid.gap-2
                                button.btn.btn-primary.btn-lg(type="submit")
                                    i.bi.bi-check-lg.me-1
                                    | Lưu thay đổi
                                a.btn.btn-outline-secondary(href=`${admin}/products`)
                                    i.bi.bi-x-lg.me-1
                                    | Hủy bỏ
                                a.btn.btn-outline-danger(href=`${admin}/products/${product._id}/delete` onclick="return xacNhanXoa()")
                                    i.bi.bi-trash.me-1
                                    | Xóa sản phẩm

block scripts
    script(src="/admin/js/products.js")
    script.
        // Khởi tạo variantIndex cho trang edit (số biến thể hiện có)
        khoiTaoChiSoBienThe(#{(product.bienthe || []).length});
        // Kiểm tra loại sản phẩm khi load trang
        document.addEventListener('DOMContentLoaded', function() {
            doiHienThiSize();
        });
