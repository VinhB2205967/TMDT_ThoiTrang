extends ../../layouts/default.pug

block main
    .page-header-section
        .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
            h1.page-title.mb-0
                i.bi.bi-plus-circle.me-2
                | Thêm sản phẩm mới
            a.btn.btn-outline-light(href=`${admin}/products`)
                i.bi.bi-arrow-left.me-1
                | Quay lại

    .dashboard-container.mt-4
        - const createActionUrl = `${admin}/products/create?_csrf=${encodeURIComponent(csrfToken || '')}`
        form(action=createActionUrl method="POST" enctype="multipart/form-data")
            input(type="hidden" name="_csrf" value=csrfToken)
            .row.g-4
                //- Cột trái - Thông tin cơ bản
                .col-lg-8
                    .card.mb-4
                        .card-header.bg-primary.text-white
                            i.bi.bi-info-circle.me-2
                            | Thông tin cơ bản
                        .card-body
                            .mb-3
                                label.form-label.fw-bold Tên sản phẩm *
                                input.form-control(type="text" name="tensanpham" required placeholder="Nhập tên sản phẩm...")
                            
                            .mb-3
                                label.form-label.fw-bold Mô tả
                                textarea.form-control(name="mota" rows="4" placeholder="Mô tả chi tiết sản phẩm...")

                            .mb-3
                                label.form-label.fw-bold Ảnh mô tả sản phẩm
                                input.form-control(type="file" name="mota_hinhanh" accept="image/*")
                                small.text-muted Chèn ảnh minh họa hiển thị trong phần mô tả ở trang chi tiết sản phẩm
                            
                            .row.g-3
                                .col-md-6
                                    label.form-label.fw-bold Giá gốc (₫)
                                    input.form-control(type="number" name="gia" min="0" placeholder="Để trống, sẽ cập nhật từ phiếu nhập")
                                
                                .col-md-6
                                    label.form-label.fw-bold Giảm giá (%)
                                    input.form-control(type="number" name="phantramgiamgia" min="0" max="100" value="0" placeholder="0")

                            .mt-2
                                small.text-muted Giá sản phẩm chính và biến thể có thể cập nhật tự động từ phiếu nhập kho, không bắt buộc nhập tại form này.
                            
                            .row.g-3.mt-2
                                .col-12
                                    .alert.alert-info.mb-0.py-2
                                        .d-flex.justify-content-between.align-items-center
                                            span
                                                i.bi.bi-box-seam.me-2
                                                strong Tổng số lượng tồn kho:
                                            span.fs-5.fw-bold#tongsoluong 0
                                        input(type="hidden" name="soluongton" id="soluongton" value="0")
                    
                    .card
                        .card-header.bg-info.text-white
                            i.bi.bi-tags.me-2
                            | Phân loại
                        .card-body
                            .row.g-3
                                .col-md-4
                                    label.form-label.fw-bold Giới tính
                                    select.form-select(name="gioitinh")
                                        option(value="unisex") Unisex
                                        option(value="nam") Nam
                                        option(value="nu") Nữ
                                
                                .col-md-4
                                    label.form-label.fw-bold Loại sản phẩm
                                    select#loaisanpham.form-select(name="loaisanpham" onchange="doiHienThiSize()")
                                        option(value="") -- Chọn loại sản phẩm --
                                        each c in (categoryOptions || [])
                                            option(value=c.slug) #{c.name}
                                
                                .col-md-4
                                    label.form-label.fw-bold Trạng thái
                                    select.form-select(name="trangthai")
                                        option(value="dangban") Đang bán
                                        option(value="ngungban") Ngừng bán

                            .row.g-3.mt-1
                                .col-md-12
                                    label.form-label.fw-bold Thương hiệu
                                    select.form-select(name="brand")
                                        option(value="") -- Chọn thương hiệu --
                                        each b in (brandOptions || [])
                                            option(value=b._id) #{b.ten}

                            .row.g-3.mt-1
                                .col-md-6
                                    label.form-label.fw-bold Dịp sử dụng
                                    .dropdown.occasion-dropdown
                                        button.btn.btn-outline-secondary.dropdown-toggle.w-100.text-start.occasion-dropdown-toggle(type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-display="static")
                                            | Chọn dịp sử dụng
                                        ul.dropdown-menu.w-100.p-2.occasion-dropdown-menu
                                            if (occasionOptions || []).length
                                                each c in (occasionOptions || [])
                                                    li
                                                        label.dropdown-item.d-flex.align-items-center.gap-2.py-1.occasion-dropdown-item(for=`occasion-${c._id}`)
                                                            input.form-check-input.mt-0(type="checkbox" id=`occasion-${c._id}` name="occasions" value=c._id)
                                                            span #{c.name}
                                            else
                                                li
                                                    span.dropdown-item-text.text-muted Chưa có dữ liệu dịp sử dụng.
                                    small.text-muted.occasion-dropdown-hint Nhấn để mở danh sách và tick nhiều dịp.
                                .col-md-6
                                    label.form-label.fw-bold Nhóm tuổi
                                    select.form-select(name="ageGroup")
                                        option(value="") -- Chọn nhóm tuổi --
                                        each c in (ageGroupOptions || [])
                                            option(value=c._id) #{c.name}

                            .row.g-3.mt-1
                                .col-md-12
                                    label.form-label.fw-bold Bảng hướng dẫn size
                                    select.form-select(name='sizeguide_id')
                                        option(value='') -- Tự động theo loại sản phẩm --
                                        each sg in (sizeGuideOptions || [])
                                            option(value=sg._id data-loai=sg.loaisanpham) #{sg.tenbang} (#{sg.loaisanpham.toUpperCase()})
                                    small.text-muted Khi để tự động, hệ thống sẽ lấy bảng size phù hợp theo loại sản phẩm.
                            
                            .mt-3
                                label.form-label.fw-bold Màu sắc sản phẩm chính
                                input.form-control(type="text" name="mausac_chinh" placeholder="VD: Đen, Trắng, Xanh...")
                                small.text-muted Màu sắc đại diện cho ảnh sản phẩm
                            
                            #baseSizeSection.mt-3
                                label.form-label.fw-bold Size chung (không theo biến thể)
                                small.text-muted.d-block.mb-2 Số lượng tồn kho được quản lý qua phiếu nhập/xuất kho (FIFO), không nhập trực tiếp tại đây.
                                .row.g-2
                                    .col-4.col-md-2
                                        label.form-label.small XS
                                        input.form-control.form-control-sm.base-size-qty(type="number" name="size_XS" min="0" value="0" readonly disabled)
                                    .col-4.col-md-2
                                        label.form-label.small S
                                        input.form-control.form-control-sm.base-size-qty(type="number" name="size_S" min="0" value="0" readonly disabled)
                                    .col-4.col-md-2
                                        label.form-label.small M
                                        input.form-control.form-control-sm.base-size-qty(type="number" name="size_M" min="0" value="0" readonly disabled)
                                    .col-4.col-md-2
                                        label.form-label.small L
                                        input.form-control.form-control-sm.base-size-qty(type="number" name="size_L" min="0" value="0" readonly disabled)
                                    .col-4.col-md-2
                                        label.form-label.small XL
                                        input.form-control.form-control-sm.base-size-qty(type="number" name="size_XL" min="0" value="0" readonly disabled)
                                    .col-4.col-md-2
                                        label.form-label.small XXL
                                        input.form-control.form-control-sm.base-size-qty(type="number" name="size_XXL" min="0" value="0" readonly disabled)
                            
                            //- Số lượng chung (cho sản phẩm không có size như Túi, Phụ kiện)
                            #baseQtySection.mt-3(style="display:none")
                                label.form-label.fw-bold Số lượng sản phẩm
                                input.form-control.base-direct-qty(type="number" name="soluong_chinh" min="0" value="0" readonly disabled)
                                small.text-muted Số lượng cho sản phẩm được quản lý bằng nhập/xuất kho.
                    
                    //- Card biến thể
                    .card.mt-4
                        .card-header.bg-secondary.text-white.d-flex.justify-content-between.align-items-center
                            span
                                i.bi.bi-palette.me-2
                                | Biến thể màu sắc
                            button.btn.btn-sm.btn-light(type="button" onclick="themBienThe()")
                                i.bi.bi-plus.me-1
                                | Thêm
                        .card-body
                            #variants-container
                                //- Biến thể sẽ được thêm bằng JavaScript
                            .text-muted.small.text-center#no-variant-msg
                                i.bi.bi-info-circle.me-1
                                | Nhấn "Thêm" để thêm biến thể màu sắc
                
                //- Cột phải - Hình ảnh
                .col-lg-4
                    .card
                        .card-header.bg-success.text-white
                            i.bi.bi-image.me-2
                            | Hình ảnh sản phẩm
                        .card-body.text-center
                            .mb-3
                                img#preview-image.img-fluid.rounded.mb-3(src="/images/shopping.png" alt="Preview" style="max-height: 250px; object-fit: cover;")
                            
                            input.form-control(type="file" name="hinhanh" accept="image/*" onchange="xemTruocAnh(this)")
                            small.text-muted.d-block.mt-2 Chấp nhận: JPG, PNG, GIF, WEBP
                    
                    .card.mt-4
                        .card-body
                            .d-grid.gap-2
                                button.btn.btn-primary.btn-lg(type="submit")
                                    i.bi.bi-check-lg.me-1
                                    | Thêm sản phẩm
                                a.btn.btn-outline-secondary(href=`${admin}/products`)
                                    i.bi.bi-x-lg.me-1
                                    | Hủy bỏ

block scripts
    script(src="/admin/js/products.js")
    script.
        // Khởi tạo variantIndex cho trang create
        khoiTaoChiSoBienThe(0);
        // Kiểm tra loại sản phẩm khi load trang
        document.addEventListener('DOMContentLoaded', function() {
            doiHienThiSize();
        });
