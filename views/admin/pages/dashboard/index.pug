extends ../../layouts/default.pug
block main
    - const s = stats || { totalProducts: 0, activeProducts: 0, inactiveProducts: 0, outOfStockCount: 0, totalRevenue: 0, totalCOGS: 0, totalProfit: 0, totalSoldItems: 0, totalExportOrders: 0, profitMarginPct: 0 }
    .dashboard-container
        .page-header-section.orders-header.admin-page-header.admin-dashboard-hero.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-3
            .hero-left
                h1.page-title
                    i.bi.bi-speedometer2.me-2
                    | Tổng quan hệ thống
                p.mb-0 Theo dõi nhanh tình trạng sản phẩm và danh mục
            .hero-actions.orders-actions.d-flex.flex-wrap.gap-2
                a.btn.btn-header.btn-header-primary.btn-sm.btn-add-product(href="/admin/products/create")
                    i.bi.bi-plus-circle.me-1
                    span Thêm sản phẩm
                a.btn.btn-header.btn-header-outline.btn-sm(href="/admin/products")
                    i.bi.bi-list-ul.me-1
                    | Danh sách SP
                //- a.btn.btn-header.btn-header-outline.btn-sm(href="/admin/ai-assistant")
                //-     i.bi.bi-robot.me-1
                //-     | AI Assistant

        .stats-grid
            .stat-card.stat-primary
                .stat-icon
                    i.bi.bi-box-seam
                .stat-content
                    .stat-value #{s.totalProducts || 0}
                    .stat-label Tổng sản phẩm
            .stat-card.stat-success
                .stat-icon
                    i.bi.bi-check-circle
                .stat-content
                    .stat-value #{s.activeProducts || 0}
                    .stat-label Đang bán
            .stat-card.stat-warning
                .stat-icon
                    i.bi.bi-pause-circle
                .stat-content
                    .stat-value #{s.inactiveProducts || 0}
                    .stat-label Ngừng bán
            .stat-card.stat-danger
                .stat-icon
                    i.bi.bi-exclamation-triangle
                .stat-content
                    .stat-value #{s.outOfStockCount || 0}
                    .stat-label Hết hàng

        .stats-grid.mt-3
            .stat-card.stat-primary
                .stat-icon
                    i.bi.bi-cash-coin
                .stat-content
                    .stat-value #{Number(s.totalRevenue || 0).toLocaleString('vi-VN')}đ
                    .stat-label Tổng doanh thu
            .stat-card.stat-warning
                .stat-icon
                    i.bi.bi-boxes
                .stat-content
                    .stat-value #{Number(s.totalSoldItems || 0).toLocaleString('vi-VN')}
                    .stat-label Tổng sản phẩm đã bán
            .stat-card.stat-secondary
                .stat-icon
                    i.bi.bi-receipt
                .stat-content
                    .stat-value #{Number(s.totalExportOrders || 0).toLocaleString('vi-VN')}
                    .stat-label Tổng đơn hàng
            .stat-card.stat-danger
                .stat-icon
                    i.bi.bi-wallet2
                .stat-content
                    .stat-value #{Number(s.totalCOGS || 0).toLocaleString('vi-VN')}đ
                    .stat-label Tổng giá vốn
            .stat-card.stat-success
                .stat-icon
                    i.bi.bi-graph-up-arrow
                .stat-content
                    .stat-value #{Number(s.totalProfit || 0).toLocaleString('vi-VN')}đ
                    .stat-label Tổng lợi nhuận
            .stat-card.stat-info
                .stat-icon
                    i.bi.bi-percent
                .stat-content
                    .stat-value #{Number(s.profitMarginPct || 0).toFixed(2)}%
                    .stat-label Tỷ suất lợi nhuận

        .dashboard-row
            .dashboard-col.col-main
                .dashboard-card
                    .card-header
                        h3.card-title
                            i.bi.bi-clock-history.me-2
                            | Sản phẩm mới thêm
                        a.view-all-link(href="/admin/products") Xem tất cả
                            i.bi.bi-arrow-right.ms-1
                    .card-body
                        if recentProducts && recentProducts.length
                            table.table.table-hover.recent-products-table
                                thead
                                    tr
                                        th(width="50") #
                                        th Hình ảnh
                                        th Tên sản phẩm
                                        th Giá
                                        th Trạng thái
                                        th Ngày cập nhật
                                tbody
                                    each product, idx in recentProducts
                                        tr
                                            td.text-muted #{idx + 1}
                                            td
                                                - const imgSrc = product.hinhanh ? (product.hinhanh.startsWith('/public') ? product.hinhanh.replace('/public', '') : product.hinhanh) : '/images/shopping.png'
                                                img.product-thumb(src=imgSrc alt=product.tensanpham)
                                            td
                                                .product-name-cell #{product.tensanpham}
                                            td.text-primary.fw-bold
                                                - const discountedPrice = product.phantramgiamgia > 0 ? (product.gia * (100 - product.phantramgiamgia) / 100) : product.gia
                                                | #{discountedPrice ? discountedPrice.toLocaleString('vi-VN') + '₫' : '—'}
                                            td
                                                if product.trangthai === 'dangban'
                                                    span.badge.bg-success Đang bán
                                                else
                                                    span.badge.bg-secondary Ngừng bán
                                            td.text-muted
                                                - const updatedDate = (product.ngaycapnhat || product.ngaytao) ? new Date(product.ngaycapnhat || product.ngaytao).toLocaleDateString('vi-VN') : '—'
                                                | #{updatedDate}
                        else
                            .empty-state
                                i.bi.bi-inbox.fs-1.text-muted
                                p.text-muted.mt-2 Chưa có sản phẩm nào

            .dashboard-col.col-side
                .dashboard-card
                    .card-header
                        h3.card-title
                            i.bi.bi-pie-chart.me-2
                            | Theo loại sản phẩm
                    .card-body
                        if productsByType && productsByType.length
                            ul.stat-list
                                each item in productsByType
                                    li.stat-list-item
                                        span.stat-name
                                            - const typeLabels = { ao: 'Áo', quan: 'Quần', vay: 'Váy', giay: 'Giày', tui: 'Túi', phukien: 'Phụ kiện' }
                                            | #{typeLabels[item._id] || item._id || 'Khác'}
                                        span.stat-count #{item.count}
                        else
                            p.text-muted.text-center Chưa có dữ liệu

                .dashboard-card
                    .card-header
                        h3.card-title
                            i.bi.bi-people.me-2
                            | Theo giới tính
                    .card-body
                        if productsByGender && productsByGender.length
                            ul.stat-list
                                each item in productsByGender
                                    li.stat-list-item
                                        span.stat-name
                                            - const genderLabels = { nam: 'Nam', nu: 'Nữ', unisex: 'Unisex' }
                                            | #{genderLabels[item._id] || item._id || 'Khác'}
                                        span.stat-count #{item.count}
                        else
                            p.text-muted.text-center Chưa có dữ liệu

                .dashboard-card
                    .card-header
                        h3.card-title
                            i.bi.bi-lightning.me-2
                            | Thao tác nhanh
                    .card-body
                        .quick-actions
                            a.quick-action-btn(href="/admin/products/create")
                                i.bi.bi-plus-circle
                                span Thêm sản phẩm
                            a.quick-action-btn(href="/admin/products")
                                i.bi.bi-list-ul
                                span Danh sách SP

