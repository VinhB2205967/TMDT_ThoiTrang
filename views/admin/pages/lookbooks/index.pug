extends ../../layouts/default.pug

block main
  .container-fluid.py-4
    .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-3.page-header-section.orders-header.admin-page-header
      h1.h4.mb-0 Quản lý Lookbook
      a.btn.btn-header.btn-admin-accent(href="/admin/lookbook/create")
        i.bi.bi-plus-lg.me-1
        | Thêm lookbook

    .card.shadow-sm
      .card-body.p-0
        .table-responsive
          table.table.table-hover.align-middle.mb-0
            thead.table-light
              tr
                th.ps-3 Tên mùa
                th Ảnh
                th.text-center Thứ tự
                th.text-center Số sản phẩm
                th.text-center Trạng thái
                th.text-end.pe-3 Hành động
            tbody
              if lookbooks && lookbooks.length
                each item in lookbooks
                  tr(data-id=item._id)
                    td.ps-3
                      .fw-semibold #{item.title}
                      if item.slug
                        .small.text-muted /lookbook/#{item.slug}
                    td
                      if item.image
                        img.rounded.border(src=item.image alt=item.title style="width:80px;height:60px;object-fit:cover;")
                      else
                        span.text-muted Không có ảnh
                    td.text-center #{item.order || 0}
                    td.text-center #{item.productCount || 0}
                    td.text-center
                      button.btn.btn-sm(type="button" class=item.isActive ? 'btn-success js-toggle' : 'btn-outline-secondary js-toggle' data-active=item.isActive)
                        i.bi(class=item.isActive ? 'bi-eye-fill' : 'bi-eye-slash-fill')
                        span.ms-1 #{item.isActive ? 'Hiển thị' : 'Ẩn'}
                    td.text-end.pe-3
                      .btn-group.btn-group-sm(role="group")
                        a.btn.btn-outline-primary(href=`/admin/lookbook/edit/${item._id}`)
                          i.bi.bi-pencil-square.me-1
                          | Sửa
                        button.btn.btn-outline-danger.js-delete(type="button")
                          i.bi.bi-trash3.me-1
                          | Xóa
              else
                tr
                  td.text-center.text-muted.py-4(colspan="6") Chưa có lookbook nào.

block scripts
  script(src="/admin/js/lookbook-index.js")
