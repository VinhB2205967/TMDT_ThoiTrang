extends ../../layouts/default.pug

block main
  .container-fluid.p-3.admin-workspace.lookbook-admin-page
    .admin-page-header
      .d-flex.justify-content-between.align-items-center.gap-3(style="width: 100%;")
        div
          h3.mb-2 📚 Quản lý Lookbook
          p.text-muted.mb-0 Tổng cộng: 
            strong= lookbooks ? lookbooks.length : 0
            |  lookbook
        a.btn.btn-header.btn-admin-accent(href="/admin/lookbook/create")
          i.bi.bi-plus-lg
          |  Thêm lookbook mới

    if !lookbooks || lookbooks.length === 0
      .admin-empty-state
        .admin-empty-state-icon 📚
        .admin-empty-state-title Chưa có lookbook nào
        .admin-empty-state-description Hãy tạo lookbook đầu tiên để bắt đầu giới thiệu các bộ sưu tập sản phẩm của bạn
        a.btn.btn-header.btn-admin-accent(href="/admin/lookbook/create")
          i.bi.bi-plus-lg
          |  Tạo lookbook ngay
    else
      .admin-entity-list.lookbook-list
        each item in lookbooks
          .admin-gallery-card(data-id=item._id)
            .admin-gallery-card-image(style=item.image ? `background-image: url('${item.image}'); background-size: cover; background-position: center;` : '')
              if !item.image
                .d-flex.align-items-center.justify-content-center.h-100
                  i.bi.bi-image(style="font-size: 48px; color: rgba(107, 114, 128, 0.4);")

            .admin-gallery-card-content
              .admin-gallery-card-title= item.title

              .admin-gallery-card-meta
                .admin-gallery-card-stat
                  .admin-gallery-card-stat-value= item.productCount || 0
                  .admin-gallery-card-stat-label Sản phẩm
                .admin-gallery-card-stat
                  .admin-gallery-card-stat-value= item.order || 0
                  .admin-gallery-card-stat-label Thứ tự

              .admin-gallery-card-status(class=item.isActive ? '' : 'inactive')
                .admin-gallery-card-status-dot
                .admin-gallery-card-status-text
                  if item.isActive
                    | Hiển thị
                  else
                    | Ẩn

              .admin-gallery-card-actions
                a.btn.btn-sm.btn-outline-primary(href=`/admin/lookbook/edit/${item._id}`)
                  i.bi.bi-pencil
                  |  Sửa
                button.btn.btn-sm.btn-outline-danger(type="button" onclick="deleteItem(this)")
                  i.bi.bi-trash
                  |  Xóa

block scripts
  script(src="/admin/js/lookbook-index.js?v=20260410-2")
