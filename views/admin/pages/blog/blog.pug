extends ../../layouts/default.pug

block styles
  link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css')
  link(rel='stylesheet', href='/admin/css/product-editor.css')
  link(rel='stylesheet', href='/admin/css/blog.css')
  style.
    .blog-card-date {
      font-size: 11px;
      color: #8089a3;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

block main
  .container-fluid.p-3.blog-page.admin-workspace
    .admin-page-header
      .d-flex.justify-content-between.align-items-center.gap-3(style="width: 100%;")
        div
          h3.mb-2 ✍️ Quản lý Blog
          p.text-muted.mb-0 Tổng cộng: 
            strong= posts ? posts.length : 0
            |  bài viết
        a.btn.btn-header.btn-admin-accent(href='/admin/blog/create')
          i.bi.bi-plus-lg
          |  Tạo bài viết mới

    if !posts || posts.length === 0
      .admin-empty-state
        .admin-empty-state-icon ✍️
        .admin-empty-state-title Chưa có bài viết nào
        .admin-empty-state-description Hãy tạo bài viết đầu tiên để chia sẻ nội dung với khách hàng
        a.btn.btn-header.btn-admin-accent(href='/admin/blog/create')
          i.bi.bi-plus-lg
          |  Viết bài ngay
    else
      .admin-list-container.blog-list
        each item in posts
          .admin-list-item.admin-blog-row(data-id=item._id)
            .admin-list-item-header
              div
                .admin-list-item-title= item.tieude || 'Không có tiêu đề'
                .admin-list-item-subtitle= item.tomtat || 'Chưa có tóm tắt'
              if item.hinhanh
                img(src=item.hinhanh alt=item.tieude style="width: 100px; height: 75px; object-fit: cover; border-radius: 8px;")

            if item.hinhanh
              img(src=item.hinhanh alt=item.tieude style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px; margin-bottom: 12px;")

            .admin-list-item-content
              .admin-list-item-field
                .admin-list-item-label 📅 Cập nhật
                .admin-list-item-value
                  if item.ngaycapnhat
                    = new Date(item.ngaycapnhat).toLocaleDateString('vi-VN')
                  else
                    span Chưa cập nhật

              .admin-list-item-field
                .admin-list-item-label 📤 Trạng thái
                .admin-list-item-value
                  if item.xuatban
                    span.badge.bg-success Đã xuất bản
                  else
                    span.badge.bg-secondary Nháp

            .d-flex.align-items-center.justify-content-between.gap-2(style="margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(107, 114, 128, 0.2);")
              .admin-list-item-actions
                a.btn.btn-sm.btn-outline-primary(href=`/admin/blog/${item._id}/edit`)
                  i.bi.bi-pencil
                  |  Sửa
                button.btn.btn-sm.btn-outline-secondary(type='button' data-action='publish' data-published=(item.xuatban ? '1' : '0'))
                  i.bi(class=item.xuatban ? 'bi-eye-fill' : 'bi-eye-slash-fill')
                  | #{item.xuatban ? ' Hủy' : ' Xuất bản'}
                button.btn.btn-sm.btn-outline-danger(type='button' data-action='delete')
                  i.bi.bi-trash
                  |  Xóa

block scripts
  script(src='/admin/js/blog-list.js?v=20260410-2')
