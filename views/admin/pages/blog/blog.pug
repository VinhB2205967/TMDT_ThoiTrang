extends ../../layouts/default.pug

block styles
  link(rel='stylesheet', href='/admin/css/blog.css')

block main
  .container-fluid.py-4.blog-page
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3.page-header-section.orders-header.admin-page-header
      div
        h1.h3.mb-1 Quản lý Blog
        p.text-muted.mb-0 Quản lý nội dung bài viết, hình ảnh và trạng thái xuất bản.

    .row.g-3
      .col-12.col-xl-8
        include ./partials/form-blog.pug

      .col-12.col-xl-4
        .card.blog-preview-card
          .card-header.bg-white
            h6.mb-0 Xem trước bài viết
          .card-body
            .blog-preview-media-wrap.mb-3
              img#blogPreviewImage.blog-preview-media.d-none(src='' alt='Ảnh xem trước')
              .blog-preview-media-empty#blogPreviewEmpty
                i.bi.bi-image
                span Chưa chọn ảnh đại diện
            h5#blogPreviewTitle.blog-preview-title Chưa có tiêu đề
            p#blogPreviewSummary.blog-preview-summary Chưa có tóm tắt.
            .blog-preview-content#blogPreviewContent Nội dung bài viết sẽ hiển thị tại đây.
            .mt-3
              span.badge.text-bg-secondary#blogPreviewStatus Nháp

    .card.mt-4
      .card-header.bg-white
        h6.mb-0 Danh sách bài viết
      .card-body
        .table-responsive
          table.table.table-hover.align-middle.blog-table
            thead
              tr
                th(style='min-width: 360px') Nội dung
                th.text-center(style='width: 140px') Xuất bản
                th.text-end(style='width: 220px') Hành động
            tbody
              if posts && posts.length
                each item in posts
                  tr(data-id=item._id)
                    td
                      .d-flex.gap-3
                        if item.hinhanh
                          img.blog-row-thumb(src=item.hinhanh alt=item.tieude)
                        .flex-grow-1
                          input.form-control.form-control-sm.mb-2(type='text' name='tieude' value=item.tieude placeholder='Tiêu đề')
                          textarea.form-control.form-control-sm.mb-2(name='tomtat' rows='2' placeholder='Tóm tắt') #{item.tomtat}
                          textarea.form-control.form-control-sm(name='noidung' rows='4' placeholder='Nội dung') #{item.noidung}
                          input.form-control.form-control-sm.mt-2(type='file' name='image' accept='image/*')
                    td.text-center
                      input.form-check-input(type='checkbox' name='xuatban' checked=item.xuatban)
                    td.text-end
                      .d-flex.justify-content-end.flex-wrap.gap-2
                        button.btn.btn-sm.btn-outline-primary(type='button' data-action='save') Lưu
                        button.btn.btn-sm.btn-outline-secondary(type='button' data-action='publish') Xuất bản
                        button.btn.btn-sm.btn-outline-danger(type='button' data-action='delete') Xóa
              else
                tr
                  td(colspan='3').text-center.text-muted.py-4 Chưa có bài viết nào.

block scripts
  script(src='/admin/js/blog-form.js')
