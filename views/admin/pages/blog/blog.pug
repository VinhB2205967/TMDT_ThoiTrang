extends ../../layouts/default.pug

block styles
  link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css')
  link(rel='stylesheet', href='/admin/css/product-editor.css')
  link(rel='stylesheet', href='/admin/css/blog.css')

block main
  .container-fluid.py-4.blog-page
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3.page-header-section.orders-header.admin-page-header
      div
        h1.h3.mb-1 Quản lý Blog
        p.text-muted.mb-0 Danh sách bài viết hiện có.
      a.btn.btn-primary.btn-add-blog(href='/admin/blog/create')
        i.bi.bi-plus-circle.me-1
        | Tạo bài viết

    .card.mt-2
      .card-header.bg-white
        h6.mb-0 Danh sách bài viết
      .card-body
        .table-responsive
          table.table.table-hover.align-middle.blog-table
            thead
              tr
                th(style='min-width: 420px') Nội dung
                th.text-center(style='width: 140px') Xuất bản
                th.text-end(style='width: 220px') Hành động
            tbody
              if posts && posts.length
                each item in posts
                  tr(data-id=item._id)
                    td
                      .d-flex.gap-3
                        if item.hinhanh
                          img.blog-row-thumb(src=item.hinhanh alt=item.tieude)
                        .flex-grow-1
                          .fw-semibold.mb-1 #{item.tieude || 'Không có tiêu đề'}
                          .small.text-muted.mb-2 #{item.tomtat || 'Chưa có tóm tắt'}
                          .small.text-muted
                            if item.ngaycapnhat
                              | Cập nhật: #{new Date(item.ngaycapnhat).toLocaleString('vi-VN')}
                            else
                              | Chưa có thời gian cập nhật
                    td.text-center
                      if item.xuatban
                        span.badge.text-bg-success Đã xuất bản
                      else
                        span.badge.text-bg-secondary Nháp
                    td.text-end
                      .d-flex.justify-content-end.flex-wrap.gap-2
                        a.btn.btn-sm.btn-outline-primary(href=`/admin/blog/${item._id}/edit`) Sửa
                        button.btn.btn-sm.btn-outline-secondary(type='button' data-action='publish' data-published=(item.xuatban ? '1' : '0')) #{item.xuatban ? 'Hủy xuất bản' : 'Xuất bản'}
                        button.btn.btn-sm.btn-outline-danger(type='button' data-action='delete') Xóa
              else
                tr
                  td(colspan='3').text-center.text-muted.py-4 Chưa có bài viết nào.

block scripts
  script(src='/admin/js/blog-list.js?v=20260403-2')
