extends ../../layouts/default.pug

block styles
  link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css')
  link(rel='stylesheet', href='/admin/css/product-editor.css')
  link(rel='stylesheet', href='/admin/css/blog.css')

block main
  .container-fluid.py-4.blog-page.admin-workspace
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3.page-header-section.orders-header.admin-page-header
      div
        h1.h3.mb-1 Tạo Blog mới
        p.text-muted.mb-0 Tạo nội dung bài viết mới và xem trước trước khi lưu.
      a.btn.btn-outline-secondary(href='/admin/blog')
        i.bi.bi-arrow-left.me-1
        | Quay lại danh sách

    .row.g-3
      .col-12.col-xl-8
        include ./partials/form-blog.pug

      .col-12.col-xl-4
        .card.blog-preview-card
          .card-header.bg-white
            h6.mb-0 Xem trước bài viết
          .card-body
            .blog-preview-media-wrap.mb-3
              img#blogPreviewImage.blog-preview-media.d-none(src='' alt='Ảnh xem trước')
              .blog-preview-media-empty#blogPreviewEmpty
                i.bi.bi-image
                span Chưa chọn ảnh đại diện
            h5#blogPreviewTitle.blog-preview-title Chưa có tiêu đề
            p#blogPreviewSummary.blog-preview-summary Chưa có tóm tắt.
            .blog-preview-content#blogPreviewContent Nội dung bài viết sẽ hiển thị tại đây.
            .mt-3
              span.badge.text-bg-secondary#blogPreviewStatus Nháp

block scripts
  script(src='https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js')
  script.
    window.BlogFormRuntime = {
      mode: 'create',
      submitUrl: '/admin/api/blog',
      submitMethod: 'POST',
      redirectUrl: '/admin/blog',
      initialImage: '',
      isPublished: false
    };
  script(src='/admin/js/blog-rich-editor.js?v=20260403-1')
  script(src='/admin/js/blog-form.js?v=20260403-2')
