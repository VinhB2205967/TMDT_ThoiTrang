extends ../../layouts/default.pug

block styles
  link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css')
  link(rel='stylesheet', href='/admin/css/product-editor.css')
  link(rel='stylesheet', href='/admin/css/blog.css')

block main
  .container-fluid.py-4.blog-page.admin-workspace
    .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3.page-header-section.orders-header.admin-page-header
      div
        h1.h3.mb-1 Chỉnh sửa Blog
        p.text-muted.mb-0 Cập nhật nội dung bài viết trên màn hình riêng.
      a.btn.btn-outline-secondary(href='/admin/blog')
        i.bi.bi-arrow-left.me-1
        | Quay lại danh sách

    .row.g-3
      .col-12.col-xl-8
        include ./partials/form-blog.pug

      .col-12.col-xl-4
        .card.blog-preview-card
          .card-header.bg-white
            h6.mb-0 Xem trước bài viết
          .card-body
            .blog-preview-media-wrap.mb-3
              if blogPost && blogPost.hinhanh
                img#blogPreviewImage.blog-preview-media(src=blogPost.hinhanh alt='Ảnh xem trước')
                .blog-preview-media-empty#blogPreviewEmpty.d-none
                  i.bi.bi-image
                  span Chưa chọn ảnh đại diện
              else
                img#blogPreviewImage.blog-preview-media.d-none(src='' alt='Ảnh xem trước')
                .blog-preview-media-empty#blogPreviewEmpty
                  i.bi.bi-image
                  span Chưa chọn ảnh đại diện
            h5#blogPreviewTitle.blog-preview-title #{(blogPost && blogPost.tieude) || 'Chưa có tiêu đề'}
            p#blogPreviewSummary.blog-preview-summary #{(blogPost && blogPost.tomtat) || 'Chưa có tóm tắt.'}
            .blog-preview-content#blogPreviewContent!= (blogPost && blogPost.noidung) || 'Nội dung bài viết sẽ hiển thị tại đây.'
            .mt-3
              if blogPost && blogPost.xuatban
                span.badge.text-bg-success#blogPreviewStatus Đã chọn xuất bản
              else
                span.badge.text-bg-secondary#blogPreviewStatus Nháp

block scripts
  script(src='https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js')
  script.
    window.BlogFormRuntime = {
      mode: 'edit',
      submitUrl: !{JSON.stringify(`/admin/api/blog/${blogPost ? blogPost._id : ''}`)},
      submitMethod: 'PUT',
      redirectUrl: '/admin/blog',
      initialImage: !{JSON.stringify((blogPost && blogPost.hinhanh) || '')},
      isPublished: !{JSON.stringify(Boolean(blogPost && blogPost.xuatban))}
    };
  script(src='/admin/js/blog-rich-editor.js?v=20260403-1')
  script(src='/admin/js/blog-form.js?v=20260403-2')
