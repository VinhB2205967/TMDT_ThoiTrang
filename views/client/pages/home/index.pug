extends ../../layouts/default.pug

block main
    - const getSection = (k) => (sections || []).find(s => s.key === k)
    - const isActive = (k) => {
    -   const s = getSection(k)
    -   return s ? s.hienthi !== false : false
    - }

    if isActive('banner_slider') && banners && banners.length
        section.banner-section.home-hero
            .hero-ambient
                span.hero-orb.hero-orb-1
                span.hero-orb.hero-orb-2
                span.hero-orb.hero-orb-3
            #bannerCarousel.carousel.slide(data-bs-ride="carousel")
                .carousel-indicators
                    each banner, idx in banners
                        button(type="button" data-bs-target="#bannerCarousel" data-bs-slide-to=idx class=idx === 0 ? 'active' : '' aria-current=idx === 0 ? 'true' : 'false')
                .carousel-inner
                    each banner, idx in banners
                        .carousel-item(class=idx === 0 ? 'active' : '')
                            .banner-slide(style=`background-image:url('${banner.hinhanh}')`)
                                .container
                                    .banner-content.hero-panel
                                        .hero-kicker
                                            i.bi.bi-stars
                                            span New season • Dark fashion
                                        if banner.tieude
                                            h2.banner-title #{banner.tieude}
                                        if banner.mota
                                            p.banner-subtitle #{banner.mota}
                                        .hero-actions
                                            if banner.nut_text && banner.nut_link
                                                a.btn.btn-banner(href=banner.nut_link)
                                                    span #{banner.nut_text}
                                                    i.bi.bi-arrow-right
                                            a.btn.btn-ghost-hero(href="/products") Khám phá ngay
                                        .hero-stats
                                            .hero-stat
                                                strong 500+
                                                span Mẫu mới
                                            .hero-stat
                                                strong 24h
                                                span Giao nhanh
                                            .hero-stat
                                                strong 4.9
                                                span Đánh giá
                button.carousel-control-prev(type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev")
                    span.carousel-control-prev-icon
                button.carousel-control-next(type="button" data-bs-target="#bannerCarousel" data-bs-slide="next")
                    span.carousel-control-next-icon

    //- Quick Links / Features
    section.features-section.home-strip
        .container
            .features-grid
                .feature-item
                    .feature-icon
                        i.bi.bi-truck
                    .feature-text
                        h5 Miễn phí vận chuyển
                        p Đơn hàng từ 500K
                .feature-item
                    .feature-icon
                        i.bi.bi-arrow-repeat
                    .feature-text
                        h5 Đổi trả dễ dàng
                        p Trong 7 ngày
                .feature-item
                    .feature-icon
                        i.bi.bi-shield-check
                    .feature-text
                        h5 Sản phẩm chính hãng
                        p 100% authentic
                .feature-item
                    .feature-icon
                        i.bi.bi-headset
                    .feature-text
                        h5 Hỗ trợ 24/7
                        p Hotline: 1900-xxxx

    //- Danh mục sản phẩm
    section.categories-section.home-categories
        .container
            .categories-header
                .section-eyebrow
                    i.bi.bi-grid-3x3-gap-fill
                    span Mua sắm nhanh
                h3.categories-title Danh mục nổi bật
                p.categories-subtitle Chọn phong cách, hệ thống gợi ý sản phẩm phù hợp tức thì.
            .categories-grid
                a.category-item(href="/products?loaisanpham=ao")
                    .category-icon
                        img(src="/images/shirt.png" alt="Áo")
                    span Áo
                a.category-item(href="/products?loaisanpham=quan")
                    .category-icon
                        img(src="/images/shorts.png" alt="Quần")
                    span Quần
                a.category-item(href="/products?loaisanpham=vay")
                    .category-icon
                        img(src="/images/dress.png" alt="Váy")
                    span Váy
                a.category-item(href="/products?loaisanpham=giay")
                    .category-icon
                        img(src="/images/shoes.png" alt="Giày")
                    span Giày
                a.category-item(href="/products?loaisanpham=tui")
                    .category-icon
                        img(src="/images/handbag.png" alt="Túi")
                    span Túi
                a.category-item(href="/products?loaisanpham=phukien")
                    .category-icon
                        img(src="/images/bow.png" alt="Phụ kiện")
                    span Phụ kiện
                a.category-item(href="/products?gioitinh=nam")
                    .category-icon
                        i.bi.bi-gender-male
                    span Thời trang Nam
                a.category-item(href="/products?gioitinh=nu")
                    .category-icon
                        i.bi.bi-gender-female
                    span Thời trang Nữ

    if sections && sections.length
        each section in sections
            if section.key === 'flash_sale' && isActive('flash_sale') && flashSale && flashSale.products && flashSale.products.length
                section.flash-sale-section.home-section-shell(data-flash-end=flashSaleEnd data-flash-start=flashSaleStart)
                    .container
                        .section-header.flash-sale-header
                            .section-title-wrap
                                .section-eyebrow
                                    i.bi.bi-lightning-charge-fill.text-warning
                                    span Deal trong ngày
                                h2.section-title FLASH SALE
                            if flashSale.sale
                                .countdown
                                    span.countdown-label Kết thúc sau:
                                    .countdown-timer
                                        span.countdown-item#hours 00
                                        span.countdown-sep :
                                        span.countdown-item#minutes 00
                                        span.countdown-sep :
                                        span.countdown-item#seconds 00
                        .products-grid
                            each product in flashSaleProducts
                                +productCard(product)

            if section.key === 'brands' && isActive('brands') && brands && brands.length
                section.brand-section.home-section-shell
                    .container
                        .section-header
                            .section-title-wrap
                                .section-eyebrow
                                    i.bi.bi-award
                                    span Curated labels
                                h2.section-title Thương hiệu nổi bật
                        .row.g-3.align-items-center
                            each brand in brands
                                .col-6.col-md-3.col-lg-2
                                    a.brand-item.d-block.text-center(href=`/brands/${brand.slug || brand._id}`)
                                        img.img-fluid(src=brand.logo alt=brand.ten)

            if section.key === 'lookbook' && isActive('lookbook') && lookbooks && lookbooks.length
                section.lookbook-section.home-section-shell
                    .container
                        .section-header
                            .section-title-wrap
                                .section-eyebrow
                                    i.bi.bi-camera
                                    span Style inspiration
                                h2.section-title Lookbook theo mùa
                        .row.g-3
                            each book in lookbooks
                                .col-12.col-md-6.col-lg-4
                                    a.card.h-100.text-decoration-none.text-dark.home-story-card(href=`/lookbook/${book.slug || book._id}`)
                                        if book.image
                                            img.card-img-top(src=book.image alt=book.title)
                                        .card-body
                                            h5.card-title #{book.title}
                                            if book.descriptionPreview
                                                p.card-text.lookbook-card-desc #{book.descriptionPreview}
                                            if book.products && book.products.length
                                                .d-flex.justify-content-between.align-items-center
                                                    span.badge.bg-light.text-dark #{book.products.length} sản phẩm
                                                    span.btn.btn-sm.btn-primary Xem bộ sưu tập

            if section.key === 'blog' && isActive('blog') && blogs && blogs.length
                section.blog-section.home-section-shell
                    .container
                        .section-header
                            .section-title-wrap
                                .section-eyebrow
                                    i.bi.bi-journal-text
                                    span Fashion journal
                                h2.section-title Blog thời trang
                            a.view-all(href="/blog") Xem tất cả
                                i.bi.bi-arrow-right.ms-1
                        .row.g-3
                            each post in blogs
                                .col-12.col-md-6.col-lg-4
                                    a.card.h-100.text-decoration-none.text-dark.home-story-card(href=`/blog/${post.slug}`)
                                        if post.hinhanh
                                            img.card-img-top(src=post.hinhanh alt=post.tieude)
                                        .card-body
                                            h5.card-title #{post.tieude}
                                            if post.tomtat
                                                p.card-text #{post.tomtat}

            if section.key === 'new_products' && isActive('new_products')
                section.products-section.home-section-shell
                    .container
                        .section-header
                            .section-title-wrap
                                .section-eyebrow
                                    i.bi.bi-stars
                                    span Fresh drops
                                h2.section-title Sản phẩm mới
                            a.view-all(href="/products?sort=ngaytao-desc") Xem tất cả
                                i.bi.bi-arrow-right.ms-1
                        if newProducts && newProducts.length
                            .products-grid
                                each product in newProducts
                                    +productCard(product)
                        else
                            .text-center.py-5.text-muted
                                i.bi.bi-box-seam.fs-1.d-block.mb-3
                                p Chưa có sản phẩm nào

            if section.key === 'best_sellers' && isActive('best_sellers')
                section.products-section.home-section-shell
                    .container
                        .section-header
                            .section-title-wrap
                                .section-eyebrow
                                    i.bi.bi-fire.text-danger
                                    span Trending now
                                h2.section-title Bán chạy nhất
                            a.view-all(href="/products") Xem tất cả
                                i.bi.bi-arrow-right.ms-1
                        if bestSellerProducts && bestSellerProducts.length
                            .products-grid
                                each product in bestSellerProducts
                                    +productCard(product)
                        else
                            .text-center.py-5.text-muted
                                i.bi.bi-graph-up.fs-1.d-block.mb-3
                                p Đang cập nhật



//- Mixin Product Card
mixin productCard(product)
    .product-card(data-product-id=product._id)
        a.product-link(href=`/products/${product._id}`)
            .product-image
                img(src=product.displayImage || product.hinhanh || '/images/shopping.png' alt=product.tensanpham)
                - const gocGia = Number(product.gia || 0)
                - const giamGiaCoSan = Number(product.phantramgiamgia || 0)
                - const flashGia = Number(product.flashSalePrice || 0)
                - const flashPercentFromData = Number(product.flashSalePercent || 0)
                - const flashGiaTheoPhanTram = (flashPercentFromData > 0 && gocGia > 0) ? Math.round(gocGia * (100 - flashPercentFromData) / 100) : 0
                - const flashGiaHienThi = flashGiaTheoPhanTram > 0 ? flashGiaTheoPhanTram : flashGia
                - const giamTheoFlash = flashPercentFromData > 0 ? flashPercentFromData : ((gocGia > 0 && flashGia > 0 && flashGia < gocGia) ? Math.round(((gocGia - flashGia) / gocGia) * 100) : 0)
                - const phanTramGiamHienThi = flashGiaHienThi > 0 ? giamTheoFlash : giamGiaCoSan
                - const coGiamPhanTram = phanTramGiamHienThi > 0
                if (product.badges && product.badges.length) || coGiamPhanTram
                    .product-badges
                        each badge in product.badges
                            span.badge.badge-pill= badge
                        if coGiamPhanTram
                            span.badge.badge-pill.badge-discount -#{phanTramGiamHienThi}%
                .product-top-actions
                    button.btn-icon.btn-view(type="button" title="Xem nhanh")
                        i.bi.bi-eye
                    button.btn-icon.btn-wishlist(type="button" title="Yêu thích")
                        i.bi.bi-heart
                .product-bottom-actions
                    button.btn-add-cart(type="button" title="Thêm vào giỏ")
                        i.bi.bi-cart-plus
                    button.btn-buy-now(type="button" title="Mua ngay")
                        i.bi.bi-lightning-fill
                        span Mua ngay
        .product-info
            h3.product-name #{product.tensanpham}
            if product.bienthe && product.bienthe.length
                .variant-thumbs
                    - const allHomeThumbs = Array.isArray(product.thumbImages) ? product.thumbImages : []
                    - const homeThumbs = allHomeThumbs.slice(0, 5)
                    - const hasHomeMainThumb = allHomeThumbs.length > 0 && allHomeThumbs[0].isMain
                    - const totalHomeVariantThumbs = Math.max(0, allHomeThumbs.length - (hasHomeMainThumb ? 1 : 0))
                    - const shownHomeVariantThumbs = Math.max(0, homeThumbs.length - (hasHomeMainThumb ? 1 : 0))
                    each thumb in homeThumbs
                        img.variant-thumb(src=thumb.src alt=thumb.alt title=thumb.title)
                    if totalHomeVariantThumbs > shownHomeVariantThumbs
                        span.more-variants +#{totalHomeVariantThumbs - shownHomeVariantThumbs}
            .product-price
                if flashGiaHienThi > 0
                    - const flashText = flashGiaHienThi.toLocaleString('vi-VN') + '₫'
                    span.price-original #{product.giaText || (product.gia ? product.gia.toLocaleString('vi-VN') + '₫' : '')}
                    span.price-sale #{flashText}
                else if product.phantramgiamgia > 0
                    span.price-original #{product.giaText || (product.gia ? product.gia.toLocaleString('vi-VN') + '₫' : '')}
                    span.price-sale #{product.giamoiText || ((product.gia * (100 - product.phantramgiamgia) / 100).toLocaleString('vi-VN') + '₫')}
                else
                    span.price-sale #{product.giaText || (product.gia ? product.gia.toLocaleString('vi-VN') + '₫' : '—')}
            .product-footer
                .product-rating
                    - const rating = product.avgRating || 0
                    - const fullStars = Math.floor(rating)
                    - const halfStar = rating % 1 >= 0.5
                    each val in Array(fullStars)
                        i.bi.bi-star-fill
                    if halfStar
                        i.bi.bi-star-half
                    each val in Array(5 - fullStars - (halfStar ? 1 : 0))
                        i.bi.bi-star
                span.sold-count.sold-count--highlight
                    if rating
                        span.fw-semibold #{rating.toFixed(1)}
                        span.text-muted.small  /5
                        span.text-muted.small &nbsp;•&nbsp;
                    span.text-muted.small #{product.reviewCount || 0} đánh giá
                    span.text-muted.small &nbsp;•&nbsp;đã bán #{product.soldCount || 0}

block scripts
    script(src="/js/home.js")