extends ../../layouts/default.pug
include ../../mixins/box_head.pug
block styles
    link(rel="stylesheet" href="/css/products.css")

block main
    .products-section
        .container
            +box-head('Danh Sách Sản Phẩm')
            
            //- Filter & Sort bar (responsive)
            .filter-bar.mb-4
                if openclipMessage
                    .alert.alert-dismissible.fade.show.js-auto-dismiss-alert(class=(openclipMode ? 'alert-success' : 'alert-warning') role='alert')
                        | #{openclipMessage}
                        button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Đóng')
                if openclipMode && openclipPreview
                    .openclip-query-preview.mb-3
                        .openclip-query-preview__media
                            img(src=openclipPreview alt="Ảnh tìm kiếm" loading="lazy")
                        .openclip-query-preview__content
                            span.openclip-query-preview__eyebrow Ảnh đang dùng để tìm
                            strong.openclip-query-preview__title Kết quả được sắp xếp từ ảnh bạn vừa tải lên
                            p.openclip-query-preview__text Bạn có thể tiếp tục lọc theo loại, giá, giới tính hoặc thương hiệu mà vẫn giữ nguyên ảnh tìm kiếm.
                form#filterForm(method="GET" action="/products")
                    if openclipMode && openclipIdsValue
                        input(type="hidden" name="openclip_ids" value=openclipIdsValue)
                    if openclipMode && openclipPreview
                        input(type="hidden" name="openclip_preview" value=openclipPreview)
                    .row.g-3
                        .col-md-2.filter-col.filter-col--type
                            select.form-select(name="loaisanpham")
                                option(value="" selected=!currentLoai) Tất cả loại
                                each c in (categoryOptions || [])
                                    option(value=c.slug selected=(String(currentLoai || '') === String(c.slug || ''))) #{c.name}
                        
                        //- Gender filter
                        .col-md-2.filter-col.filter-col--gender
                            select.form-select(name="gioitinh")
                                option(value="" selected=!currentGioiTinh) Giới tính
                                option(value="nam" selected=(currentGioiTinh === 'nam')) Nam
                                option(value="nu" selected=(currentGioiTinh === 'nu')) Nữ
                                option(value="unisex" selected=(currentGioiTinh === 'unisex')) Unisex

                        .col-md-2.filter-col.filter-col--brand
                            select.form-select(name="brand")
                                option(value="" selected=!currentBrand) Tất cả thương hiệu
                                each b in (brandOptions || [])
                                    option(value=b._id selected=(String(currentBrand || '') === String(b._id))) #{b.ten}

                        .col-md-2.filter-col.filter-col--occasion
                            select.form-select(name="occasion")
                                option(value="" selected=!currentOccasion) Dịp sử dụng
                                each c in (occasionOptions || [])
                                    option(value=c._id selected=(String(currentOccasion || '') === String(c._id))) #{c.name}

                        .col-md-2.filter-col.filter-col--age-group
                            select.form-select(name="ageGroup")
                                option(value="" selected=!currentAgeGroup) Nhóm tuổi
                                each c in (ageGroupOptions || [])
                                    option(value=c._id selected=(String(currentAgeGroup || '') === String(c._id))) #{c.name}
                        
                        //- Price range
                        .col-md-2.filter-col.filter-col--price-min
                            input.form-control(type="number" name="priceMin" placeholder="Giá từ" value=priceMin)
                        .col-md-2.filter-col.filter-col--price-max
                            input.form-control(type="number" name="priceMax" placeholder="Giá đến" value=priceMax)
                        
                        //- Sort
                        .col-md-2.filter-col.filter-col--sort
                            select.form-select(name="sort")
                                option(value="" selected=!currentSort) Mặc định
                                option(value="gia-asc" selected=(currentSort === 'gia-asc')) Giá: Thấp → Cao
                                option(value="gia-desc" selected=(currentSort === 'gia-desc')) Giá: Cao → Thấp
                                option(value="ngaytao-desc" selected=(currentSort === 'ngaytao-desc')) Mới nhất
                                option(value="tensanpham-asc" selected=(currentSort === 'tensanpham-asc')) Tên A-Z
                        
                        .col-md-3.filter-col.filter-col--actions
                            .d-flex.gap-2
                                button.btn.btn-primary(type="submit") Lọc
                                a.btn.btn-secondary(href="/products") Xóa bộ lọc
                
                .filter-info.mt-3
                    span.text-muted Hiển thị 
                    strong #{products ? products.length : 0}
                    span.text-muted  sản phẩm
            
            if products && products.length
                .row.g-3.g-md-4
                    each item in products
                        .col-6.col-sm-6.col-md-4.col-lg-3
                            .product-card.h-100(data-product-id=item._id)
                                a.product-card-link(href=`/products/${item._id}`)
                                    .product-image
                                        img(src=item.hinhanh alt=item.tensanpham loading="lazy")
                                        if item.phantramgiamgia && item.phantramgiamgia > 0
                                            .discount-badge
                                                | -#{item.phantramgiamgia}%
                                    .product-info
                                        h3.product-name #{item.tensanpham}
                                        if item.bienthe && item.bienthe.length
                                            .product-variants
                                                - const allProductThumbs = Array.isArray(item.thumbImages) ? item.thumbImages : []
                                                - const productThumbs = allProductThumbs.slice(0, 5)
                                                - const hasMainThumb = allProductThumbs.length > 0 && allProductThumbs[0].isMain
                                                - const totalVariantThumbs = Math.max(0, allProductThumbs.length - (hasMainThumb ? 1 : 0))
                                                - const shownVariantThumbs = Math.max(0, productThumbs.length - (hasMainThumb ? 1 : 0))
                                                each thumb in productThumbs
                                                    img.variant-img(src=thumb.src alt=thumb.alt title=thumb.title)
                                                if totalVariantThumbs > shownVariantThumbs
                                                    span.variant-more +#{totalVariantThumbs - shownVariantThumbs}
                                        .product-price
                                            if item.phantramgiamgia && item.phantramgiamgia > 0
                                                span.original-price #{item.giaText}
                                            span.sale-price #{item.giamoiText}
                                        .product-rating
                                            .stars
                                                - const avg = item.avgRating || 0
                                                - for (let i = 1; i <= 5; i++)
                                                    if avg >= i
                                                        i.fas.fa-star
                                                    else if avg >= (i - 0.5)
                                                        i.fas.fa-star-half-alt
                                                    else
                                                        i.far.fa-star
                                            span.review-count #{avg ? (avg.toFixed(1) + ' • ') : ''}#{item.reviewCount || 0} đánh giá • đã bán #{item.soldCount || 0}
                                .product-actions
                                    a.btn-buy-now(href=`/products/${item._id}`)
                                        i.bi.bi-lightning-fill.me-1
                                        | Mua ngay
                                    button.btn-add-cart(type="button" title="Thêm vào giỏ")
                                        i.bi.bi-cart-plus
                                button.btn-wishlist-float(type='button' title="Yêu thích")
                                    i.bi.bi-heart
            else
                .text-center.py-5
                    i.bi.bi-bag-x.display-1.text-muted
                    p.text-muted.mt-3 Không tìm thấy sản phẩm nào.

block scripts
    script(src="/js/products.js")
    script.
        (function () {
            const alerts = document.querySelectorAll('.js-auto-dismiss-alert');
            if (!alerts.length) return;

            window.setTimeout(function () {
                alerts.forEach(function (el) {
                    if (!el || !el.parentNode) return;
                    if (window.bootstrap && window.bootstrap.Alert) {
                        window.bootstrap.Alert.getOrCreateInstance(el).close();
                        return;
                    }
                    el.classList.remove('show');
                    el.classList.add('hide');
                    window.setTimeout(function () {
                        if (el && el.parentNode) el.parentNode.removeChild(el);
                    }, 150);
                });
            }, 5000);
        })();
