extends ../../layouts/default.pug

block main
  .container.py-4.order-detail-page
    if !order
      h1.mb-3 Không tìm thấy đơn hàng
      p.text-muted Đơn hàng không tồn tại hoặc bạn không có quyền xem.
      a.btn.btn-primary(href='/orders') Quay lại danh sách đơn hàng
    else
      - const statusLabels = locals.statusLabels || { all: 'Tất cả', choxacnhan: 'Chờ xác nhận', daxacnhan: 'Đã xác nhận', dangchuanbi: 'Đang chuẩn bị', danggiao: 'Đang giao', dagiao: 'Đã giao', requested_return: 'Yêu cầu hoàn hàng', approved_return: 'Đã duyệt hoàn hàng', rejected_return: 'Từ chối hoàn hàng', return_shipping: 'Đang gửi hàng hoàn', returned: 'Đã nhận hàng hoàn', returned_full: 'Đã trả hàng', returned_partial: 'Trả hàng một phần', refunded: 'Đã hoàn tiền', dahuy: 'Đã hủy', hoanhang: 'Hoàn hàng' }
      - const isChoThanhToan = order.trangthai === 'choxacnhan' && (order.phuongthucthanhtoan === 'momo' || order.phuongthucthanhtoan === 'vnpay') && !order.dathanhtoan
      - const isDaThanhToanChoXacNhan = order.trangthai === 'choxacnhan' && (order.phuongthucthanhtoan === 'momo' || order.phuongthucthanhtoan === 'vnpay') && order.dathanhtoan
      - const label = isChoThanhToan ? 'Chờ thanh toán' : (isDaThanhToanChoXacNhan ? 'Đã thanh toán' : (statusLabels[order.trangthai] || order.trangthai || '—'))
      - const rs = refundSummary || {}
      - const rsOriginal = rs.original || {}
      - const rsRefund = rs.refund || {}
      - const rsRemain = rs.remaining || {}
      - const cancelInfoData = cancelInfo || {}
      - const paymentMethod = String(order.phuongthucthanhtoan || '').toLowerCase()
      - const paymentMethodLabel = paymentMethod === 'momo' ? 'MoMo' : (paymentMethod === 'vnpay' ? 'Thanh toán online' : (paymentMethod === 'cod' ? 'COD' : (order.phuongthucthanhtoan || '—')))

      .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2.mb-3
        div
          h1.mb-1 Chi tiết đơn hàng
          .text-muted.small.d-inline-flex.align-items-center.gap-2
            span #{order.madonhang || order._id}
            button.copy-order-btn(type='button' data-copy-text=(order.madonhang || order._id) data-copy-label='Mã đơn' title='Sao chép mã đơn' aria-label='Sao chép mã đơn')
              i.bi.bi-clipboard
        .d-flex.align-items-center.gap-2
          span.badge.order-status(data-status=order.trangthai) #{label}
          a.btn.btn-sm.btn-outline-secondary(href='/orders') Quay lại

      .d-flex.flex-wrap.gap-2.mb-3
        button.btn.btn-sm.btn-outline-dark(type='button' data-bs-toggle='modal' data-bs-target='#refundPolicyModal')
          i.bi.bi-file-text.me-1
          | Xem chính sách hoàn tiền
        if isChoThanhToan
          form(method='POST', action=`/orders/${order._id}/pay`)
            button.btn.btn-sm.btn-primary(type='submit') Thanh toán ngay
          if order.phuongthucthanhtoan === 'momo'
            .text-muted.small.ms-1(data-payment-pending='1' data-order-id=`${order._id}` data-payment-method='momo')
              | Đang kiểm tra thanh toán MoMo...
          if (order.phuongthucthanhtoan === 'momo' || order.phuongthucthanhtoan === 'vnpay') && order.paymentDeadline
            .text-muted.small.ms-1(data-payment-deadline=order.paymentDeadline data-payment-countdown='1')
              | Còn: --:--:-- (hạn 24h)
        if order.trangthai === 'choxacnhan'
          form(method='POST', action=`/orders/${order._id}/cancel`)
            button.btn.btn-sm.btn-outline-danger(type='submit' onclick="return confirm('Bạn muốn hủy đơn hàng này?')")
              i.bi.bi-x-circle.me-1
              | Hủy đơn

        if order.trangthai === 'dahuy'
          form(method='POST', action=`/orders/${order._id}/reorder`)
            button.btn.btn-sm.btn-outline-success(type='submit')
              i.bi.bi-arrow-repeat.me-1
              | Mua lại

        if returnEligible
          button.btn.btn-sm.btn-outline-warning(type='button' data-bs-toggle='modal' data-bs-target='#returnRequestModal')
            i.bi.bi-arrow-counterclockwise.me-1
            | Yêu cầu hoàn hàng

        if order.trangthai === 'requested_return'
          form(method='POST', action=`/orders/${order._id}/return-request/cancel`)
            button.btn.btn-sm.btn-outline-danger(type='submit' onclick="return confirm('Bạn muốn hủy yêu cầu hoàn hàng này?')")
              i.bi.bi-x-circle.me-1
              | Hủy yêu cầu hoàn

      if ['requested_return','approved_return','rejected_return','return_shipping','returned','returned_partial','returned_full','refunded'].includes(order.trangthai)
        .alert.alert-warning.py-2.small
          strong Trạng thái hoàn hàng:
          |  #{statusLabels[order.trangthai] || order.trangthai}
          if order.yeucauhoanhang && order.yeucauhoanhang.adminNote
            br
            | Ghi chú admin: #{order.yeucauhoanhang.adminNote}

      if order.trangthai === 'dahuy' && cancelInfoData.canceledBySeller && cancelInfoData.reason
        .alert.alert-danger.py-3.mb-3
          .fw-semibold.mb-1 Shop đã hủy đơn hàng này
          .small.mb-1
            strong Lý do:
            |  #{cancelInfoData.reason}
          if cancelInfoData.canceledAt
            .small.text-muted
              | Thời gian: #{new Date(cancelInfoData.canceledAt).toLocaleString('vi-VN')}

      .row.g-3
        .col-lg-7
          .card
            .card-body
              .fw-semibold.mb-2 Thông tin giao hàng
              .row.g-2
                .col-md-6
                  .text-muted.small Người nhận
                  .fw-semibold #{order.tennguoinhan || '—'}
                .col-md-6
                  .text-muted.small Số điện thoại
                  .fw-semibold #{order.sodienthoai || '—'}
                .col-12
                  .text-muted.small Địa chỉ
                  .fw-semibold #{order.diachigiao || '—'}

              if order.ghichu
                .mt-2
                  .text-muted.small Ghi chú
                  .fw-semibold #{order.ghichu}

              hr
              .fw-semibold.mb-2 Thanh toán
              .d-flex.justify-content-between
                span.text-muted Phương thức
                span.fw-semibold #{paymentMethodLabel}
              if order.trangthai === 'choxacnhan' && !order.dathanhtoan
                .mt-2
                  form.order-payment-form(method='POST', action=`/orders/${order._id}/change-payment` data-auto-submit='payment-method')
                    .order-payment-controls
                      span.text-muted Đổi phương thức
                      select.form-select.form-select-sm.order-payment-select(name='phuongthucthanhtoan')
                        option(value='cod' selected=(order.phuongthucthanhtoan === 'cod')) COD
                        option(value='momo' selected=(order.phuongthucthanhtoan === 'momo')) MoMo
              if isChoThanhToan || isDaThanhToanChoXacNhan
                .d-flex.justify-content-between
                  span.text-muted Trạng thái thanh toán
                  span.fw-semibold #{isChoThanhToan ? 'Chờ thanh toán' : 'Đã thanh toán'}
              if order.ngaytao
                .d-flex.justify-content-between
                  span.text-muted Ngày đặt
                  span.fw-semibold #{new Date(order.ngaytao).toLocaleString('vi-VN')}

        .col-lg-5
          .card
            .card-body
              .fw-semibold.mb-2 Sản phẩm
              if items && items.length
                each it in items
                  - const __lineTotal = (it.thanhtien || ((it.giaban || 0) * (it.soluong || 1)) || 0)
                  - const __rf = rs.perItem && rs.perItem[String(it._id)] ? rs.perItem[String(it._id)] : null
                  - const __productHref = it.sanpham_id ? `/products/${it.sanpham_id}` : ''
                  .d-flex.justify-content-between.align-items-start.py-2.border-bottom.order-product-row
                    if __productHref
                      a.d-flex.gap-2.flex-grow-1.order-product-main.text-decoration-none.text-reset(href=__productHref title='Xem chi tiết sản phẩm')
                        img.rounded.border(src=(it.hinhanh || '/images/shopping.png') alt=(it.tensanpham || 'Sản phẩm') width='56' height='56' style='object-fit: cover;')
                        .me-2
                          .fw-semibold #{it.tensanpham}
                          .small.text-muted
                            | #{it.mausac || ''}#{it.kichco ? (' - ' + it.kichco) : ''} x#{it.soluong || 1}
                          if __rf && __rf.returnedQty > 0
                            .small.fw-semibold.text-success Đã hoàn #{__rf.returnedQty}/#{__rf.boughtQty || it.soluong || 0}
                    else
                      .d-flex.gap-2.flex-grow-1.order-product-main
                        img.rounded.border(src=(it.hinhanh || '/images/shopping.png') alt=(it.tensanpham || 'Sản phẩm') width='56' height='56' style='object-fit: cover;')
                        .me-2
                          .fw-semibold #{it.tensanpham}
                          .small.text-muted
                            | #{it.mausac || ''}#{it.kichco ? (' - ' + it.kichco) : ''} x#{it.soluong || 1}
                          if __rf && __rf.returnedQty > 0
                            .small.fw-semibold.text-success Đã hoàn #{__rf.returnedQty}/#{__rf.boughtQty || it.soluong || 0}
                    .text-end.order-product-meta
                      .fw-semibold #{__lineTotal.toLocaleString('vi-VN')}đ
                      if order.trangthai === 'dagiao'
                        if it.daDanhGia
                          a.review-link.review-link--edit.mt-1(href=`/reviews/${it.reviewId}/edit#review-form`) Đã đánh giá • Sửa
                        else
                          a.review-link.review-link--new.mt-1(href=`/reviews/new?orderId=${order._id}&itemId=${it._id}&productId=${it.sanpham_id}#review-form`) Đánh giá
              else
                p.text-muted.small Không có sản phẩm.

              hr
              .partial-refund-wrap
                .partial-refund-section
                  .partial-refund-title 1. Tổng đơn ban đầu
                  .partial-refund-row
                    span Tổng tiền hàng
                    strong #{(rsOriginal.goodsSubtotal || 0).toLocaleString('vi-VN')}đ
                  .partial-refund-row
                    span Voucher giảm giá
                    strong.text-danger -#{(rsOriginal.voucherDiscount || 0).toLocaleString('vi-VN')}đ
                  .partial-refund-row
                    span Phí vận chuyển
                    strong #{(rsOriginal.shippingFee || 0).toLocaleString('vi-VN')}đ
                  .partial-refund-row.partial-refund-row--main
                    span Tổng thanh toán ban đầu
                    strong #{(rsOriginal.payable || 0).toLocaleString('vi-VN')}đ

                .partial-refund-section
                  .d-flex.justify-content-between.align-items-center.gap-2
                    .partial-refund-title.mb-0 2. Thông tin hoàn hàng
                    if rs.hasReturnFlow
                      span.badge.text-bg-light #{rsRefund.statusLabel || 'Đang xử lý'}
                  if rs.hasReturnFlow
                    .partial-refund-row
                      span Số lượng đã hoàn
                      strong #{rsRefund.totalReturnedQty || 0}
                    if rsRefund.items && rsRefund.items.length
                      .partial-refund-list
                        each rf in rsRefund.items
                          .partial-refund-list__item
                            .small.fw-semibold #{rf.name}
                            .small.text-muted #{[rf.color, rf.size].filter(Boolean).join(' - ') || 'Mặc định'} • Đã hoàn #{rf.returnedQty}/#{rf.boughtQty}
                            .small.fw-semibold.text-danger -#{(rf.amount || 0).toLocaleString('vi-VN')}đ
                    else if rsRefund.requestedItems && rsRefund.requestedItems.length
                      .partial-refund-list
                        each rr in rsRefund.requestedItems
                          .partial-refund-list__item
                            .small.fw-semibold #{rr.name}
                            .small.text-muted #{[rr.color, rr.size].filter(Boolean).join(' - ') || 'Mặc định'} • Yêu cầu hoàn #{rr.requestedQty}/#{rr.boughtQty || 0}
                    else
                      .small.text-muted.mb-2 Chưa có sản phẩm đã hoàn.
                    .partial-refund-row.partial-refund-row--refund
                      span Đã hoàn tiền
                      strong.text-danger -#{(rsRefund.amount || 0).toLocaleString('vi-VN')}đ
                    .partial-refund-progress
                      span.partial-refund-step(class=(rsRefund.progress && rsRefund.progress.approved) ? 'is-done' : '') Đã duyệt
                      span.partial-refund-step(class=(rsRefund.progress && rsRefund.progress.received) ? 'is-done' : '') Đã nhận hàng
                      span.partial-refund-step(class=(rsRefund.progress && rsRefund.progress.refunded) ? 'is-done' : '') Đã hoàn tiền
                  else
                    .small.text-muted Chưa phát sinh hoàn hàng.

                .partial-refund-section
                  .partial-refund-title 3. Giá trị đơn hàng còn lại
                  if rsRemain.items && rsRemain.items.length
                    .partial-refund-list
                      each rk in rsRemain.items
                        .partial-refund-list__item
                          .small.fw-semibold #{rk.name}
                          .small.text-muted #{[rk.color, rk.size].filter(Boolean).join(' - ') || 'Mặc định'} • Giữ lại #{rk.keptQty}/#{rk.boughtQty}
                          .small.fw-semibold #{(rk.amount || 0).toLocaleString('vi-VN')}đ
                  else
                    .small.text-muted.mb-2 Không còn sản phẩm giữ lại.
                  .partial-refund-row
                    span Giá trị sản phẩm giữ lại
                    strong #{(rsRemain.goodsValue || 0).toLocaleString('vi-VN')}đ
                  .partial-refund-row
                    span Voucher phân bổ cho sản phẩm giữ lại
                    strong.text-danger -#{(rsRemain.voucherAllocated || 0).toLocaleString('vi-VN')}đ
                  .partial-refund-row
                    span Giá trị còn lại sau hoàn
                    strong #{(rsRemain.goodsAfterVoucher || 0).toLocaleString('vi-VN')}đ
                  .partial-refund-row
                    span Phí vận chuyển
                    strong #{(rsOriginal.shippingFee || 0).toLocaleString('vi-VN')}đ
                  .partial-refund-row.partial-refund-row--remain
                    span Còn lại (khách thực trả cuối cùng)
                    strong #{(rsRemain.payable || 0).toLocaleString('vi-VN')}đ

      if returnEligible
        - const firstItem = items && items.length ? items[0] : null
        - const returnCsrf = typeof csrfToken !== 'undefined' ? csrfToken : ''
        .modal.fade#returnRequestModal(tabindex='-1' aria-hidden='true')
          .modal-dialog.modal-dialog-scrollable.modal-fullscreen-sm-down
            .modal-content
              form.return-request-form(method='POST' action=`/orders/${order._id}/return-request?_csrf=${encodeURIComponent(returnCsrf || '')}` enctype='multipart/form-data' data-refund-force-bank=(order.phuongthucthanhtoan === 'cod' ? '1' : '0') data-paid-method=(order.phuongthucthanhtoan || 'cod'))
                input(type='hidden' name='_csrf' value=returnCsrf)
                .modal-header
                  h5.modal-title Yêu cầu hoàn hàng
                  button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
                .modal-body
                  .small.mb-3
                    | Bằng việc gửi yêu cầu hoàn hàng, bạn xác nhận đã đọc
                    button.btn.btn-link.btn-sm.p-0.ms-1.align-baseline(type='button' data-bs-toggle='modal' data-bs-target='#refundPolicyModal')
                      | Chính sách hoàn tiền
                  if firstItem
                    .small.text-muted.mb-2 Sản phẩm: #{firstItem.tensanpham || 'Sản phẩm'}
                  .small.text-muted.mb-3 Mã đơn: #{order.madonhang || order._id}

                  .mb-3
                    label.form-label Chọn sản phẩm muốn hoàn
                    .border.rounded.p-2(style='max-height:220px;overflow:auto;')
                      each it, idx in (items || [])
                        .d-flex.justify-content-between.align-items-center.gap-2.py-2.border-bottom
                          .d-flex.align-items-center.gap-2.flex-grow-1
                            img.rounded.border(src=(it.hinhanh || '/images/shopping.png') alt=(it.tensanpham || 'Sản phẩm') width='44' height='44' style='object-fit:cover;')
                            div
                              .fw-semibold #{it.tensanpham || 'Sản phẩm'}
                              .small.text-muted #{[it.mausac, it.kichco].filter(Boolean).join(' - ') || 'Mặc định'} • Đã mua: #{it.soluong || 0}
                          input(type='hidden' name=`returnItems[${idx}][orderItemId]` value=String(it._id || ''))
                          .form-check.mb-0
                            input.form-check-input.js-return-item-check(type='checkbox' id=`return-item-${idx}` data-qty-target=`return-qty-${idx}`)
                          input.form-control.form-control-sm.js-return-item-qty(type='number' id=`return-qty-${idx}` name=`returnItems[${idx}][qty]` value='0' min='0' max=String(it.soluong || 0) step='1' style='width:92px' disabled)

                  .mb-3
                    label.form-label Lý do hoàn hàng
                    .form-check
                      input#reasonSize.form-check-input(type='radio' name='reason' value='sai_size' checked)
                      label.form-check-label(for='reasonSize') Sai size
                    .form-check
                      input#reasonFault.form-check-input(type='radio' name='reason' value='loi_san_pham')
                      label.form-check-label(for='reasonFault') Lỗi sản phẩm
                    .form-check
                      input#reasonDesc.form-check-input(type='radio' name='reason' value='khong_giong_mo_ta')
                      label.form-check-label(for='reasonDesc') Không giống mô tả
                    .form-check
                      input#reasonOther.form-check-input(type='radio' name='reason' value='khac')
                      label.form-check-label(for='reasonOther') Khác

                  .mb-3
                    label.form-label(for='returnDetail') Mô tả chi tiết
                    textarea#returnDetail.form-control(name='detail' rows='3' placeholder='Mô tả thêm về lý do hoàn hàng')

                  .mb-3
                    label.form-label(for='proofMedia') Minh chứng (ảnh hoặc video)
                    input#proofMedia.form-control(type='file' name='proofMedia' accept='image/*,video/*' multiple)
                    .form-text Hỗ trợ ảnh/video, tối đa 5 file, mỗi file tối đa 20MB.
                    #proofMediaPreview.row.g-2.mt-2

                  .mb-2
                    - const _paidMethod = String(order.phuongthucthanhtoan || 'cod').toLowerCase()
                    - const _onlineWalletPaid = ['momo', 'vnpay'].includes(_paidMethod)
                    label.form-label Phương thức hoàn tiền
                    if _onlineWalletPaid
                      .form-check
                        input#refundWallet.form-check-input(type='radio' name='refundMethod' value='wallet' checked)
                        label.form-check-label(for='refundWallet') Hoàn tiền về phương thức thanh toán ban đầu
                      .form-check
                        input#refundBank.form-check-input(type='radio' name='refundMethod' value='bank')
                        label.form-check-label(for='refundBank') Chuyển khoản ngân hàng
                    else
                      input(type='hidden' name='refundMethod' value='bank')
                      .small.text-muted.mb-2 Đơn COD: vui lòng nhập thông tin ngân hàng để hoàn tiền.

                    .mt-2(class=_onlineWalletPaid ? 'd-none' : '' data-refund-bank-fields)
                      .row.g-2
                        .col-12
                          label.form-label.small(for='refundBankName') Tên ngân hàng
                          input#refundBankName.form-control.form-control-sm(type='text' name='bankName' maxlength='120' placeholder='VD: Vietcombank' required)
                        .col-12
                          label.form-label.small(for='refundBankAccountName') Tên người nhận
                          input#refundBankAccountName.form-control.form-control-sm(type='text' name='bankAccountName' maxlength='120' placeholder='Họ tên chủ tài khoản' required)
                        .col-12
                          label.form-label.small(for='refundBankAccountNumber') Số tài khoản
                          input#refundBankAccountNumber.form-control.form-control-sm(type='text' name='bankAccountNumber' maxlength='30' inputmode='numeric' placeholder='Nhập số tài khoản' required)

                .modal-footer
                  button.btn.btn-outline-secondary(type='button' data-bs-dismiss='modal') Đóng
                  button.btn.btn-primary(type='submit') Gửi yêu cầu

      .modal.fade#refundPolicyModal(tabindex='-1' aria-hidden='true')
        .modal-dialog.modal-dialog-scrollable.modal-lg
          .modal-content
            .modal-header
              h5.modal-title CHÍNH SÁCH HOÀN TIỀN
              button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
            .modal-body
              .mb-3
                h6.fw-bold 1. Phạm vi áp dụng
                p.mb-0 Chính sách hoàn tiền này áp dụng cho tất cả các đơn hàng mua tại Fashion Store thông qua website, ứng dụng hoặc các kênh bán hàng chính thức của chúng tôi.
              .mb-3
                h6.fw-bold 2. Điều kiện được hoàn tiền
                ul.mb-0
                  li Sản phẩm bị lỗi do nhà sản xuất
                  li Sản phẩm giao sai mẫu, sai màu, sai size so với đơn đặt hàng
                  li Sản phẩm bị hư hỏng trong quá trình vận chuyển
                  li Sản phẩm nhận được không đúng mô tả trên website
              .mb-3
                h6.fw-bold 3. Điều kiện chấp nhận hoàn trả
                ul.mb-0
                  li Gửi yêu cầu trong vòng 07 ngày kể từ ngày nhận hàng
                  li Sản phẩm còn nguyên tem, nhãn mác, chưa qua sử dụng
                  li Sản phẩm chưa giặt, chưa chỉnh sửa
                  li Có hóa đơn hoặc thông tin xác nhận đơn hàng
                  li Có hình ảnh/video minh chứng nếu sản phẩm bị lỗi hoặc hư hỏng
              .mb-3
                h6.fw-bold 4. Các trường hợp không áp dụng hoàn tiền
                ul.mb-0
                  li Sản phẩm đã qua sử dụng, giặt ủi, bám bẩn hoặc có mùi lạ
                  li Sản phẩm bị hư hại do lỗi từ phía người dùng
