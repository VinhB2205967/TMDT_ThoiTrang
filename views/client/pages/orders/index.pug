extends ../../layouts/default.pug

block main
  .container.py-4
    h1.mb-3 Đơn hàng của tôi

    - const statusLabels = locals.statusLabels || { all: 'Tất cả', choxacnhan: 'Chờ xác nhận', daxacnhan: 'Đã xác nhận', dangchuanbi: 'Đang chuẩn bị', danggiao: 'Đang giao', dagiao: 'Đã giao', requested_return: 'Yêu cầu hoàn hàng', approved_return: 'Đã duyệt hoàn hàng', rejected_return: 'Từ chối hoàn hàng', return_shipping: 'Đang gửi hàng hoàn', returned: 'Đã nhận hàng hoàn', returned_full: 'Đã trả hàng', returned_partial: 'Trả hàng một phần', refunded: 'Đã hoàn tiền', dahuy: 'Đã hủy', hoanhang: 'Hoàn hàng' }
    - const current = currentStatus || 'all'
    - const hiddenFilterStatuses = ['return_shipping', 'returned_full', 'returned_partial']
    - const filterStatuses = (statusOptions || ['all','choxacnhan','daxacnhan','dangchuanbi','danggiao','dagiao','requested_return','approved_return','rejected_return','return_shipping','returned','returned_full','returned_partial','refunded','dahuy','hoanhang']).filter((s) => !hiddenFilterStatuses.includes(String(s)))

    .d-flex.flex-wrap.gap-2.mb-3.order-filters
      each s in filterStatuses
        - const active = String(current) === String(s)
        a.btn.btn-sm(class=active ? 'btn-primary' : 'btn-outline-primary', href=`/orders?status=${s}`) #{statusLabels[s] || s}

    if orders && orders.length
      .list-group.order-list
        each o in orders
          .list-group-item.order-item
            .d-flex.justify-content-between.align-items-center.gap-2
              a.text-decoration-none.flex-grow-1.d-flex.align-items-center.gap-3(href=`/orders/${o._id}`)
                - const preview = o.preview || null
                if preview && preview.image
                  img.order-thumb(src=preview.image alt=(preview.name || 'Sản phẩm'))
                else
                  .order-thumb-fallback
                    i.bi.bi-box-seam

                .flex-grow-1
                  - const paymentMethod = String(o.phuongthucthanhtoan || '').toLowerCase()
                  - const paymentLabel = paymentMethod === 'momo' ? 'MoMo' : (paymentMethod === 'vnpay' ? 'Thanh toán online' : String(o.phuongthucthanhtoan || '').toUpperCase())
                  .fw-semibold.order-title #{(preview && preview.name) ? preview.name : (o.madonhang || 'Đơn hàng')}
                  .small.text-muted.d-block
                    | #{o.madonhang || ''}#{o.ngaytao ? (' • ' + new Date(o.ngaytao).toLocaleString('vi-VN')) : ''}
                  if paymentMethod === 'momo' || paymentMethod === 'vnpay'
                    .small.text-muted.d-block
                      | #{(o.tongtien || o.tamtinh || 0).toLocaleString('vi-VN')}₫ • #{paymentLabel}
                  if preview && preview.count && preview.count > 1
                    .small.text-muted +#{preview.count - 1} sản phẩm khác

              .d-flex.align-items-center.gap-2
                - const isChoThanhToan = o.trangthai === 'choxacnhan' && (o.phuongthucthanhtoan === 'momo' || o.phuongthucthanhtoan === 'vnpay') && !o.dathanhtoan
                - const isDaThanhToanChoXacNhan = o.trangthai === 'choxacnhan' && (o.phuongthucthanhtoan === 'momo' || o.phuongthucthanhtoan === 'vnpay') && o.dathanhtoan
                - const coTheDoiThanhToan = o.trangthai === 'choxacnhan' && !o.dathanhtoan
                - const label = isChoThanhToan ? 'Chờ thanh toán' : (isDaThanhToanChoXacNhan ? 'Đã thanh toán' : (statusLabels[o.trangthai] || o.trangthai))
                span.badge.order-status(data-status=o.trangthai) #{label}
                if isChoThanhToan && o.phuongthucthanhtoan === 'momo'
                  span.text-muted.small(data-payment-pending='1' data-order-id=`${o._id}` data-payment-method='momo')
                    | Đang kiểm tra thanh toán...
                if isChoThanhToan && (o.phuongthucthanhtoan === 'momo' || o.phuongthucthanhtoan === 'vnpay') && o.paymentDeadline
                  span.text-muted.small(data-payment-deadline=o.paymentDeadline data-payment-countdown='1')
                    | Còn: --:--:--
                if coTheDoiThanhToan
                  form.order-payment-form(method='POST', action=`/orders/${o._id}/change-payment` data-auto-submit='payment-method')
                    .order-payment-controls.order-payment-controls--compact
                      select.form-select.form-select-sm.order-payment-select(name='phuongthucthanhtoan')
                        option(value='cod' selected=(o.phuongthucthanhtoan === 'cod')) COD
                        option(value='momo' selected=(o.phuongthucthanhtoan === 'momo')) MoMo
                if isChoThanhToan
                  form(method='POST', action=`/orders/${o._id}/pay`)
                    button.btn.btn-sm.btn-outline-primary(type='submit') Thanh toán

                if o.trangthai === 'choxacnhan'
                  form(method='POST', action=`/orders/${o._id}/cancel`)
                    button.btn.btn-sm.btn-outline-danger(type='submit' onclick="return confirm('Bạn muốn hủy đơn hàng này?')")
                      i.bi.bi-x-circle.me-1
                      | Hủy

                if o.trangthai === 'dahuy'
                  form(method='POST', action=`/orders/${o._id}/reorder`)
                    button.btn.btn-sm.btn-outline-success(type='submit')
                      i.bi.bi-arrow-repeat.me-1
                      | Mua lại
                if o.trangthai === 'dagiao'
                  - let reviewHref = `/orders/${o._id}`
                  - let reviewLabel = 'Đánh giá'
                  - let reviewClass = 'btn-review'
                  if o.preview && o.preview.itemId && o.preview.productId
                    - reviewHref = `/reviews/new?orderId=${o._id}&itemId=${o.preview.itemId}&productId=${o.preview.productId}#review-form`
                    if o.preview.reviewed && o.preview.reviewId
                      - reviewHref = `/reviews/${o.preview.reviewId}/edit#review-form`
                      - reviewLabel = 'Chỉnh sửa đánh giá'
                      - reviewClass = 'btn-outline-success'
                  if o.preview && o.preview.reviewed
                    span.badge.bg-success-subtle.text-success.border.me-1 Đã đánh giá
                  a.btn.btn-sm(class=reviewClass href=reviewHref)
                    i.bi.bi-star-fill.me-1
                    | #{reviewLabel}
      if pagination && pagination.totalPages > 1
        - const statusParam = current && current !== 'all' ? `&status=${current}` : ''
        nav.mt-3
          ul.pagination.justify-content-center
            li.page-item(class=pagination.currentPage === 1 ? 'disabled' : '')
              a.page-link(href=`/orders?page=${pagination.currentPage - 1}${statusParam}` aria-label="Trang trước")
                span(aria-hidden='true') &laquo;
            - const startPage = Math.max(1, pagination.currentPage - 2)
            - const endPage = Math.min(pagination.totalPages, pagination.currentPage + 2)
            if startPage > 1
              li.page-item
                a.page-link(href=`/orders?page=1${statusParam}`) 1
              if startPage > 2
                li.page-item.disabled
                  span.page-link ...
            each i in Array.from({ length: endPage - startPage + 1 }, (_, idx) => startPage + idx)
              li.page-item(class=i === pagination.currentPage ? 'active' : '')
                a.page-link(href=`/orders?page=${i}${statusParam}`) #{i}
            if endPage < pagination.totalPages
              if endPage < pagination.totalPages - 1
                li.page-item.disabled
                  span.page-link ...
              li.page-item
                a.page-link(href=`/orders?page=${pagination.totalPages}${statusParam}`) #{pagination.totalPages}
            li.page-item(class=pagination.currentPage === pagination.totalPages ? 'disabled' : '')
              a.page-link(href=`/orders?page=${pagination.currentPage + 1}${statusParam}` aria-label="Trang sau")
                span(aria-hidden='true') &raquo;
        .text-center.text-muted.small.mt-2 Hiển thị #{orders.length} trên #{pagination.totalProducts} đơn hàng
    else
      .text-center.py-5.text-muted
        i.bi.bi-bag-x.fs-1.d-block.mb-3
        p Bạn chưa có đơn hàng nào.
        a.btn.btn-primary(href='/products') Mua sắm ngay

block scripts
  script(src='/js/orders.js')
