extends ../../layouts/default.pug

block main
  .container.py-4.py-lg-5
    .card.border-0.shadow-sm.overflow-hidden.mb-4
      if lookbook.image
        img.w-100(src=lookbook.image alt=lookbook.title style="max-height:440px;object-fit:cover;")
      .card-body
        h1.h3.mb-2 #{lookbook.title}
        if lookbook.description
          p.text-muted.mb-0 #{lookbook.description}

    .d-flex.justify-content-between.align-items-center.mb-3
      h3.h5.mb-0 Sản phẩm trong lookbook
      if pagination
        span.text-muted.small Tổng #{pagination.totalProducts} sản phẩm

    if products && products.length
      .row.g-3.g-md-4
        each product in products
          .col-6.col-sm-6.col-md-4.col-lg-3.col-xl-2
            +productCard(product)

      if pagination && pagination.totalPages > 1
        nav.mt-4(aria-label="Phân trang lookbook")
          ul.pagination.justify-content-center
            - const prevPage = pagination.currentPage - 1
            li.page-item(class=prevPage < 1 ? 'disabled' : '')
              a.page-link(href=prevPage < 1 ? '#' : `?page=${prevPage}` aria-label="Previous")
                span(aria-hidden="true") &laquo;
            - for (let p = 1; p <= pagination.totalPages; p++)
              li.page-item(class=p === pagination.currentPage ? 'active' : '')
                a.page-link(href=`?page=${p}`) #{p}
            - const nextPage = pagination.currentPage + 1
            li.page-item(class=nextPage > pagination.totalPages ? 'disabled' : '')
              a.page-link(href=nextPage > pagination.totalPages ? '#' : `?page=${nextPage}` aria-label="Next")
                span(aria-hidden="true") &raquo;
    else
      p.text-muted Chưa có sản phẩm nào.

mixin productCard(product)
  .product-card.h-100(data-product-id=product._id)
    a.product-card-link(href=`/products/${product._id}`)
      .product-image
        img(src=product.displayImage || product.hinhanh || '/images/shopping.png' alt=product.tensanpham loading="lazy")
        if product.phantramgiamgia && product.phantramgiamgia > 0
          .discount-badge
            | -#{product.phantramgiamgia}%
      .product-info
        h3.product-name #{product.tensanpham}
        .product-price
          if product.phantramgiamgia && product.phantramgiamgia > 0
            span.original-price #{product.giaText || (product.gia ? product.gia.toLocaleString('vi-VN') + '₫' : '')}
          span.sale-price #{product.giamoiText || product.giaText || (product.gia ? product.gia.toLocaleString('vi-VN') + '₫' : '—')}
        .product-rating
          .stars
            - const avg = product.avgRating || 0
            - for (let i = 1; i <= 5; i++)
              if avg >= i
                i.fas.fa-star
              else if avg >= (i - 0.5)
                i.fas.fa-star-half-alt
              else
                i.far.fa-star
          span.review-count #{avg ? (avg.toFixed(1) + ' • ') : ''}#{product.reviewCount || 0} đánh giá • đã bán #{product.soldCount || 0}
    .product-actions
      a.btn-buy-now(href=`/products/${product._id}`)
        i.bi.bi-lightning-fill.me-1
        | Mua ngay
      button.btn-add-cart(type="button" title="Thêm vào giỏ")
        i.bi.bi-cart-plus
    button.btn-wishlist-float(type='button' title="Yêu thích")
      i.bi.bi-heart
