extends ../../layouts/default.pug

block main
  .container.py-4.py-lg-5
    .d-flex.justify-content-between.align-items-center.mb-4
      h1.h3.mb-0 LOOKBOOK
      a.btn.btn-outline-primary(href="/products") Khám phá sản phẩm

    if lookbooks && lookbooks.length
      .row.g-4
        each book in lookbooks
          .col-12.col-md-6.col-lg-4
            .card.h-100.border-0.shadow-sm.overflow-hidden
              a.text-decoration-none.text-dark(href=`/lookbook/${book.slug || book._id}`)
                if book.image
                  img.card-img-top(src=book.image alt=book.title style="height:260px;object-fit:cover;")
                .card-body.d-flex.flex-column
                  h5.card-title.mb-2 #{book.title}
                  if book.descriptionPreview
                    p.card-text.text-muted.small.mb-3.lookbook-card-desc #{book.descriptionPreview}
                  .d-flex.justify-content-between.align-items-center.mt-auto
                    span.badge.bg-light.text-dark #{(book.products && book.products.length) ? book.products.length : 0} sản phẩm
                    span.btn.btn-sm.btn-primary Xem bộ sưu tập
    else
      p.text-muted Chưa có lookbook nào.
