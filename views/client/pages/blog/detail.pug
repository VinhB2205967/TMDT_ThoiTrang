extends ../../layouts/default.pug

block main
  .container.py-4
    h1.mb-3 #{post.tieude}
    if post.hinhanh
      img.img-fluid.rounded.mb-3(src=post.hinhanh alt=post.tieude)
    if post.tomtat
      p.text-muted #{post.tomtat}
    if post.noidung
      .blog-content(style='white-space: pre-line; line-height: 1.7;') #{post.noidung}
