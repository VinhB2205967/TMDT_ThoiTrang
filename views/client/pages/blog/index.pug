extends ../../layouts/default.pug

block main
  .container.py-4
    h1.mb-4 Blog thoi trang
    if posts && posts.length
      .row.g-3
        each post in posts
          .col-12.col-md-6.col-lg-4
            a.card.h-100.text-decoration-none.text-dark(href=`/blog/${post.slug}`)
              if post.hinhanh
                img.card-img-top(src=post.hinhanh alt=post.tieude)
              .card-body
                h5.card-title #{post.tieude}
                if post.tomtat
                  p.card-text #{post.tomtat}
    else
      p.text-muted Chưa có bài viết nào.
