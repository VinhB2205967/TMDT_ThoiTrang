extends ../../layouts/default.pug

block styles
  link(rel='stylesheet' href='/css/checkout-voucher.css')

block main
  .container.py-4.checkout-page
    h1.mb-3 Thanh toán
    #checkoutInlineAlert.alert.alert-danger.alert-dismissible.fade.d-none(role='alert')
      span#checkoutInlineAlertText
      button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')

    if items && items.length
      form(method='POST' action='/cart/checkout')
        each id in selectedIds
          input(type='hidden' name='itemIds' value=id)
        .row.g-3
          .col-lg-7
            .card
              .card-body
                .fw-semibold.mb-2 Thông tin giao hàng
                if addresses && addresses.length
                  label.form-label Chọn địa chỉ
                  select#checkoutAddressSelect.form-select.mb-3(name='addressId')
                    each a in addresses
                      option(value=a._id data-ten=a.tennguoinhan data-phone=a.sodienthoai data-address=a.diachi) #{a.label}: #{a.diachi}
                    option(value='new' data-ten='' data-phone='' data-address='') Địa chỉ mới...

                .row.g-2
                  .col-md-6
                    input.form-control(name='tennguoinhan' placeholder='Họ tên' value=(userProfile && userProfile.hoten) || '')
                  .col-md-6
                    input.form-control(name='sodienthoai' placeholder='Số điện thoại' value=(userProfile && userProfile.sodienthoai) || '')
                  //- Email không bắt buộc
                  input(type='hidden' name='email' value=(userProfile && userProfile.email) || '')
                  .col-12
                    input.form-control(name='diachigiao' placeholder='Địa chỉ giao hàng' value=(userProfile && userProfile.diachi) || '')
                  #addressLabelWrap.col-12(style='display:none')
                    input.form-control(name='addressLabel' placeholder='Tên gợi nhớ (VD: Nhà, Công ty)')
                  #saveAddressWrap.col-12(style='display:none')
                    .form-check
                      input.form-check-input(type='checkbox' name='saveAddress' value='1' id='saveAddress')
                      label.form-check-label(for='saveAddress') Lưu địa chỉ này cho lần sau
                  .col-12
                    textarea.form-control(name='ghichu' rows='2' placeholder='Ghi chú')

                hr
                .fw-semibold.mb-2 Phương thức thanh toán
                .d-flex.flex-column.gap-2
                  label.form-check
                    input.form-check-input(type='radio' name='phuongthucthanhtoan' value='cod' checked)
                    span.form-check-label
                      i.bi.bi-truck.me-2
                      | Thanh toán khi nhận hàng (COD)
                  label.form-check
                    input.form-check-input(type='radio' name='phuongthucthanhtoan' value='momo')
                    span.form-check-label
                      span.payment-badge.payment-badge--momo.me-2
                        img.payment-logo(src='/images/MOMO.png' alt='MoMo')
                        span MoMo
                      | Ví MoMo thanh toán bằng QR

          .col-lg-5
            .card
              .card-body
                .fw-semibold.mb-2 Đơn hàng
                each item in items
                  .d-flex.justify-content-between.small.py-1
                    span #{item.tensanpham} x#{item.soluong}
                    - const __checkoutLineTotal = (Number.isFinite(Number(item.thanhtien)) ? Number(item.thanhtien) : ((item.giagiam || item.gia || 0) * (item.soluong || 1)))
                    span #{__checkoutLineTotal.toLocaleString('vi-VN')}₫
                hr
                - const shipRegion = (shippingConfig && shippingConfig.defaultRegion) || 'noithanh'
                - const shipFee = (shippingConfig && shippingConfig.regions && shippingConfig.regions[shipRegion]) ? shippingConfig.regions[shipRegion].fee : 0
                .mb-3
                  label.form-label.mb-1 Phí vận chuyển
                  input#checkoutShippingRegion(type='hidden' name='shippingRegion' value=shipRegion)
                  .form-control-plaintext Đồng giá #{shipFee.toLocaleString('vi-VN')}₫
                  if shippingConfig && shippingConfig.freeShipThreshold
                    .form-text Miễn phí vận chuyển cho đơn từ #{shippingConfig.freeShipThreshold.toLocaleString('vi-VN')}₫.

                .mb-3
                  label.form-label.mb-1 Chọn voucher
                  input#voucherCode(type='hidden' name='voucherCode' value='')
                  .voucher-list#voucherList(data-subtotal=(subtotal || 0))
                    .voucher-item
                      input.voucher-radio(type='radio' name='voucherChoice' id='voucher-none' value='' checked)
                      label.voucher-label(for='voucher-none') Không dùng voucher
                  .voucher-actions-inline
                    button#voucherMoreBtn.btn.btn-outline-secondary.btn-sm(type='button' data-bs-toggle='modal' data-bs-target='#voucherModal' style='display:none') Chọn voucher
                  .selected-voucher-card#selectedVoucherCard
                  .selected-voucher-note#selectedVoucherNote
                  .form-text.mt-2
                    | Bạn có thể nhận thêm voucher tại
                    a.ms-1(href='/vouchers') trang Voucher

                .d-flex.justify-content-between
                  span Tạm tính
                  span#checkoutSubtotal #{(subtotal || 0).toLocaleString('vi-VN')}₫
                .d-flex.justify-content-between
                  span Phí vận chuyển
                  span#checkoutShipping #{(shippingFee || 0).toLocaleString('vi-VN')}₫
                .d-flex.justify-content-between
                  span Giảm giá
                  span#checkoutDiscount 0₫
                .d-flex.justify-content-between.fw-semibold.mt-1
                  span Tổng thanh toán
                  span#checkoutTotal #{(finalTotal || 0).toLocaleString('vi-VN')}₫
                button.btn.btn-primary.w-100.mt-3(type='submit') Đặt hàng

      .modal.fade#voucherModal(tabindex='-1' aria-hidden='true')
        .modal-dialog.modal-dialog-centered
          .modal-content
            .modal-header
              h5.modal-title Chọn voucher
              button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
            .modal-body
              .voucher-modal-list#voucherModalList
    else
      .text-center.py-5.text-muted
        i.bi.bi-cart-x.fs-1.d-block.mb-3
        p Không có sản phẩm để thanh toán.
        a.btn.btn-primary(href='/products') Mua sắm ngay

block scripts
  script(src='/js/checkout-voucher.js')
