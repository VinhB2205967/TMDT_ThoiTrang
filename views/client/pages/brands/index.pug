extends ../../layouts/default.pug

block main
  .container.py-4
    .d-flex.justify-content-between.align-items-center.mb-3
      h1.h3.mb-0 Thương hiệu
      a.btn.btn-outline-secondary(href='/products') Xem tất cả sản phẩm

    if brands && brands.length
      .row.g-3
        each brand in brands
          .col-6.col-md-4.col-lg-3
            a.card.h-100.text-decoration-none.text-dark(href=`/brands/${brand.slug || brand._id}`)
              .card-body.text-center
                if brand.logo
                  img.img-fluid.mb-2(style='max-height:80px;object-fit:contain' src=brand.logo alt=brand.ten)
                h2.h6.mb-0= brand.ten
    else
      .alert.alert-light Chưa có thương hiệu đang hiển thị.
