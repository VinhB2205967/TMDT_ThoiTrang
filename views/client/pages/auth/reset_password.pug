extends ../../layouts/default.pug

block main
  .auth-wrap
    .container.py-5
      .row.justify-content-center
        .col-12.col-md-10.col-lg-6
          .card.shadow-sm.border-0
            .card-body.p-4
              h1.h4.fw-bold.mb-3.text-center Đặt lại mật khẩu
              p.text-muted.text-center.mb-4 Nhập mật khẩu mới cho tài khoản của bạn.

              if messages && messages.error
                .alert.alert-danger(role='alert') #{messages.error}
              if messages && messages.success
                .alert.alert-success(role='alert') #{messages.success}

              form(method='POST' action='/reset-password')
                input(type='hidden' name='token' value=token)
                .mb-3
                  label.form-label Mật khẩu mới
                  input.form-control(type='password' name='password' required minlength='6' autocomplete='new-password')
                .mb-3
                  label.form-label Xác nhận mật khẩu mới
                  input.form-control(type='password' name='confirmPassword' required minlength='6' autocomplete='new-password')
                button.btn.btn-success.w-100(type='submit') Cập nhật mật khẩu

              .text-center.mt-3
                a.text-decoration-none(href='/auth?mode=login')
                  i.bi.bi-arrow-left.me-1
                  | Quay lại đăng nhập
