extends ../../layouts/default.pug

block main
  .auth-wrap
    .container.py-5
      .row.justify-content-center
        .col-12.col-md-10.col-lg-6
          .card.shadow-sm.border-0
            .card-body.p-4
              h1.h4.fw-bold.mb-3.text-center Quên mật khẩu
              p.text-muted.text-center.mb-4 Nhập email đã đăng ký để nhận liên kết đặt lại mật khẩu.

              if messages && messages.error
                .alert.alert-danger(role='alert') #{messages.error}
              if messages && messages.success
                .alert.alert-success(role='alert') #{messages.success}

              form(method='POST' action='/forgot-password')
                .mb-3
                  label.form-label Email
                  input.form-control(type='email' name='email' required autocomplete='email' value=((formData && formData.email) || ''))
                button.btn.btn-primary.w-100(type='submit') Gửi liên kết đặt lại mật khẩu

              .text-center.mt-3
                a.text-decoration-none(href='/auth?mode=login')
                  i.bi.bi-arrow-left.me-1
                  | Quay lại đăng nhập
