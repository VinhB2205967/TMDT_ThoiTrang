extends ../../layouts/default.pug

block main
  - const _authError = messages && messages.error ? (Array.isArray(messages.error) ? messages.error[0] : messages.error) : ''
  - const _authSuccess = messages && messages.success ? (Array.isArray(messages.success) ? messages.success[0] : messages.success) : ''
  .auth-wrap.auth-redesign
    .auth-orb.auth-orb-one
    .auth-orb.auth-orb-two
    .container.py-5.auth-page(data-mode=mode)
      .auth-shell
        .auth-showcase
          .auth-brand-chip
            i.bi.bi-stars
            span Fashion Store
          h1
            if mode === 'register'
              | Tạo tài khoản, săn deal thời trang mỗi ngày.
            else
              | Chào mừng trở lại với thế giới thời trang.
          p.auth-lead Đăng nhập để lưu sản phẩm yêu thích, theo dõi đơn hàng, nhận voucher và gợi ý outfit cá nhân hóa.
          .auth-benefits
            .auth-benefit
              i.bi.bi-bag-heart
              span Deal độc quyền
            .auth-benefit
              i.bi.bi-truck
              span Theo dõi đơn nhanh
            .auth-benefit
              i.bi.bi-shield-check
              span Bảo mật tài khoản
          .auth-mini-card
            .auth-mini-avatars
              span(style="--i:0") ✨
              span(style="--i:1") 👗
              span(style="--i:2") 🛍️
            .auth-mini-copy
              strong 30K+ khách hàng
              small đang mua sắm cùng Fashion Store
        .auth-panel
          .card.shadow-sm.border-0.auth-card
            .card-body.p-4.p-lg-5.auth-card-body
              .auth-heading
                span.auth-kicker #{mode === 'register' ? 'Bắt đầu ngay' : 'Đăng nhập'}
                h2 #{mode === 'register' ? 'Tạo tài khoản mới' : 'Đăng nhập tài khoản'}
                p #{mode === 'register' ? 'Điền thông tin bên dưới để tham gia Fashion Store.' : 'Nhập email và mật khẩu để tiếp tục mua sắm.'}
              if _authError || _authSuccess
                noscript
                  if _authError
                    .alert.alert-danger(role="alert") #{_authError}
                  if _authSuccess
                    .alert.alert-success(role="alert") #{_authSuccess}
              ul.nav.nav-pills.justify-content-center.mb-4.auth-tabs
                li.nav-item
                  a.nav-link(class=(mode === 'login' ? 'active' : '') href="/auth?mode=login") Đăng nhập
                li.nav-item
                  a.nav-link(class=(mode === 'register' ? 'active' : '') href="/auth?mode=register") Đăng ký

              if mode === 'login'
                form(method="POST" action="/auth/login")
                  .mb-3
                    label.form-label Email
                    input.form-control(type="email" name="email" required autocomplete="email" value=((formData && formData.email) || rememberedEmail || ''))
                  .mb-3
                    label.form-label Mật khẩu
                    .input-group
                      input#authPasswordLogin.form-control(type="password" name="password" required autocomplete="current-password")
                      button.btn.btn-outline-secondary.auth-password-toggle(type="button" data-toggle-password="#authPasswordLogin" aria-label="Hiện mật khẩu" title="Hiện mật khẩu")
                        i.bi.bi-eye
                  .d-flex.align-items-center.justify-content-between.mb-3
                    .form-check
                      input.form-check-input(type="checkbox" name="remember" id="rememberEmail" checked=Boolean((formData && formData.remember) || rememberedEmail))
                      label.form-check-label(for="rememberEmail") Ghi nhớ email
                    a.small.text-decoration-none(href="/forgot-password") Quên mật khẩu?
                  button.btn.btn-primary.w-100(type="submit") Đăng nhập
              else
                form(method="POST" action="/auth/register")
                  .mb-3
                    label.form-label Họ tên
                    input.form-control(type="text" name="hoten" autocomplete="name" value=((formData && formData.hoten) || ''))
                  .mb-3
                    label.form-label Email
                    input.form-control(type="email" name="email" required autocomplete="email" value=((formData && formData.email) || ''))
                  .mb-3
                    label.form-label Mật khẩu
                    .input-group
                      input#authPasswordRegister.form-control(type="password" name="password" required autocomplete="new-password" minlength="6")
                      button.btn.btn-outline-secondary.auth-password-toggle(type="button" data-toggle-password="#authPasswordRegister" aria-label="Hiện mật khẩu" title="Hiện mật khẩu")
                        i.bi.bi-eye
                  button.btn.btn-success.w-100(type="submit") Tạo tài khoản

              .text-center.my-3.text-muted.auth-separator
                span hoặc tiếp tục với
              if googleEnabled
                a.btn.btn-outline-dark.w-100(href="/auth/google")
                  i.fa-brands.fa-google.me-2
                  if mode === 'register'
                    | Đăng ký với Google
                  else
                    | Đăng nhập với Google
              else
                button.btn.btn-outline-dark.w-100(type="button" disabled)
                  i.fa-brands.fa-google.me-2
                  if mode === 'register'
                    | Đăng ký với Google
                  else
                    | Đăng nhập với Google
                .small.text-muted.mt-2
                

              hr.my-4
              .d-flex.justify-content-between.align-items-center
                a.text-decoration-none(href="/")
                  i.bi.bi-arrow-left.me-1
                  | Về trang chủ
                if isAuthenticated
                  form(method="POST" action="/auth/logout")
                    button.btn.btn-link.text-danger.p-0(type="submit") Đăng xuất

block scripts
  script(src="/js/auth.js")
  if _authError || _authSuccess
    script.
      document.addEventListener('DOMContentLoaded', function () {
        var notify = (window.App && typeof window.App.notify === 'function')
          ? window.App.notify
          : function (message) { window.alert(message); };

        var errorMessage = !{JSON.stringify(_authError || '')};
        var successMessage = !{JSON.stringify(_authSuccess || '')};

        if (errorMessage) {
          notify(errorMessage, {
            type: 'info',
            title: 'Thông báo',
            duration: 5000
          });
        }

        if (successMessage) {
          notify(successMessage, {
            type: 'info',
            title: 'Thông báo',
            duration: 5000
          });
        }
      });
