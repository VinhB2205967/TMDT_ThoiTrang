doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{titlePage}
    link(rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin)
    link(rel="dns-prefetch" href="https://cdn.jsdelivr.net")
    link(rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin)
    link(rel="dns-prefetch" href="https://cdnjs.cloudflare.com")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet")
    link(rel="stylesheet", href="/css/style.css")
    link(rel="stylesheet", href="/css/auth.css")
    link(rel="stylesheet", href="/css/product-card.css")
    link(rel="stylesheet", href="/css/product-detail.css")
    link(rel="stylesheet", href="/css/filter-bar.css")
    link(rel="stylesheet", href="/css/ui-enhancements.css")
    link(rel="stylesheet", href="/css/chat-client.css")
    link(rel="stylesheet", href="/css/chat-ai.css")
    meta(name="csrf-token" content=csrfToken)
    block styles
  body
    include ../partials/header.pug
    include ../../partials/flash.pug
    main.main-content
      block main
    include ../partials/quick_add_modal.pug
    .ai-chatbox
      button#aiChatToggle.ai-chatbox-toggle(type="button" aria-label="Mở trợ lý AI")
        i.bi.bi-stars
        span Trợ lý AI
      .ai-chatbox-panel#aiChatPanel
        .ai-chatbox-header
          .ai-chatbox-title
            strong Trợ lý AI mua sắm
            small Hỏi đáp sản phẩm, khuyến mại, đơn hàng
          .ai-chatbox-actions
            button#aiChatClear.btn.btn-sm.btn-outline-secondary(type="button") Xóa
            button#aiChatExpand.btn.btn-sm.btn-outline-secondary(type="button" title="Phóng to chat" aria-label="Phóng to chat")
              i.bi.bi-arrows-angle-expand
            button#aiChatClose.btn.btn-sm.btn-outline-secondary(type="button" aria-label="Đóng")
              i.bi.bi-x-lg
        #aiChatList.ai-chatbox-list
        form#aiChatForm.ai-chatbox-form
          .ai-chatbox-provider-row
            label.form-label(for="aiChatProvider") AI
            select#aiChatProvider.form-select.form-select-sm
              option(value="ollama") Ollama
              option(value="gemini") Gemini
              option(value="openrouter") OpenRouter (Gemma 3 12B Free)
          .ai-chatbox-provider-row#aiChatModelRow
            label.form-label(for="aiChatModel") Model
            select#aiChatModel.form-select.form-select-sm
              option(value="gemma-3-4b-it") Gemma 3 4B
              option(value="gemma-3-12b-it") Gemma 3 12B
              option(value="gemma-3-27b-it") Gemma 3 27B
              option(value="gemini-2.5-flash") Gemini Flash 2.5
          textarea#aiChatInput.form-control(rows="2" placeholder="Nhập câu hỏi... (Shift+Enter xuống dòng)")
          .ai-chatbox-footer
            span#aiChatStatus.ai-chatbox-status
            button#aiChatSend.btn.btn-primary(type="submit") Gửi
    if isAuthenticated && !isAdmin
      button#chatWidgetToggle.btn.btn-primary.chat-widget-toggle(type="button" aria-label="Mở chat")
        i.bi.bi-chat-dots.fs-4
        span#chatWidgetUnread.badge.text-bg-danger.chat-unread-badge.d-none 0
      .chat-widget-panel#chatWidgetPanel
        .chat-widget-header.d-flex.justify-content-between.align-items-center
          .d-flex.align-items-center.gap-2
            strong Hỗ trợ khách hàng
            span#chatWidgetStatus.badge.text-bg-secondary Offline
          .d-flex.align-items-center.gap-2
            button#chatWidgetExpand.btn.btn-sm.btn-outline-secondary(type="button" title="Phóng to chat")
              i.bi.bi-arrows-angle-expand
            button#chatWidgetClose.btn.btn-sm.btn-outline-secondary(type="button")
              i.bi.bi-x-lg
        #chatWidgetMessages.chat-widget-messages
        .chat-widget-input
          form#chatWidgetForm
            input#chatWidgetFile(type="file" accept="image/*,video/mp4,video/webm,video/ogg,video/quicktime" hidden)
            .small.text-muted.mb-1#chatWidgetFileLabel
            #chatWidgetPreview.chat-widget-preview.d-none
              button#chatWidgetPreviewRemove.chat-preview-remove(type="button" aria-label="Bỏ tệp")
                i.bi.bi-x-lg
              img#chatWidgetPreviewImage.chat-preview-image.d-none(alt="preview")
              video#chatWidgetPreviewVideo.chat-preview-video.d-none(controls preload="metadata")
            .input-group
              button#chatWidgetFileBtn.btn.chat-attach-btn(type="button" title="Gửi ảnh/video")
                i.bi.bi-paperclip
              input#chatWidgetInput.form-control(type="text" placeholder="Nhập tin nhắn...")
              button.btn.btn-primary(type="submit") Gửi
      #chatClientToastWrap.chat-client-toast-wrap
    include ../partials/footer.pug
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
    script(src="/js/shared/csrf.js")
    script(src="/js/shared/utils.js")
    script(src="/js/shared/flash.js")
    script(src="/js/script.js")
    script.
      window.AIChatRuntime = {
        isAuthenticated: !{JSON.stringify(Boolean(isAuthenticated))}
      };
    script(src="/js/chat-ai.js")
    if isAuthenticated && !isAdmin
      script.
        window.ChatRuntime = {
          role: 'client',
          userId: !{JSON.stringify(user && user._id ? String(user._id) : '')},
          defaultTitle: !{JSON.stringify(titlePage || '')}
        };
      script(src="/socket.io/socket.io.js")
      script(src="/js/chat-client.js")
    block scripts