.modal.fade#quickAddModal(tabindex='-1' aria-hidden='true')
  .modal-dialog.modal-dialog-centered
    .modal-content.qam-modal
      .modal-header.qam-modal-header
        h5.modal-title Chọn sản phẩm
        button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
      .modal-body.qam-modal-body
        .d-flex.gap-3.qam-product-summary
          img#qamImage.qam-image(src='/images/shopping.png' alt='product')
          .flex-grow-1.qam-product-meta
            .fw-semibold#qamName —
            .text-muted.small#qamPrice —

        hr
        //- variant
        .mb-3.qam-section
          .fw-semibold.mb-2.qam-section-title Màu sắc
          .d-flex.flex-wrap.gap-2.qam-chip-group#qamVariants
        //- size
        .mb-3.qam-section#qamSizeWrap(style='display:none')
          .fw-semibold.mb-2.qam-section-title Kích cỡ
          .d-flex.flex-wrap.gap-2.qam-chip-group.qam-chip-group--size#qamSizes

        .mb-2.qam-section
          .fw-semibold.mb-2.qam-section-title Số lượng
          .input-group.qam-qty-group
            button.btn.btn-outline-secondary(type='button' id='qamQtyMinus') -
            input.form-control.text-center(type='number' id='qamQty' value='1' min='1')
            button.btn.btn-outline-secondary(type='button' id='qamQtyPlus') +
        .small.text-muted#qamStockNote

      .modal-footer.qam-modal-footer
        button.btn.btn-outline-secondary(type='button' data-bs-dismiss='modal') Hủy
        button.btn.btn-primary(type='button' id='qamSubmit') Xác nhận
