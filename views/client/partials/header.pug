header.header 
    .container-fluid
        .header-wrapper
            
            //- LEFT: Logo
            .header-logo
                a(href="/")
                    i.bi.bi-bag-heart-fill.logo-icon
                    span.logo-text Fashion Store

            //- CENTER: Search bar
            .header-search
                form#headerSearchForm.search-form(method="GET" action="/products" autocomplete="off")
                    .input-group
                        input#headerKeywordInput.form-control(type="text" name="keyword" placeholder="Tìm kiếm sản phẩm..." value=keyword || '' autocomplete="off" spellcheck="false" aria-label="Tìm kiếm sản phẩm" aria-autocomplete="list" aria-expanded="false" aria-controls="headerSuggestDropdown")
                        button.btn-image-search#headerImageSearchBtn(type="button" title="Tìm bằng ảnh" aria-label="Tìm bằng ảnh")
                            i.bi.bi-camera
                        button.btn-search(type="submit")
                            i.bi.bi-search
                #headerSuggestDropdown.header-suggest-dropdown(hidden)
                    ul#headerSuggestList.header-suggest-list(role="listbox" aria-label="Gợi ý sản phẩm")
                form#headerImageSearchForm.search-image-form(method="POST" action=`/products/image-search?_csrf=${encodeURIComponent(csrfToken || '')}` enctype="multipart/form-data")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    input#headerImageSearchInput(type="file" name="image" accept="image/*" hidden)
                #openclipLoadingOverlay.openclip-loading-overlay(hidden)
                    .openclip-loading-overlay__backdrop
                    .openclip-loading-overlay__dialog(role="status" aria-live="polite")
                        button#openclipLoadingClose.openclip-loading-overlay__close(type="button" aria-label="Đóng")
                            i.bi.bi-x-lg
                        .openclip-loading-overlay__spinner
                        strong.openclip-loading-overlay__title Đang phân tích ảnh
                        p.openclip-loading-overlay__text Hệ thống đang so khớp ảnh với sản phẩm phù hợp nhất.
                        .openclip-loading-overlay__preview-wrap
                            img#openclipLoadingPreview.openclip-loading-overlay__preview(src="/images/shopping.png" alt="Ảnh đang tìm kiếm")
                        span.openclip-loading-overlay__hint Vui lòng chờ trong giây lát...

            //- Menu toggle (mobile)
            button.menu-toggle#menuToggle(type="button")
                i.bi.bi-list

            //- RIGHT: Navigation + Avatar
            .header-right
                
                //- Main Navigation Menu
                ul.header-nav#headerNav
                    li: a(href="/") 
                        i.bi.bi-house-door
                        span Trang chủ
                    li: a(href="/products") 
                        i.bi.bi-grid
                        span Sản phẩm
                    //- Dropdown: Khám phá
                    li.dropdown
                        button.nav-btn.dropdown-toggle(type="button" data-bs-toggle="dropdown" aria-expanded="false")
                            i.bi.bi-search
                            span Khám phá
                        ul.dropdown-menu.dropdown-menu-end
                            li
                                a.dropdown-item(href="/lookbook")
                                    i.bi.bi-stars
                                    span Lookbook
                            li
                                a.dropdown-item(href="/blog")
                                    i.bi.bi-journal-text
                                    span Blog
                            li
                                a.dropdown-item(href="/brands")
                                    i.bi.bi-award
                                    span Thương hiệu
                            li
                                a.dropdown-item(href="/favorites")
                                    i.bi.bi-heart
                                    span Yêu Thích
                                    span.badge-counter.badge-favorite #{favoriteCount || 0}
                            li
                                a.dropdown-item(href="/vouchers")
                                    i.bi.bi-ticket-perforated
                                    span Nhận voucher

                    
                        
                    li: a(href="/cart")
                        i.bi.bi-cart3
                        span Giỏ hàng
                        span.badge-counter.badge-cart #{cartCount || 0}

                    if isAuthenticated
                        li: a(href="/orders")
                            i.bi.bi-bag-check
                            span Lịch sử mua

                //- Avatar (logged in)
                if isAuthenticated
                    .dropdown
                        button.avatar-circle(type="button" data-bs-toggle="dropdown" aria-expanded="false" title=user && user.hoten ? user.hoten : 'Tài khoản')
                            img(src=(user && user.avatar ? user.avatar : '/images/avatar/avatar.png') alt="Avatar")
                        ul.dropdown-menu.dropdown-menu-end
                            li
                                a.dropdown-item(href="/account")
                                    i.bi.bi-person-circle
                                    span Thông tin cá nhân
                            li
                                a.dropdown-item(href="/orders")
                                    i.bi.bi-bag-check
                                    span Đơn hàng
                            li: hr.dropdown-divider
                            if user && user.vaitro === 'admin'
                                li
                                    a.dropdown-item(href=`${adminPath}`)
                                        i.bi.bi-shield-lock
                                        span Admin
                                li: hr.dropdown-divider
                            li
                                form(method="POST" action="/auth/logout")
                                    button.dropdown-item(type="submit")
                                        i.bi.bi-box-arrow-right
                                        span Đăng xuất

                //- Auth buttons (not logged in)
                else
                    .auth-buttons
                        a.btn-auth.btn-login(href="/auth?mode=login")
                            i.bi.bi-box-arrow-in-right
                            span Đăng nhập
                        a.btn-auth.btn-register(href="/auth?mode=register")
                            i.bi.bi-person-plus
                            span Đăng ký

//- Offcanvas overlay
#offcanvasOverlay.offcanvas-overlay

//- Mobile menu toggle script
script.
    document.addEventListener('DOMContentLoaded', function() {
        const menuToggle = document.getElementById('menuToggle');
        const headerNav = document.getElementById('headerNav');
        const offcanvasOverlay = document.getElementById('offcanvasOverlay');

        if (menuToggle) {
            menuToggle.addEventListener('click', function() {
                headerNav.classList.toggle('show');
                offcanvasOverlay.classList.toggle('show');
            });
        }

        if (offcanvasOverlay) {
            offcanvasOverlay.addEventListener('click', function() {
                headerNav.classList.remove('show');
                offcanvasOverlay.classList.remove('show');
            });
        }

        document.querySelectorAll('.header-nav a').forEach(link => {
            link.addEventListener('click', function() {
                if (window.innerWidth < 992) {
                    headerNav.classList.remove('show');
                    offcanvasOverlay.classList.remove('show');
                }
            });
        });

        document.querySelectorAll('.header-nav .nav-btn').forEach(btn => {
            btn.addEventListener('click', function(event) {
                if (window.innerWidth < 992) {
                    event.preventDefault();
                    event.stopPropagation();
                    document.querySelectorAll('.header-nav li.dropdown.show').forEach(li => {
                        if (li !== this.parentElement) li.classList.remove('show');
                    });
                    this.parentElement.classList.toggle('show');
                }
            });
        });

        window.addEventListener('resize', function() {
            if (window.innerWidth >= 992) {
                headerNav.classList.remove('show');
                offcanvasOverlay.classList.remove('show');
                document.querySelectorAll('.header-nav li.dropdown.show').forEach(li => li.classList.remove('show'));
            }
        });

        const imageBtn = document.getElementById('headerImageSearchBtn');
        const imageInput = document.getElementById('headerImageSearchInput');
        const imageForm = document.getElementById('headerImageSearchForm');
        const keywordInput = document.getElementById('headerKeywordInput');
        const keywordForm = document.getElementById('headerSearchForm');
        const suggestDropdown = document.getElementById('headerSuggestDropdown');
        const suggestList = document.getElementById('headerSuggestList');
        const loadingOverlay = document.getElementById('openclipLoadingOverlay');
        const loadingPreview = document.getElementById('openclipLoadingPreview');
        const loadingBackdrop = loadingOverlay ? loadingOverlay.querySelector('.openclip-loading-overlay__backdrop') : null;
        const loadingCloseBtn = document.getElementById('openclipLoadingClose');
        let loadingPreviewObjectUrl = null;
        let suggestDebounceTimer = null;
        let suggestAbortController = null;
        let suggestItems = [];
        let suggestActiveIndex = -1;

        const formatVND = function(value) {
            const amount = Number(value || 0);
            if (!Number.isFinite(amount)) return '0₫';
            return amount.toLocaleString('vi-VN') + '₫';
        };

        const escapeHtml = function(text) {
            return String(text || '').replace(/[&<>'"]/g, function(char) {
                switch (char) {
                    case '&': return '&amp;';
                    case '<': return '&lt;';
                    case '>': return '&gt;';
                    case '"': return '&quot;';
                    case "'": return '&#39;';
                    default: return char;
                }
            });
        };

        const closeSuggest = function() {
            if (!suggestDropdown || !keywordInput) return;
            suggestDropdown.hidden = true;
            keywordInput.setAttribute('aria-expanded', 'false');
            suggestActiveIndex = -1;
            if (suggestList) {
                suggestList.querySelectorAll('.header-suggest-link.active').forEach(function(link) {
                    link.classList.remove('active');
                });
            }
        };

        const openSuggest = function() {
            if (!suggestDropdown || !keywordInput) return;
            suggestDropdown.hidden = false;
            keywordInput.setAttribute('aria-expanded', 'true');
        };

        const setSuggestActive = function(index) {
            if (!suggestList) return;
            const links = suggestList.querySelectorAll('.header-suggest-link');
            if (!links.length) {
                suggestActiveIndex = -1;
                return;
            }

            if (index < 0) {
                suggestActiveIndex = -1;
            } else {
                suggestActiveIndex = index % links.length;
                if (suggestActiveIndex < 0) suggestActiveIndex = links.length - 1;
            }

            links.forEach(function(link, idx) {
                const active = idx === suggestActiveIndex;
                link.classList.toggle('active', active);
                link.setAttribute('aria-selected', active ? 'true' : 'false');
                if (active) link.scrollIntoView({ block: 'nearest' });
            });
        };

        const renderSuggestItems = function(items, keywordValue) {
            if (!suggestList) return;
            suggestItems = Array.isArray(items) ? items : [];
            suggestActiveIndex = -1;

            if (!suggestItems.length) {
                suggestList.innerHTML = '<li class="header-suggest-empty">Không tìm thấy sản phẩm phù hợp</li>';
                openSuggest();
                return;
            }

            const html = suggestItems.map(function(item, idx) {
                const ten = escapeHtml(item.ten || 'Sản phẩm');
                const anh = escapeHtml(item.anh || '/images/shopping.png');
                const url = escapeHtml(item.url || '/products');
                const gia = Number(item.gia || 0);
                const giaSauGiam = Number(item.giaSauGiam || gia);
                const hasDiscount = giaSauGiam < gia;

                return '' +
                    '<li role="option">' +
                        '<a class="header-suggest-link" data-index="' + idx + '" href="' + url + '" aria-selected="false">' +
                            '<img class="header-suggest-thumb" src="' + anh + '" alt="' + ten + '" loading="lazy">' +
                            '<span class="header-suggest-meta">' +
                                '<strong class="header-suggest-name">' + ten + '</strong>' +
                                '<span class="header-suggest-price-row">' +
                                    '<span class="header-suggest-price">' + formatVND(giaSauGiam) + '</span>' +
                                    (hasDiscount ? ('<span class="header-suggest-old-price">' + formatVND(gia) + '</span>') : '') +
                                '</span>' +
                            '</span>' +
                        '</a>' +
                    '</li>';
            }).join('') +
            '<li class="header-suggest-footer"><a href="/products?keyword=' + encodeURIComponent(keywordValue) + '">Xem tất cả kết quả</a></li>';

            suggestList.innerHTML = html;
            openSuggest();
        };

        const fetchSuggestItems = function() {
            if (!keywordInput) return;
            const keywordValue = String(keywordInput.value || '').trim();
            if (keywordValue.length < 2) {
                suggestItems = [];
                closeSuggest();
                return;
            }

            if (suggestAbortController) {
                suggestAbortController.abort();
            }
            suggestAbortController = new AbortController();

            fetch('/api/products/suggest?keyword=' + encodeURIComponent(keywordValue) + '&limit=6', {
                method: 'GET',
                credentials: 'same-origin',
                signal: suggestAbortController.signal,
                headers: {
                    Accept: 'application/json'
                }
            }).then(function(res) {
                if (!res.ok) throw new Error('SUGGEST_REQUEST_FAILED');
                return res.json();
            }).then(function(data) {
                if (!data || !data.success) {
                    renderSuggestItems([], keywordValue);
                    return;
                }
                renderSuggestItems(data.items || [], keywordValue);
            }).catch(function(err) {
                if (err && err.name === 'AbortError') return;
                closeSuggest();
            });
        };

        if (keywordInput && keywordForm && suggestDropdown && suggestList) {
            keywordInput.setAttribute('autocomplete', 'off');
            keywordInput.addEventListener('input', function() {
                clearTimeout(suggestDebounceTimer);
                suggestDebounceTimer = setTimeout(fetchSuggestItems, 220);
            });

            keywordInput.addEventListener('focus', function() {
                if (suggestItems.length) openSuggest();
            });

            keywordInput.addEventListener('keydown', function(event) {
                if (suggestDropdown.hidden) return;

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    setSuggestActive(suggestActiveIndex + 1);
                    return;
                }

                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    setSuggestActive(suggestActiveIndex - 1);
                    return;
                }

                if (event.key === 'Escape') {
                    closeSuggest();
                    return;
                }

                if (event.key === 'Enter' && suggestActiveIndex >= 0) {
                    const target = suggestList.querySelector('.header-suggest-link[data-index="' + suggestActiveIndex + '"]');
                    if (target) {
                        event.preventDefault();
                        window.location.href = target.getAttribute('href');
                    }
                }
            });

            keywordForm.addEventListener('submit', function() {
                closeSuggest();
            });

            document.addEventListener('click', function(event) {
                if (!suggestDropdown.contains(event.target) && !keywordForm.contains(event.target)) {
                    closeSuggest();
                }
            });
        }

        const hideLoadingOverlay = function() {
            if (!loadingOverlay) return;
            loadingOverlay.hidden = true;
            document.body.classList.remove('openclip-loading');
            if (loadingPreviewObjectUrl) {
                URL.revokeObjectURL(loadingPreviewObjectUrl);
                loadingPreviewObjectUrl = null;
            }
        };

        const showLoadingOverlay = function(file) {
            if (!loadingOverlay) return;
            loadingOverlay.hidden = false;
            document.body.classList.add('openclip-loading');
            if (loadingPreviewObjectUrl) {
                URL.revokeObjectURL(loadingPreviewObjectUrl);
                loadingPreviewObjectUrl = null;
            }
            if (loadingPreview && file) {
                loadingPreviewObjectUrl = URL.createObjectURL(file);
                loadingPreview.src = loadingPreviewObjectUrl;
                loadingPreview.onload = function() {
                    if (loadingPreviewObjectUrl) {
                        URL.revokeObjectURL(loadingPreviewObjectUrl);
                        loadingPreviewObjectUrl = null;
                    }
                };
            }
        };

        if (loadingCloseBtn) {
            loadingCloseBtn.addEventListener('click', hideLoadingOverlay);
        }

        if (loadingBackdrop) {
            loadingBackdrop.addEventListener('click', hideLoadingOverlay);
        }

        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape' && loadingOverlay && !loadingOverlay.hidden) {
                hideLoadingOverlay();
            }
        });

        if (imageBtn && imageInput && imageForm) {
            imageBtn.addEventListener('click', function() {
                imageInput.click();
            });

            imageInput.addEventListener('change', function() {
                if (imageInput.files && imageInput.files[0]) {
                    showLoadingOverlay(imageInput.files[0]);
                    imageForm.submit();
                }
            });
        }
    });