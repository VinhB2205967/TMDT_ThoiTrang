header.header 
    .container-fluid
        .header-wrapper
            
            //- LEFT: Logo
            .header-logo
                a(href="/")
                    i.bi.bi-bag-heart-fill.logo-icon
                    span.logo-text Fashion Store

            //- CENTER: Search bar
            .header-search
                form.search-form(method="GET" action="/products")
                    .input-group
                        input.form-control(type="text" name="keyword" placeholder="Tìm kiếm sản phẩm..." value=keyword || '')
                        button.btn-search(type="submit")
                            i.bi.bi-search

            //- Menu toggle (mobile)
            button.menu-toggle#menuToggle(type="button")
                i.bi.bi-list

            //- RIGHT: Navigation + Avatar
            .header-right
                
                //- Main Navigation Menu
                ul.header-nav#headerNav
                    li: a(href="/") 
                        i.bi.bi-house-door
                        span Trang chủ
                    li: a(href="/products") 
                        i.bi.bi-grid
                        span Sản phẩm
                        .dropdown-menu.p-3(style="min-width: 680px;")
                            if categoryMenu && categoryMenu.byKey
                                .row.g-3
                                    each key in ['nam', 'nu', 'tre-em', 'giay-dep', 'phu-kien']
                                        - const root = categoryMenu.byKey[key]
                                        if root
                                            .col-12.col-md-6.col-lg-4
                                                h6.fw-bold.mb-2
                                                    a.text-decoration-none(href=`/products?category=${root._id}`)= root.name
                                                if root.children && root.children.length
                                                    ul.list-unstyled.mb-0
                                                        each child in root.children
                                                            li.mb-1
                                                                a.text-decoration-none.small(href=`/products?category=${child._id}`)= child.name
                                                                if child.children && child.children.length
                                                                    ul.list-unstyled.ps-3.mt-1
                                                                        each sub in child.children
                                                                            li
                                                                                a.text-decoration-none.small.text-muted(href=`/products?category=${sub._id}`)= sub.name
                            else
                                a.dropdown-item(href='/products') Xem toàn bộ sản phẩm
                    //- Dropdown: Khám phá
                    li.dropdown
                        button.nav-btn.dropdown-toggle(type="button" data-bs-toggle="dropdown" aria-expanded="false")
                            i.bi.bi-search
                            span Khám phá
                        ul.dropdown-menu.dropdown-menu-end
                            li
                                a.dropdown-item(href="/favorites")
                                    i.bi.bi-heart
                                    span Yêu Thích
                                    span.badge-counter #{favoriteCount || 0}
                            li
                                a.dropdown-item(href="/vouchers")
                                    i.bi.bi-ticket-perforated
                                    span Nhận voucher

                    
                        
                    li: a(href="/cart")
                        i.bi.bi-cart3
                        span Giỏ hàng
                        span.badge-counter #{cartCount || 0}

                    if isAuthenticated
                        li: a(href="/orders")
                            i.bi.bi-bag-check
                            span Lịch sử mua

                //- Avatar (logged in)
                if isAuthenticated
                    .dropdown
                        button.avatar-circle(type="button" data-bs-toggle="dropdown" aria-expanded="false" title=user && user.hoten ? user.hoten : 'Tài khoản')
                            img(src=(user && user.avatar ? user.avatar : '/images/avatar/avatar.png') alt="Avatar")
                        ul.dropdown-menu.dropdown-menu-end
                            li
                                a.dropdown-item(href="/account")
                                    i.bi.bi-person-circle
                                    span Thông tin cá nhân
                            li
                                a.dropdown-item(href="/orders")
                                    i.bi.bi-bag-check
                                    span Đơn hàng
                            li: hr.dropdown-divider
                            if user && user.vaitro === 'admin'
                                li
                                    a.dropdown-item(href=`${adminPath}`)
                                        i.bi.bi-shield-lock
                                        span Admin
                                li: hr.dropdown-divider
                            li
                                form(method="POST" action="/auth/logout")
                                    button.dropdown-item(type="submit")
                                        i.bi.bi-box-arrow-right
                                        span Đăng xuất

                //- Auth buttons (not logged in)
                else
                    .auth-buttons
                        a.btn-auth.btn-login(href="/auth?mode=login")
                            i.bi.bi-box-arrow-in-right
                            span Đăng nhập
                        a.btn-auth.btn-register(href="/auth?mode=register")
                            i.bi.bi-person-plus
                            span Đăng ký

//- Offcanvas overlay
#offcanvasOverlay.offcanvas-overlay

//- Mobile menu toggle script
script.
    document.addEventListener('DOMContentLoaded', function() {
        const menuToggle = document.getElementById('menuToggle');
        const headerNav = document.getElementById('headerNav');
        const offcanvasOverlay = document.getElementById('offcanvasOverlay');

        if (menuToggle) {
            menuToggle.addEventListener('click', function() {
                headerNav.classList.toggle('show');
                offcanvasOverlay.classList.toggle('show');
            });
        }

        if (offcanvasOverlay) {
            offcanvasOverlay.addEventListener('click', function() {
                headerNav.classList.remove('show');
                offcanvasOverlay.classList.remove('show');
            });
        }

        document.querySelectorAll('.header-nav a').forEach(link => {
            link.addEventListener('click', function() {
                if (window.innerWidth < 992) {
                    headerNav.classList.remove('show');
                    offcanvasOverlay.classList.remove('show');
                }
            });
        });
    });